Private Sub Command7_Click()
frmKatalog.Show vbModal
If frmKatalog.Tag = "OK" Then
Dim oldText As String
oldText = Combo1.Text
Combo1.Clear
AddToCombo Combo1
Combo1.Text = oldText
End If
End Sub

