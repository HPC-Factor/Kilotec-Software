End Sub

Private Sub Form_Activate()
Combo1.Clear

AddToCombo Combo1
'Combo1.Text = Combo1.List(0)

KategorieIndex = Mid(Combo1.List(Combo1.ListIndex), 1, 2)
EinlesenStatistik

End Sub

Private Sub Form_Load()
