Attribute VB_Name = "frmAdd"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Combo1_Change()

End Sub

Private Sub Command1_Click()
If Datum.Text = "" Or Price.Text = "" Or Shares.Text = "" Then
    MsgBox ("Please fill in the textboxes!"), vbOKOnly, "Info"
    Exit Sub
End If



AbInDieDatenbank

'If Zaehler > 9 Then
'MsgBox "Only 10 entries possible in this version!" & vbCrLf & vbCrLf & _
'"Please contact us: info@kilotec.de!", vbOKOnly, ""
'Exit Sub
'End If

EinlesenEintraege

frmMain.Command9.Enabled = True

On Error Resume Next

If Option1.Value = True Then
MsgBox ("== Transaction completed ==" & _
        vbCrLf & vbCrLf & _
        "You bought " & Shares.Text & " shares of " & Mid(Combo1.Text, 4) & " for " & Price.Text & _
        vbCrLf & _
        "Total costs: " & Price.Text * Shares.Text), vbOKOnly, "Info"
End If

If Option2.Value = True Then
MsgBox ("== Transaction completed ==" & _
        vbCrLf & vbCrLf & _
        "You sold " & Shares.Text & " shares of " & Mid(Combo1.Text, 4) & " for " & Price.Text & _
        vbCrLf & _
        "Total selling price: " & Price.Text * Shares.Text), vbOKOnly, "Info"
End If
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Combo1.Text = frmMain.Combo1.Text
Datum.Text = ""
Price.Text = ""
Shares.Text = ""

End Sub

Private Sub Form_Load()
AddToCombo Combo1
Combo1.Text = frmMain.Combo1.Text

End Sub
