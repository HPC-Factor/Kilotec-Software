Attribute VB_Exposed = False
Option Explicit

Private Sub cmdBar_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)
InvokeAction CInt(Button.Tag), True
End Sub

Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
InvokeAction (Item.Index + (100 * Item.Parent.Index)), False
End Sub
Private Sub InvokeAction(ID As Integer, FromButton As Boolean)
   Select Case (ID)
            
    
    Case ID_ABOUT       ' thick brush mode
        frmAbout.Show
        
    Case ID_EXIT        ' terminate the app
        App.End
 '***************************************
    
    Case ID_ADD
        frmAdd.Show
    
    Case ID_EDIT
        If ListView1.ListItems.Count > 0 Then
        IndexX = ListView1.SelectedItem.SubItems(3)
        frmEdit.Show
        End If
    
    Case ID_SEARCH
        frmFind.Show
    
    Case ID_DELETE
        Dim a As Integer
            If SPRACHE = 1 Then a = MsgBox("Möchten Sie die Betankung löschen?", vbYesNo, "Achtung")
            If SPRACHE = 0 Then a = MsgBox("Do you want to delete the current fuel data?", vbYesNo, "Info")
            If a = vbYes Then
            On Error Resume Next
                LoescheEintrag
                ReplaceIndex = IndexX
                Exit Sub
            End If
    
    Case ID_SAVE
        DBspeichern
    
    Case ID_OVERVIEW
        frmOverview.Show
        
    '************************************************
    Case ID_STATISTIK
        On Error Resume Next
         frmStatistik.Show
        
    

    '************************************************
    Case ID_KATEGORIE
        frmKatalog.Show vbModal
        If frmKatalog.Tag = "OK" Then
        Dim oldText As String
        oldText = Combo1.Text
        Combo1.Clear
        AddToCombo Combo1
        Combo1.Text = oldText
        End If
        
    Case ID_OPTIONEN
        frmOptionen.Show
        
    Case ID_EXPORT
        On Error Resume Next
            CommonDialog1.ShowSave
            If Err.Number = 0 Then
                ExportFile CommonDialog1.FileName
            End If
            On Error GoTo 0
    
      Case ID_IMPORT
        On Error Resume Next
            CommonDialog1.ShowOpen
            If Err.Number = 0 Then
                ImportFile CommonDialog1.FileName
            End If
            On Error GoTo 0
   
    
    
            
  
        
           
    
        
    Case ID_ABOUT
        frmAbout.Show
        
      
    Case Else
        ' programming error -- undefined tool
        MsgBox "Undefined Commandbar Command!"
    End Select
End Sub

Private Sub Combo1_Change()

End Sub

Private Sub Combo1_Click()
KategorieIndex = Mid(Combo1.List(Combo1.ListIndex), 1, 2)
EinlesenEintraege
End Sub




Private Sub Form_Load()
'Center Me


SPRACHE = GetSetting(App.Title, "Settings", "Sprache", "0")
WSYMBOL = GetSetting(App.Title, "Settings", "Currency", "$")
MAXIM = GetSetting(App.Title, "Settings", "Max", "0")
LITER = GetSetting(App.Title, "Settings", "Lit", "l")
KM = GetSetting(App.Title, "Settings", "KM", "km")

If SPRACHE = 0 Then
    Label3.Caption = "Vehicle:"
End If
If SPRACHE = 1 Then
    Label3.Caption = "Fahrzeug:"
End If

InitializeSaveAsDialog

If MAXIM = 1 Then
    Me.Left = 0
    Me.Width = Screen.Width
    Me.Height = Screen.Height
    
    ListView1.Height = Me.Height - ListView1.Top - 800
    ListView1.Width = Me.Width - 100
End If

If MAXIM = 0 Then
Center Me
End If


cmdBar.Left = 0
cmdBar.Top = 0
cmdBar.Width = Me.Width

ImageList1.Add App.Path & "\Bar.bmp"
cmdBar.ImageList = ImageList1.hImageList

