Attribute VB_Name = "frmEdit"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit



Private Sub Command1_Click()
DBbearbeiten
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Center Me
Combo1.Clear

AddToCombo Combo1

Combo1.Text = DBdaten(0, IndexX) & " " & DBdaten(1, IndexX)
Kilometerstand.Text = DBdaten(2, IndexX)
Datum.Text = DBdaten(3, IndexX)
Getankt.Text = DBdaten(4, IndexX)
Preis.Text = DBdaten(5, IndexX)



ReplaceIndex = IndexX

If SPRACHE = 0 Then
    Label3.Caption = "Vehicle:"
    Label2.Caption = "Date:"
    Label1.Caption = "Mileage:"
    Label4.Caption = "Refuel:"
    Label5.Caption = "Costs:"
    Command2.Caption = "&Close"
    Me.Caption = "Add travel"
End If

If SPRACHE = 1 Then
    Label3.Caption = "Fahrzeug:"
    Label2.Caption = "Datum:"
    Label1.Caption = "Kilometerstand:"
    Label4.Caption = "Getankt:"
    Label5.Caption = "Preis:"
    Command2.Caption = "&Schließen"
    Me.Caption = "Betankung hinzufügen"
End If
End Sub

Private Sub Form_Load()

End Sub
