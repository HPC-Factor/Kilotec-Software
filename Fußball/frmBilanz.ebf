Option Explicit

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Center Me
'Ausgaben = 0 'Form(TeamIndex) + Spiel(TeamIndex) * 80000
List1.Clear

List1.AddItem "Verein: " & Space(25 - Len("Verein: ")) & Mannschaft(TeamIndex)
List1.AddItem "Formstärke: " & Space(25 - Len("Formstärke: ")) & Form(TeamIndex)
List1.AddItem "Spielstärke: " & Space(25 - Len("Spielstärke: ")) & Angriff(TeamIndex) & "-" & Mittelfeld(TeamIndex) & "-" & Abwehr(TeamIndex)
List1.AddItem "-------------------------------------------"
List1.AddItem "Torverhältnis: " & Space(25 - Len("Torverhältnis: ")) & Tore(TeamIndex) & ":" & Gegentore(TeamIndex) & Space(10 - Len(Tore(TeamIndex) & ":" & Gegentore(TeamIndex)))
List1.AddItem "Punkte: " & Space(25 - Len("Punkte: ")) & Punkte(TeamIndex)
List1.AddItem "-------------------------------------------"
List1.AddItem "Geld: " & Space(25 - Len("Geld: ")) & Int(Geld) & " €"
List1.AddItem "Ausgaben/Spiel: " & Space(25 - Len("Ausgaben/Spiel: ")) & Int(Kosten)
List1.AddItem "Eintrittspreis: " & Space(25 - Len("Eintrittspreis: ")) & Int(Eintritt)
List1.AddItem "Zuschauerschnitt: " & Space(25 - Len("Zuschauerschnitt: ")) & Int(Zuschauerschnitt / Spieltag)
List1.AddItem "Stadionplätze: " & Space(25 - Len("Stadionplätze: ")) & Int(Stadion(TeamIndex))
List1.AddItem "Auslastung in %: " & Space(25 - Len("Auslastung in %: ")) & Int(((Zuschauerschnitt / Spieltag) * 100 / Stadion(TeamIndex)))
End Sub

Private Sub Form_Load()

End Sub
