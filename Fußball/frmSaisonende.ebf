Private Sub Command1_Click()
x = 1
Geld = 0
Spieltag = 1
Aktualisieren
frmHaupt.Command1.Caption = "Nächster Spieltag"
frmHaupt.lblSpieltag.Caption = "SAISONENDE"
frmNewGame.Show



Me.Hide
frmHaupt.Hide

End Sub

Private Sub Form_Load()
Label1.Caption = "Die Mannschaft " & TEAM & " ist " & Platz & ". in der " & Liga & ". Bundesliga geworden!"

If Liga = 1 And Platz = 1 Then Label2.Caption = "Du bist DEUTSCHER FUßBALLMEISTER!!!!"
If Liga = 1 And Platz > 16 Then Label2.Caption = "Du bist leider abgestiegen in die 2. Bundesliga!"


If Liga = 2 And Platz > 16 Then Label2.Caption = "Du bist leider abgestiegen in die 3. Bundesliga!"
If Liga = 2 And Platz < 3 Then Label2.Caption = "Du bist aufgestiegen in die 1. Bundesliga"
If Liga = 2 And Platz = 1 Then Label2.Caption = "Du bist Meister der 2. Bundesliga geworden und steigst auf in die 1. Bundesliga!"

If Liga = 3 And Platz > 14 Then Label2.Caption = "Du bist leider abgestiegen in die Regionalliga!"
If Liga = 3 And Platz < 3 Then Label2.Caption = "Du bist aufgestiegen in die 2. Bundesliga"
If Liga = 3 And Platz = 1 Then Label2.Caption = "Du bist Meister der 3. Bundesliga geworden und steigst auf in die 2. Bundesliga!"

Label3.Caption = "Insgesamt hast du " & Punkte(TeamIndex) & " Punkte geholt und " & Tore(TeamIndex) & " Tore geschossen."
End Sub
