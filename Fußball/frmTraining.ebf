Option Explicit

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Command2_Click()
Dim altS As Integer
Dim altM As Integer
Dim altA As Integer

altS = Angriff(TeamIndex)
altM = Mittelfeld(TeamIndex)
altA = Abwehr(TeamIndex)

Geld = Geld - 50000
Angriff(TeamIndex) = Angriff(TeamIndex) + GetRandomNumber(0, 2)
Mittelfeld(TeamIndex) = Mittelfeld(TeamIndex) + GetRandomNumber(0, 1)
Abwehr(TeamIndex) = Abwehr(TeamIndex) + GetRandomNumber(0, 2)

MsgBox "Der Ausflug in das Trainingslager brachte folgende Ergebnisse:" & _
    vbCrLf & vbCrLf & "ALTE WERTE" & _
