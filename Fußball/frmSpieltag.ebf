Private Sub Command1_Click()

Me.Hide

End Sub



Private Sub Command2_Click()



If Spieltag2 < 33 Then
    Spieltag2 = Spieltag2 + 1
    frmSpieltag.Caption = Spieltag2 & ". Spieltag"
    List1.Clear
    
    yy = xx + 1
    If yy > (18 - 1) Then yy = 1
    For spiele = 1 To 18 / 2 - 1
        frmSpieltag.List1.AddItem Mannschaft(xx) & Space(20 - Len(Mannschaft(xx))) & " - " & Space(4 - Len(" - ")) & Mannschaft(yy)
 
        xx = xx - 1
        yy = yy + 1
        If xx < 1 Then xx = 18 - 1
        If yy > (18 - 1) Then yy = 1
    Next spiele
     
        frmSpieltag.List1.AddItem Mannschaft(18) & Space(20 - Len(Mannschaft(18))) & " - " & Space(4 - Len(" - ")) & Mannschaft(xx)
End If
End Sub

Private Sub Command3_Click()

If Spieltag2 > 1 Then
    Spieltag2 = Spieltag2 - 1
    frmSpieltag.Caption = Spieltag2 & ". Spieltag"
    List1.Clear
    
    yy = xx - 1
    If yy > (18 - 1) Then yy = 1
    For spiele = 1 To 18 / 2 - 1
        frmSpieltag.List1.AddItem Mannschaft(xx) & Space(20 - Len(Mannschaft(xx))) & " - " & Space(4 - Len(" - ")) & Mannschaft(yy)
 
        xx = xx + 1
        yy = yy - 1
        If xx > 17 Then xx = 1
        If yy < 1 Then yy = 17
    Next spiele
     
        frmSpieltag.List1.AddItem Mannschaft(18) & Space(20 - Len(Mannschaft(18))) & " - " & Space(4 - Len(" - ")) & Mannschaft(xx)
End If

If Spieltag2 = 1 Then
    List1.Clear
    Berechnen
End If
End Sub

Private Sub Form_Activate()
Center Me
Spieltag2 = Spieltag
xx = x + 1
'yy = y
frmSpieltag.Caption = Spieltag & ". Spieltag"
Berechnen


End Sub

Private Sub Form_Load()
Center Me


    
End Sub



