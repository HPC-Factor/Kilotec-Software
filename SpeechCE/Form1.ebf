Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit


Private Sub Check1_Click()
'If Check1.Value = 0 Then
'Timer1.Interval = 1000
'Else
'Timer1.Interval = 1
'End If

If Check1.Value = 1 Then
    Me.Top = 0
    Me.Left = 0
    Me.Height = Screen.Height
    Me.Width = Screen.Width
Else
    Me.Height = 3015
    Me.Width = 8190
    Center Me
End If

End Sub

Private Sub Command1_Click()
frmMain.File.Open App.Path & "\Notes.dat", fsModeOutput, fsAccessWrite, fsLockReadWrite

    
    frmMain.File.LinePrint Trim(Text1.Text)
    frmMain.File.LinePrint "////////"
  frmMain.File.Close
End Sub

Private Sub Command2_Click()
Text1.Text = ""
Command2.Enabled = False


End Sub

Private Sub Command3_Click()
If Text2.Text <> Empty Then Limit1 = CDbl(Text2.Text)
If Text3.Text <> Empty Then Limit2 = CDbl(Text3.Text)
If Text4.Text <> Empty Then Limit3 = CDbl(Text4.Text)


Command3.Enabled = False
Command4.Enabled = True
Timer1.Enabled = True
End Sub

Private Sub Command4_Click()
Command3.Enabled = True
Command4.Enabled = False
Timer1.Enabled = False
End Sub

Private Sub Command5_Click()
Text1.Font.Size = 10
Label1.Caption = "00:00"
Seconds = 0
Minutes = 0
frmMain.BackColor = &H8000000F
Option1.BackColor = &H8000000F
Option2.BackColor = &H8000000F
Check1.BackColor = &H8000000F
Check2.BackColor = &H8000000F
Label1.BackColor = &H8000000F
Label2.BackColor = &H8000000F
Label3.BackColor = &H8000000F
Label4.BackColor = &H8000000F
Label5.BackColor = &H8000000F

Text2.Text = ""
Text3.Text = ""
Text4.Text = ""
End Sub

Private Sub Command6_Click()
App.End

End Sub

Private Sub Command7_Click()
frmMain.File.Open App.Path & "\Notes.dat", fsModeAppend
frmMain.File.Close
frmMain.File.Open App.Path & "\Notes.dat", fsModeInput, fsAccessRead, fsLockRead

'On Error Resume Next
Do While Not frmMain.File.EOF
  Text1.Text = ""
    Do
    Temp = frmMain.File.LineInputString
    If Temp = "////////" Then
        'If Text1.Text <> "" Then
        '    Text1.Text = Left(Text1.Text, Len(Text1.Text) - 2)
        frmMain.File.Close
        Exit Sub
        'End If
        
    End If
    Text1.Text = Text1.Text & Temp & vbCrLf
    Loop


Loop
'Do While Not frmMain.File.EOF
'    Text1.Text = frmMain.File.LineInputString
'  Loop
frmMain.File.Close
End Sub

Private Sub Command8_Click()
If Text1.Font.Size < 20 Then
    Text1.Font.Size = Text1.Font.Size + 1
End If
End Sub

Private Sub Command9_Click()
If Text1.Font.Size > 8 Then
    Text1.Font.Size = Text1.Font.Size - 1
End If
End Sub

Private Sub Form_Load()
Center Me

Seconds = 0
Minutes = 0
Label1.Caption = "00:00"


End Sub

Private Sub Label1_Click()

End Sub

Private Sub Option1_Click()

End Sub

Private Sub Text1_Change()
Command2.Enabled = True
End Sub

Private Sub Timer1_Timer()
Seconds = Seconds + 1

If Seconds = 60 Then
    Minutes = Minutes + 1
    Seconds = 0
End If
'Label1.Caption = Minutes & ":" & Seconds

If Seconds < 10 And Minutes < 10 Then
    Label1.Caption = "0" & Minutes & ":" & "0" & Seconds
End If
If Seconds < 10 And Minutes > 9 Then
    Label1.Caption = Minutes & ":" & "0" & Seconds
End If
If Seconds > 9 And Minutes < 10 Then
    Label1.Caption = "0" & Minutes & ":" & Seconds
End If
If Seconds > 9 And Minutes > 9 Then
    Label1.Caption = Minutes & ":" & Seconds
End If


On Error Resume Next
If Option1.Value = True Then
   If Seconds = Limit1 Then
        frmMain.BackColor = &H80FF80
        Option1.BackColor = &H80FF80
        Option2.BackColor = &H80FF80
        Check1.BackColor = &H80FF80
        Check2.BackColor = &H80FF80
        Label1.BackColor = &H80FF80
        Label2.BackColor = &H80FF80
        Label3.BackColor = &H80FF80
        Label4.BackColor = &H80FF80
        Label5.BackColor = &H80FF80
    If Check2.Value = 1 Then PlayWaveFile (App.Path & "\Alarm.wav")
    End If

   If Seconds = Limit2 Then
        frmMain.BackColor = &H80FFFF
        Option1.BackColor = &H80FFFF
        Option2.BackColor = &H80FFFF
        Check1.BackColor = &H80FFFF
        Check2.BackColor = &H80FFFF
        Label1.BackColor = &H80FFFF
        Label2.BackColor = &H80FFFF
        Label3.BackColor = &H80FFFF
        Label4.BackColor = &H80FFFF
        Label5.BackColor = &H80FFFF
        If Check2.Value = 1 Then PlayWaveFile (App.Path & "\Alarm.wav")
    End If
   If Seconds = Limit3 Then
        frmMain.BackColor = &HFF&
        Option1.BackColor = &HFF&
        Option2.BackColor = &HFF&
        Check1.BackColor = &HFF&
        Check2.BackColor = &HFF&
        Label1.BackColor = &HFF&
        Label2.BackColor = &HFF&
        Label3.BackColor = &HFF&
        Label4.BackColor = &HFF&
        Label5.BackColor = &HFF&
        If Check2.Value = 1 Then PlayWaveFile (App.Path & "\Alarm.wav")
   End If
   
End If
If Option2.Value = True Then
   If Minutes = Limit1 Then
        frmMain.BackColor = &H80FF80
        Option1.BackColor = &H80FF80
        Option2.BackColor = &H80FF80
        Check1.BackColor = &H80FF80
        Check2.BackColor = &H80FF80
        Label1.BackColor = &H80FF80
        Label2.BackColor = &H80FF80
        Label3.BackColor = &H80FF80
        Label4.BackColor = &H80FF80
        Label5.BackColor = &H80FF80
        If Check2.Value = 1 Then PlayWaveFile (App.Path & "\Alarm.wav")
    End If

   If Minutes = Limit2 Then
        frmMain.BackColor = &H80FFFF
        Option1.BackColor = &H80FFFF
        Option2.BackColor = &H80FFFF
        Check1.BackColor = &H80FFFF
        Check2.BackColor = &H80FFFF
        Label1.BackColor = &H80FFFF
        Label2.BackColor = &H80FFFF
        Label3.BackColor = &H80FFFF
        Label4.BackColor = &H80FFFF
        Label5.BackColor = &H80FFFF
        If Check2.Value = 1 Then PlayWaveFile (App.Path & "\Alarm.wav")
    End If
   If Minutes = Limit3 Then
        frmMain.BackColor = &HFF&
        Option1.BackColor = &HFF&
        Option2.BackColor = &HFF&
        Check1.BackColor = &HFF&
        Check2.BackColor = &HFF&
        Label1.BackColor = &HFF&
        Label2.BackColor = &HFF&
        Label3.BackColor = &HFF&
        Label4.BackColor = &HFF&
        Label5.BackColor = &HFF&
        If Check2.Value = 1 Then PlayWaveFile (App.Path & "\Alarm.wav")
   End If
   
End If



End Sub

