Attribute VB_Name = "frmHelp"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Form_Load()
Center Me
Dim i As Integer

Grid1.Clear

Grid1.SelectionMode = flexSelectionByRow
Grid1.ScrollBars = flexScrollBarVertical
Grid1.Rows = 1


Grid1.TextMatrix(0, 0) = "Mnemonic"
Grid1.TextMatrix(0, 1) = "Flags"
Grid1.TextMatrix(0, 2) = "Description"


Grid1.ColWidth(0) = 1200
Grid1.ColWidth(1) = 800
Grid1.ColWidth(2) = 2500




Grid1.FillStyle = flexFillRepeat
Grid1.RowSel = 0
Grid1.CellFontBold = True
Grid1.FillStyle = flexFillSingle

For i = 0 To 2
Grid1.RowSel = 0
Grid1.Col = i
Grid1.CellBackColor = &HC0C0C0
Next i

Grid1.SelectionMode = flexSelectionFree


Grid1.AddItem "BRK" & vbTab & "" & vbTab & "Break"
Grid1.AddItem "NOP" & vbTab & "" & vbTab & "No operation"
Grid1.AddItem "RET" & vbTab & "" & vbTab & "Return from sub"
Grid1.AddItem "TOG" & vbTab & "" & vbTab & "Toggle LED"
Grid1.AddItem "LDI Rx,Ry" & vbTab & "" & vbTab & "Load immediate constant to Rx"
Grid1.AddItem "DEC Rx" & vbTab & "Z, C" & vbTab & "Decrement Rx"
Grid1.AddItem "INC Rx" & vbTab & "Z, C" & vbTab & "Increment Rx"
Grid1.AddItem "MOV Rx,Ry" & vbTab & "" & vbTab & "Move Rx=Ry"
Grid1.AddItem "IN Rx" & vbTab & "" & vbTab & "Enter Rx"
Grid1.AddItem "ADD Rx" & vbTab & "Z, C" & vbTab & "Add Rx to R0"
Grid1.AddItem "SUB Rx" & vbTab & "Z, C" & vbTab & "Subtract Rx from R0"
Grid1.AddItem "MUL Rx" & vbTab & "Z, C" & vbTab & "Multiply Rx from R0"
Grid1.AddItem "DIC Rx" & vbTab & "Z, C" & vbTab & "Divide Rx from R0"
Grid1.AddItem "PUSH Rx" & vbTab & "" & vbTab & "Push Rx onto stack"
Grid1.AddItem "POP Rx" & vbTab & "" & vbTab & "Pop Rx from stack"

Grid1.AddItem "JZ adr." & vbTab & "" & vbTab & "Jump if zero"
Grid1.AddItem "JNZ adr." & vbTab & "" & vbTab & "Jump if not zero"
Grid1.AddItem "JC adr." & vbTab & "" & vbTab & "Jump if carry set"
Grid1.AddItem "JSR adr." & vbTab & "" & vbTab & "Jump to sub"
Grid1.AddItem "JE adr." & vbTab & "" & vbTab & "Jump if equal"
Grid1.AddItem "JNE adr." & vbTab & "" & vbTab & "Jump if not equal"
Grid1.AddItem "JA adr." & vbTab & "" & vbTab & "Jump if above"
Grid1.AddItem "JAE adr." & vbTab & "" & vbTab & "Jump if above or equal"
Grid1.AddItem "JL adr." & vbTab & "" & vbTab & "Jump if less"
Grid1.AddItem "JLE adr." & vbTab & "" & vbTab & "Jump if less or equal"

Grid1.AddItem "MSG Ax,String" & vbTab & "" & vbTab & "Move string in Ax"
Grid1.AddItem "Out Ax" & vbTab & "" & vbTab & "Display a string in Ax"

End Sub
