Private Sub List1_MouseUp(ByVal Button As Integer, ByVal Shift As Integer, ByVal X As Single, ByVal Y As Single)
Dim i As Integer

For i = 0 To List1.ListCount - 1
    If List1.Selected(i) = True Then
        Indexx = i
        Selected = True
    'Else
        'Selected = False
    End If

Next i
End Sub

Private Sub Timer1_Timer()
If List1.ListCount > 0 Then Run


If TOGGLE = True Then
    'frmOutput.LED.Value = 1
    frmOutput.lblLED.BackColor = &HFF&
Else
    'frmOutput.LED.Value = 0
    frmOutput.lblLED.BackColor = &H80&
End If
End Sub



Private Sub txtEingabe_KeyDown(ByVal KeyCode As Integer, ByVal Shift As Integer)
If KeyCode = 13 And txtEingabe <> "" Then
    SaveFlag = True
    CheckInput
    
    If Scroll = 1 Then
        If List1.ListCount > 0 Then
            List1.ListIndex = List1.ListCount - 1
            List1.Selected(List1.ListIndex) = False
        End If
    End If
End If

If Shift = 2 And KeyCode = 82 Then
    Timer1.Enabled = True
    frmOutput.Show
End If

If Shift = 2 And KeyCode = 70 Then
    If cmdBar.Visible = True Then
        cmdBar.Visible = False
        List1.Top = 20
        List1.Height = 3200
    Else
        cmdBar.Visible = True
        List1.Top = 360
        List1.Height = 2670
    End If
End If
End Sub


