Private Sub cmdBar_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)
 Select Case Button.Key
    Case "new"
        Dim A As Integer
        A = MsgBox("Do you want to start a new project without saving?", vbYesNo, "Info")
        If A = vbYes Then
        On Error Resume Next
            List1.Clear
            Indexx = 0
            LINE = 0
            pc = 0
            sp = 0
            zero = False
            carry = False
            err = False
            txtEingabe.Text = ""
            
            For r = 0 To 7
                reg(r) = 0
            Next r
            Exit Sub
        End If
    
    
    Case "save"
        CommonDialog1.Flags = cdlOFNHideReadOnly + cdlOFNOverwritePrompt + cdlOFNPathMustExist
        CommonDialog1.DefaultExt = "asc"
        CommonDialog1.Filename = ""
        CommonDialog1.Filter = "ASMCode (*.asc)|*.asc"
        CommonDialog1.DialogTitle = "Saving..."
        CommonDialog1.ShowSave
        On Error Resume Next
        Filename = CommonDialog1.Filename
        DBSpeichern
        SaveFlag = False
    
    Case "open"
        CommonDialog1.Flags = cdlOFNHideReadOnly + cdlOFNOverwritePrompt + cdlOFNPathMustExist
        CommonDialog1.DefaultExt = "asc"
        CommonDialog1.Filename = ""
        CommonDialog1.Filter = "ASMCode (*.asc)|*.asc"
        CommonDialog1.DialogTitle = "Open..."
        CommonDialog1.ShowOpen
        On Error Resume Next
        Filename = CommonDialog1.Filename
        DBladen

    
    Case "run"
        Timer1.Enabled = True
        frmOutput.Show
    
    Case "del"
        If List1.Selected(List1.ListIndex) = True And Indexx > -1 Then
            If Indexx < 16 Then
                VorNull = "0"
            Else
                VorNull = ""
            End If
                List1.RemoveItem (List1.ListIndex)
                If Indexx < List1.ListCount Then
                    List1.AddItem VorNull & Hex(Indexx), Indexx
                End If
                'LINE = LINE - 1
                 Selected = False
                'Indexx = 0
        End If
    
    Case "paste"
       ' If List1.Selected(List1.ListIndex) = True Then
       '     If Indexx < 16 Then VorNull = "0"
       '         frmMain.List1.AddItem VorNull & Hex(Indexx), Indexx
       '         Selected = False
       '         Indexx = 0

        '    LINE = LINE + 1
        'End If
    Case "font"
        CommonDialog1.ShowFont
        On Error Resume Next
        List1.Font.Name = CommonDialog1.FontName
        List1.Font.Size = CommonDialog1.FontSize
        List1.Font.Bold = CommonDialog1.FontBold
        List1.Font.Italic = CommonDialog1.FontItalic
        SaveSetting App.Title, "SettingsAC", "Font", List1.Font.Name
        SaveSetting App.Title, "SettingsAC", "Font1", List1.Font.Size
        SaveSetting App.Title, "SettingsAC", "Font2", List1.Font.Bold
        SaveSetting App.Title, "SettingsAC", "Font3", List1.Font.Italic
    
    Case "settings"
        frmOptionen.Show
        

        Case "about"
            frmAbout.Show
        
        Case "help"
            frmHelp.Show
        

    End Select
End Sub

Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
 Select Case Item.Key
    Case "new"
        Dim A As Integer
        A = MsgBox("Do you want to start a new project without saving?", vbYesNo, "Info")
        If A = vbYes Then
        On Error Resume Next
            List1.Clear
            Indexx = 0
            LINE = 0
            pc = 0
            sp = 0
            zero = False
            carry = False
            err = False
            txtEingabe.Text = ""
            For r = 0 To 7
                reg(r) = 0
            Next r
            Exit Sub
        End If
    
    
    Case "save"
        CommonDialog1.Flags = cdlOFNHideReadOnly + cdlOFNOverwritePrompt + cdlOFNPathMustExist
        CommonDialog1.DefaultExt = "asc"
        CommonDialog1.Filename = ""
        CommonDialog1.Filter = "ASMCode (*.asc)|*.asc"
        CommonDialog1.DialogTitle = "Saving..."
        CommonDialog1.ShowSave
        On Error Resume Next
        Filename = CommonDialog1.Filename
        DBSpeichern
        SaveFlag = False
    
    Case "open"
        On Error Resume Next
        CommonDialog1.Flags = cdlOFNHideReadOnly + cdlOFNOverwritePrompt + cdlOFNPathMustExist
        CommonDialog1.DefaultExt = "asc"
        CommonDialog1.Filename = ""
        CommonDialog1.Filter = "ASMCode (*.asc)|*.asc"
        CommonDialog1.DialogTitle = "Open..."
        CommonDialog1.ShowOpen
        On Error Resume Next
        Filename = CommonDialog1.Filename
        DBladen
        'LINE = frmMain.List1.ListCount - 1

    
    Case "Exit"
        If SaveFlag = True Then
            Dim aa As Integer
            aa = MsgBox("Do you want to exit without saving?", vbYesNo, "Info")
            If aa = vbYes Then
            On Error Resume Next
            App.End
            End If
        Else
            App.End
        End If
        
     Case "run"
        Timer1.Enabled = True
        frmOutput.Show
    
    Case "settings"
        frmOptionen.Show
    
    Case "samples"
        frmSamples.Show
        

        Case "about"
            frmAbout.Show
        
        Case "help"
            frmHelp.Show
        

    End Select
End Sub











Private Sub Form_Activate()


End Sub

Private Sub Form_Load()
Indexx = 0
LINE = 0
pc = 0
sp = 0
zero = False
carry = False
err = False

For r = 0 To 7
    reg(r) = 0
Next r

SaveFlag = False


cmdBar.Left = 0
cmdBar.Top = 0
cmdBar.Width = Me.Width

ImageList1.Add App.Path & "\BarMC.bmp"
cmdBar.ImageList = ImageList1.hImageList

Dim mnuMain As CommandbarLib.CommandBarMenuBar
Dim mnuFile As CommandbarLib.Item
Dim mnuKategorie As CommandbarLib.Item
Dim mnuEdit As CommandbarLib.Item
Dim mnuRun As CommandbarLib.Item
   
    Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
    Set mnuFile = mnuMain.Items.Add(1, , "&File")
    mnuFile.SubItems.Add , "new", "&New"
    mnuFile.SubItems.Add , "open", "&Open"
    mnuFile.SubItems.Add , "save", "&Save"
    mnuFile.SubItems.Add , , "", cbrMenuSeparator
    mnuFile.SubItems.Add , "Exit", "E&xit"
    
    Set mnuKategorie = mnuMain.Items.Add(2, , "&Extras")
    mnuKategorie.SubItems.Add , "settings", "&Settings"

    Set mnuRun = mnuMain.Items.Add(3, "run", "&Run")
    
    Set mnuEdit = mnuMain.Items.Add(4, , "&?")
    mnuEdit.SubItems.Add , "about", "&About"
    mnuEdit.SubItems.Add , "help", "&Help"
    

If Me.Width >= SIZE_SUPPORTSBUTTONS Then
    
        Dim Button As CommandbarLib.CommandBarButton
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep0")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "new")
        Button.Image = 2
        Button.Tag = "new"
        Set Button = cmdBar.Controls.Add(cbrButton, "open")
        Button.Image = 0
        Button.Tag = "open"
        Set Button = cmdBar.Controls.Add(cbrButton, "save")
        Button.Image = 1
        Button.Tag = "save"
        Set Button = cmdBar.Controls.Add(cbrButton, "sep1")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "run")
        Button.Image = 6
        Button.Tag = "run"
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep22")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "del")
        Button.Image = 4
        Button.Tag = "del"
        Set Button = cmdBar.Controls.Add(cbrButton, "font")
        Button.Image = 9
        Button.Tag = "font"
        'cmdBar.Controls(10).Enabled = False
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep2")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "settings")
        Button.Image = 3
        Button.Tag = "settings"
        Set Button = cmdBar.Controls.Add(cbrButton, "help")
        Button.Image = 5
        Button.Tag = "help"

        

 
    End If


Hints = GetSetting(App.Title, "SettingsAC", "Help", 1)
TimerSpeed = GetSetting(App.Title, "SettingsAC", "TimerSpeed", 500)
Layout = GetSetting(App.Title, "SettingsAC", "Layout", 1)
Scroll = GetSetting(App.Title, "SettingsAC", "Scroll", 1)

List1.Font.Name = GetSetting(App.Title, "SettingsAC", "Font", "Tahoma")
List1.Font.Size = GetSetting(App.Title, "SettingsAC", "Font1", "12")
List1.Font.Bold = GetSetting(App.Title, "SettingsAC", "Font2", False)
List1.Font.Italic = GetSetting(App.Title, "SettingsAC", "Font3", False)

If Layout = 0 Then
    List1.BackColor = vbBlack
    List1.ForeColor = vbWhite
    frmMain.BackColor = vbBlack
End If
If Layout = 1 Then
    List1.BackColor = vbWhite
    List1.ForeColor = vbBlack
    frmMain.BackColor = &H8000000F
End If



Timer1.Interval = TimerSpeed


SetFocusAPI txtEingabe.hwnd

End Sub










