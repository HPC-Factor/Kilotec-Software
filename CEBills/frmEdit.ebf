Attribute VB_Name = "frmEdit"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Combo1_Change()

End Sub

Private Sub Command1_Click()
DBbearbeiten
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Form_Activate()

Center Me
Combo1.Clear
cboIntervall.Clear
AddToCombo Combo1

Combo1.Text = DBdaten(0, IndexX)
txtBezeichnung.Text = DBdaten(1, IndexX)
txtDatum.Text = DBdaten(2, IndexX)
cboIntervall.Text = DBdaten(3, IndexX)
txtBetrag.Text = DBdaten(4, IndexX)

ReplaceIndex = IndexX



If LANGUAGE = 1 Then
    Me.Caption = "Eintrag bearbeiten"
    Label3.Caption = "Kategorie:"
    Label1.Caption = "Bezeichnung:"
    Label2.Caption = "Datum:"
    Label4.Caption = "Intervall:"
    Label5.Caption = "Betrag:"
    lblCurrency.Caption = "€"
    Command2.Caption = "&Schließen"
    cboIntervall.AddItem "einmalig"
    cboIntervall.AddItem "täglich"
    cboIntervall.AddItem "wöchentlich"
    cboIntervall.AddItem "monatlich"
    cboIntervall.AddItem "halbjährlich"
    cboIntervall.AddItem "vierteljährlich"
    cboIntervall.AddItem "jährlich"
Else
    Me.Caption = "Edit entry"
    Label3.Caption = "Category:"
    Label1.Caption = "Name:"
    Label2.Caption = "Date:"
    Label4.Caption = "Interval:"
    Label5.Caption = "Amount:"
    lblCurrency.Caption = "$"
    Command2.Caption = "&Close"
    cboIntervall.AddItem "once"
    cboIntervall.AddItem "daily"
    cboIntervall.AddItem "weekly"
    cboIntervall.AddItem "monthly"
    cboIntervall.AddItem "semi-annually"
    cboIntervall.AddItem "quarterly"
    cboIntervall.AddItem "annually"
End If

End Sub

Private Sub Form_Load()
Center Me

End Sub


