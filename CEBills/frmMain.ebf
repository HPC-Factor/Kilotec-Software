Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub cmdBar_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)
InvokeAction CInt(Button.Tag), True
End Sub

Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
InvokeAction (Item.Index + (100 * Item.Parent.Index)), False
End Sub
Private Sub InvokeAction(ID As Integer, FromButton As Boolean)
   Select Case (ID)
    Case ID_EXIT        ' terminate the app
        App.End
         
    
    Case ID_ABOUT       ' thick brush mode
        frmAbout.Show
    
    Case ID_KATEGORIE
        frmKatalog.Show vbModal
        If frmKatalog.Tag = "OK" Then
        Dim oldText As String
        oldText = Combo1.Text
        Combo1.Clear
        AddToCombo Combo1
        Combo1.Text = oldText
        End If
         
    Case ID_ADD
        frmAdd.Show
    
    Case ID_EDIT
        If ListView1.ListItems.Count > 0 Then
        IndexX = ListView1.SelectedItem.SubItems(4)
        frmEdit.Show
        End If
    
    Case ID_DELETE
        Dim a As Integer
        
            If LANGUAGE = 0 Then a = MsgBox("Do you want to delete the current entry?", vbYesNo, "Info")
            If LANGUAGE = 1 Then a = MsgBox("Möchten Sie den aktuellen Eintrag löschen?", vbYesNo, "Info")
            If a = vbYes Then
            On Error Resume Next
                LoescheEintrag
                ReplaceIndex = IndexX
                Exit Sub
            End If
            
    Case ID_SAVE
        DBspeichern
        If LANGUAGE = 0 Then a = MsgBox("Database saved!", vbOKOnly, "Info")
        If LANGUAGE = 1 Then a = MsgBox("Datenbank gespeichert!", vbOKOnly, "Info")
        
    Case ID_FIND
        frmFind.Show
        
    Case ID_ABOUT
        frmAbout.Show
        
    Case ID_OPTIONS
        frmOptions.Show
        
    Case ID_STATISTIK
        frmStatistik.Show
        
    
    
    Case Else
        ' programming error -- undefined tool
        MsgBox "Undefined Commandbar Command!"
    End Select
End Sub

Private Sub Combo1_Change()

End Sub

Private Sub Combo1_Click()
'If Combo1.Text <> "" Then
On Error Resume Next
KategorieIndex = Combo1.Text
SaveSetting App.Title, "Settings", "Combo1", Combo1.Text
EinlesenEintraege
'End If
End Sub





Private Sub Form_Load()
Center Me
LANGUAGE = GetSetting(App.Title, "Settings", "Sprache", "0")
SYMBOL = GetSetting(App.Title, "Settings", "Symbol", "€")


cmdBar.Left = 0
cmdBar.Top = 0
cmdBar.Width = Me.Width

ImageList1.Add App.Path & "\Bar3.bmp"
cmdBar.ImageList = ImageList1.hImageList

Dim mnuMain As CommandbarLib.CommandBarMenuBar
Dim mnuFile As CommandbarLib.Item
Dim mnuEdit As CommandbarLib.Item
Dim mnuKategorie As CommandbarLib.Item
Dim mnuSearch As CommandbarLib.Item
   
If LANGUAGE = 1 Then
    Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
    Set mnuFile = mnuMain.Items.Add(1, , "&Datei")
    mnuFile.SubItems.Add 1, , "&Über"
    mnuFile.SubItems.Add 2, , "", cbrMenuSeparator
    mnuFile.SubItems.Add 3, , "&Speichern"
    mnuFile.SubItems.Add 4, , "", cbrMenuSeparator
    mnuFile.SubItems.Add 5, , "B&eenden"
    
    Set mnuEdit = mnuMain.Items.Add(2, , "&Bearbeiten")
    mnuEdit.SubItems.Add 1, , "&Neuer Eintrag"
    mnuEdit.SubItems.Add 2, , "Eintrag editieren"
    mnuEdit.SubItems.Add 3, , "", cbrMenuSeparator
    mnuEdit.SubItems.Add 4, , "Eintrag löschen"
    'mnuEdit.SubItems.Add 5, , "", cbrMenuSeparator
    'mnuEdit.SubItems.Add 6, , "&Speichern"
    
    Set mnuKategorie = mnuMain.Items.Add(3, , "&Extras")
    mnuKategorie.SubItems.Add 1, , "Kategorie"
    mnuKategorie.SubItems.Add 2, , "Statistik"
    mnuKategorie.SubItems.Add 3, , "", cbrMenuSeparator
    mnuKategorie.SubItems.Add 4, , "&Optionen"
    
    Set mnuSearch = mnuMain.Items.Add(4, , "S&uchen")
    mnuSearch.SubItems.Add 1, , "&Eintrag suchen"
Else
    Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
    Set mnuFile = mnuMain.Items.Add(1, , "&File")
    mnuFile.SubItems.Add 1, , "&About"
    mnuFile.SubItems.Add 2, , "", cbrMenuSeparator
    mnuFile.SubItems.Add 3, , "&Save"
    mnuFile.SubItems.Add 4, , "", cbrMenuSeparator
    mnuFile.SubItems.Add 5, , "E&xit"
    
    Set mnuEdit = mnuMain.Items.Add(2, , "&Edit")
    mnuEdit.SubItems.Add 1, , "&New entry"
    mnuEdit.SubItems.Add 2, , "Edit entry"
    mnuEdit.SubItems.Add 3, , "", cbrMenuSeparator
    mnuEdit.SubItems.Add 4, , "Delete entry"
    mnuEdit.SubItems.Add 5, , "", cbrMenuSeparator
    mnuEdit.SubItems.Add 6, , "&Save database"
    
    Set mnuKategorie = mnuMain.Items.Add(3, , "&Extras")
    mnuKategorie.SubItems.Add 1, , "Categorie"
    mnuKategorie.SubItems.Add 2, , "Statistics"
    mnuKategorie.SubItems.Add 3, , "", cbrMenuSeparator
    mnuKategorie.SubItems.Add 4, , "&Options"
    
    Set mnuSearch = mnuMain.Items.Add(4, , "&Find")
    mnuSearch.SubItems.Add 1, , "&Search entry"
End If


If Me.Width >= SIZE_SUPPORTSBUTTONS Then
    
        Dim Button As CommandbarLib.CommandBarButton
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep0")
        Button.Style = cbrSeparator
        Set Button = cmdBar.Controls.Add(cbrButton, "new")
        Button.Image = 0
        Button.Tag = ID_ADD
        Set Button = cmdBar.Controls.Add(cbrButton, "edit")
        Button.Image = 1
        Button.Tag = ID_EDIT
        Set Button = cmdBar.Controls.Add(cbrButton, "sep1")
        Button.Style = cbrSeparator
        Set Button = cmdBar.Controls.Add(cbrButton, "delete")
        Button.Image = 2
        Button.Tag = ID_DELETE
        Set Button = cmdBar.Controls.Add(cbrButton, "sep2")
        Button.Style = cbrSeparator
        Set Button = cmdBar.Controls.Add(cbrButton, "save")
        Button.Image = 3
        Button.Tag = ID_SAVE
        Set Button = cmdBar.Controls.Add(cbrButton, "sep3")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "category")
        Button.Image = 4
        Button.Tag = ID_KATEGORIE
        Set Button = cmdBar.Controls.Add(cbrButton, "columns")
        Button.Image = 5
        Button.Tag = ID_STATISTIK
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep4")
        Button.Style = cbrSeparator
            
        Set Button = cmdBar.Controls.Add(cbrButton, "find")
        Button.Image = 6
        Button.Tag = ID_FIND
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep5")
        Button.Style = cbrSeparator
         
        Set Button = cmdBar.Controls.Add(cbrButton, "info")
        Button.Image = 7
        Button.Tag = ID_ABOUT
 
    End If





    
DBladen


AddToCombo Combo1

'Combo1.Text = Combo1.List(Combo1.ListIndex(0))
Combo1.Text = GetSetting(App.Title, "Settings", "Combo1", Combo1.List(Combo1.ListIndex(0)))
KategorieIndex = Combo1.Text
EinlesenEintraege

End Sub



