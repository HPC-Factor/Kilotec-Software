Attribute VB_Name = "frmOptions"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Combo1_Change()

End Sub

Private Sub Combo1_Click()
LANGUAGE = Combo1.ListIndex
If LANGUAGE = 0 Then
        Me.Caption = "Options"
        Label3.Caption = "Language:"
        Command1.Caption = "&Apply"
        Command2.Caption = "&Close"
        Label4.Caption = "Currency:"
        Symbol1.Text = "$"
Else
    Me.Caption = "Optionen"
    Label3.Caption = "Sprache:"
    Command1.Caption = "&‹bernehmen"
    Command2.Caption = "&Schlieﬂen"
    Label4.Caption = "W‰hrung:"
    Symbol1.Text = "Ä"
End If
End Sub

Private Sub Command1_Click()
LANGUAGE = Combo1.ListIndex
SYMBOL = Symbol1.Text
If LANGUAGE = 0 Then MsgBox "New language after restart!", , "Info"
If LANGUAGE = 1 Then MsgBox "Neue Sprache nach Neustart!", , "Info"
SaveSetting App.Title, "Settings", "Sprache", LANGUAGE
SaveSetting App.Title, "Settings", "Symbol", SYMBOL
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub



Private Sub Form_Activate()
Combo1.Text = Combo1.List(LANGUAGE)


End Sub

Private Sub Form_Load()
Center Me
Combo1.AddItem "English"
Combo1.AddItem "Deutsch"

If LANGUAGE = 0 Then
    Me.Caption = "Options"
    Label3.Caption = "Language:"
    Command1.Caption = "&Apply"
    Command2.Caption = "&Close"
    Label4.Caption = "Currency:"
    Symbol1.Text = "$"
    
End If
If LANGUAGE = 1 Then
    Me.Caption = "Optionen"
    Label3.Caption = "Sprache:"
    Command1.Caption = "&‹bernehmen"
    Command2.Caption = "&Schlieﬂen"
    Label4.Caption = "W‰hrung:"
    Symbol1.Text = "Ä"
End If
End Sub

