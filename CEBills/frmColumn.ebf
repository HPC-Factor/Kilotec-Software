Attribute VB_Name = "frmStatistik"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Column2_Change()
End Sub

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Center Me
Zeitraum = 0
GesamtBetrag = 0
MaxBill = 0
MinBill = 100000

For XX = 0 To Zaehler - 1
    If DBdaten(4, XX) > MaxBill Then
        MaxBill = DBdaten(4, XX)
    End If
Next XX

For XX = 0 To Zaehler - 1
    If CLng(DBdaten(4, XX)) < MinBill Then
        MinBill = CLng(DBdaten(4, XX))
    End If
Next XX

For XX = 0 To Zaehler - 1
    GesamtBetrag = GesamtBetrag + Int(DBdaten(4, XX))
    If CDate(DBdaten(2, XX)) <> "" And CDate(Date) > CDate(DBdaten(2, XX)) Then Zeitraum = Zeitraum + 1
Next XX

If LANGUAGE = 0 Then
    Me.Caption = "Statistics"
    Label3.Caption = "Category:"

End If
If LANGUAGE = 1 Then
    Me.Caption = "Statistik"
    Label1.Caption = "Offene Rechnungen insgesamt: "
    Label2.Caption = "Offene Beträge insgesamt: "
    Label3.Caption = "Zeitraum überschritten: "
    Label4.Caption = "Höchste Rechnung: "
    Label5.Caption = "Niedrigste Rechnung: "
End If
If LANGUAGE = 0 Then
    Me.Caption = "Statistics"
    Label1.Caption = "Total open bills: "
    Label2.Caption = "Open amounts: "
    Label3.Caption = "Period exceeded: "
    Label4.Caption = "Highest bill: "
    Label5.Caption = "Lowest bill: "
End If

Label6.Caption = Zaehler
Label7.Caption = GesamtBetrag & " " & SYMBOL
Label8.Caption = Zeitraum
Label9.Caption = MaxBill & " " & SYMBOL
Label10.Caption = MinBill & " " & SYMBOL

End Sub

Private Sub Form_Load()
Center Me


End Sub

Private Sub Label3_Click()

End Sub
