Private Sub Combo1_Click()
TeamIndex = Combo1.ListIndex + 1
Command1.Enabled = True
Geld = GetRandomNumber((Form(TeamIndex) * 10000 / Liga), 500000 / Liga)
End Sub






Private Sub NeuesSpiel()
Randomize Timer






Dim i As Long
For i = 1 To 18
    Combo1.AddItem Mannschaft(i)
    Tore(i) = 0
    Gegentore(i) = 0
    Punkte(i) = 0
Next i





End Sub
