Option Explicit

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Center Me
List1.Clear
TabellenRechner

   For i = 1 To 18
        If i < 10 Then
            VorNull = " "
        Else
            VorNull = ""
        End If
            If Liga = 1 And i = 2 Then List1.AddItem "----------------------------------------------------"
            If Liga = 2 And i = 3 Then List1.AddItem "----------------------------------------------------"
            If Liga = 3 And i = 3 Then List1.AddItem "----------------------------------------------------"
            
            If Liga = 1 And i = 17 Then List1.AddItem "----------------------------------------------------"
            If Liga = 2 And i = 17 Then List1.AddItem "----------------------------------------------------"
            If Liga = 3 And i = 15 Then List1.AddItem "----------------------------------------------------"
            List1.AddItem VorNull & i & ". " & Mannschaft2(i) & Space(22 - Len(Mannschaft2(i))) & Spieltag - 1 & Space(7 - Len(Spieltag)) & Tore2(i) & ":" & Gegentore2(i) & Space(8 - Len(Tore2(i) & ":" & Gegentore2(i))) & Int(Tore2(i) - Gegentore2(i)) & Space(7 - Len(Int(Tore2(i) - Gegentore2(i)))) & Punkte2(i)
   Next i
End Sub

Private Sub Form_Load()
  
   
End Sub
