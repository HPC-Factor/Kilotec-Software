Attribute VB_Name = "frmPreise"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
Eintritt = Int(lblNeu.Caption)
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Command3_Click()
If lblNeu.Caption < 50 Then lblNeu.Caption = lblNeu.Caption + 1
End Sub

Private Sub Command4_Click()
If lblNeu.Caption > 1 Then lblNeu.Caption = lblNeu.Caption - 1
End Sub

Private Sub Form_Activate()
Center Me

lblPreis.Caption = Eintritt & " €"
lblNeu.Caption = Eintritt
End Sub

Private Sub Form_Load()

End Sub
