Attribute VB_Name = "frmVerkaufen"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Command2_Click()


If optAbwehr.Value = True Then
    If txtPunkte.Text = "" Or Int(txtPunkte.Text) > Int(Abwehr(TeamIndex) / 3) Or Int(txtPunkte.Text) < 1 Then
        MsgBox "Falsche Eingabe!", vbOKOnly, "Hinweis"
        Exit Sub
    Else
        Geld = Geld + lblGeld.Caption
        Abwehr(TeamIndex) = Abwehr(TeamIndex) - txtPunkte.Text
        Aktualisieren
        Me.Hide
    End If
End If

If optMittelfeld.Value = True Then
    If txtPunkte.Text = "" Or Int(txtPunkte.Text) > Int(Mittelfeld(TeamIndex) / 3) Or Int(txtPunkte.Text) < 1 Then
        MsgBox "Falsche Eingabe!", vbOKOnly, "Hinweis"
        Exit Sub
    Else
        Geld = Geld + lblGeld.Caption
        Mittelfeld(TeamIndex) = Abwehr(TeamIndex) - txtPunkte.Text
        Aktualisieren
        Me.Hide
    End If
End If

If optAngriff.Value = True Then
    If txtPunkte.Text = "" Or Int(txtPunkte.Text) > Int(Angriff(TeamIndex) / 3) Or Int(txtPunkte.Text) < 1 Then
        MsgBox "Falsche Eingabe!", vbOKOnly, "Hinweis"
        Exit Sub
    Else
        Geld = Geld + lblGeld.Caption
        Angriff(TeamIndex) = Abwehr(TeamIndex) - txtPunkte.Text
        Aktualisieren
        Me.Hide
    End If

End If
End Sub

Private Sub Form_Activate()
Center Me
Verkaufberechnen
End Sub

Private Sub Form_Load()

End Sub

Public Sub Verkaufberechnen()
If optAbwehr.Value = True Then
    lblMax.Caption = "(Max: " & Int(Abwehr(TeamIndex) / 3) & ")"
    lblGeld.Caption = GetRandomNumber(50000 / Liga, 200000 / Liga) '& " €"
End If

If optMittelfeld.Value = True Then
    lblMax.Caption = "(Max: " & Int(Mittelfeld(TeamIndex) / 3) & ")"
    lblGeld.Caption = GetRandomNumber(70000 / Liga, 220000 / Liga) '& " €"
End If

If optAngriff.Value = True Then
    lblMax.Caption = "(Max: " & Int(Angriff(TeamIndex) / 3) & ")"
    lblGeld.Caption = GetRandomNumber(40000 / Liga, 150000 / Liga) '& " €"
End If

End Sub

Private Sub optAbwehr_Click()
Verkaufberechnen
End Sub

Private Sub optAngriff_Click()
Verkaufberechnen
End Sub

Private Sub optMittelfeld_Click()
Verkaufberechnen
End Sub

Private Sub txtPunkte_Change()
Command2.Enabled = True
End Sub
