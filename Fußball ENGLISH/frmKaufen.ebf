Option Explicit

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Command2_Click()

If Geld < ab(List1.ListIndex + 1) Then
MsgBox "Du hast nicht genug Geld!", vbOKOnly, "ACHTUNG"
Exit Sub
End If

Geld = Geld - ab(List1.ListIndex + 1)
If optAngriff.Value = True Then Angriff(TeamIndex) = Angriff(TeamIndex) + s(List1.ListIndex + 1)
If optMittelfeld.Value = True Then Mittelfeld(TeamIndex) = Mittelfeld(TeamIndex) + s(List1.ListIndex + 1)
If optAbwehr.Value = True Then Abwehr(TeamIndex) = Abwehr(TeamIndex) + s(List1.ListIndex + 1)

'Spiel(TeamIndex) = Spiel(TeamIndex) + s(List1.ListIndex + 1)
'Spiel(TeamIndex) = Spiel(TeamIndex) * 100
'Spiel(TeamIndex) = Fix(Spiel(TeamIndex))
'Spiel(TeamIndex) = Spiel(TeamIndex) / 100


Aktualisieren
Me.Hide

End Sub

