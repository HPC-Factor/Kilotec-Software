Private Sub List1_Click()
Command2.Enabled = True
End Sub

Public Sub Anzeige()
Dim i As Long
List1.Clear

Dim Staerke As Integer
Dim Kosten As Long


For i = 1 To 10
    If i < 10 Then
        VorNull = " "
    Else
        VorNull = ""
    End If
    'List1.AddItem i & Space(10 - Len(i)) & s(i) & Space(10 - Len(s(i))) & ab(i)
    List1.AddItem VorNull & i & " " & Position & Space(14 - Len(Position)) & " " & s(i) & Space(6 - Len(s(i))) & ab(i) & " €"
Next i

Command2.Enabled = False
End Sub

