Option Explicit

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Center Me
Dim i As Long
Dim VorNull As String

   List1.Clear
    Dim temp As String
    Dim temp2 As Integer
    Dim temp3 As Integer
    Dim temp4 As Integer
    
    Dim j As Long
    
    For i = 1 To 18
    For j = i + 1 To 18
        If Form(i) < Form(j) Then
            Form(i) = Form(i) + Form(j)
            Form(j) = Form(i) - Form(j)
            Form(i) = Form(i) - Form(j)
            
            temp = Mannschaft(i)
            Mannschaft(i) = Mannschaft(j)
            Mannschaft(j) = temp
            
            temp2 = Angriff(i)
            Angriff(i) = Angriff(j)
            Angriff(j) = temp2
            
            temp2 = Mittelfeld(i)
            Mittelfeld(i) = Mittelfeld(j)
            Mittelfeld(j) = temp2
            
            temp2 = Abwehr(i)
            Abwehr(i) = Abwehr(j)
            Abwehr(j) = temp2
     
        End If
    Next j
Next i

 
    For i = 1 To 18
        If i < 10 Then
            VorNull = " "
        Else
            VorNull = ""
        End If
        List1.AddItem VorNull & i & ". " & Mannschaft(i) & Space(22 - Len(Mannschaft(i))) & Int(Angriff(i)) & Space(8 - Len(Int(Angriff(i)))) & Int(Mittelfeld(i)) & Space(8 - Len(Int(Mittelfeld(i)))) & Int(Abwehr(i)) & Space(8 - Len(Int(Abwehr(i)))) & Int(Form(i))
    Next i
End Sub

