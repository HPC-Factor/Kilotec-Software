[Version]
Signature="$Chicago$"
CESignature="$Windows CE$"
Provider=%CompanyName%

[SourceDisksNames]
1=,"Application Files",, App

[DefaultInstall]
CopyFiles=Files.App, Files.Windows
CEShortcuts=Shortcuts

[Shortcuts]
%AppName%,0,"FM.vb"

[CEStrings]
InstallDir=%CE1%\%AppName%
AppName="FM"

[Strings]
CompanyName="Dominik Kristen"

[DestinationDirs]
Shortcuts=,%CE11%
Files.App=,%InstallDir%
Files.Windows=,%CE2%
Files.SH 3 (1K) v2.10=,%CE2%

[SourceDisksFiles]
Soccer2.bmp=1
Deutsch.bmp=1
FM.vb=1

[DefaultInstall.SH 3 (1K) v2.10]
CopyFiles=Files.SH 3 (1K) v2.10
CESelfRegister=MSCECommandBar.dll,MSCEFile.dll,MSCEPicture.dll,vbscript.dll,pvbhost2.dll,pvbform2.dll

[CEDevice.SH 3 (1K) v2.10]
ProcessorType=10003

[SourceDisksNames.SH 3 (1K) v2.10]
3= ,"SH 3 (1K) v2.10 Files",,SH 3 (1K) v2.10

[SourceDisksFiles.SH 3 (1K) v2.10]
MSCECommandBar.dll=3
MSCEPicture.dll=3
pvbload.exe=3
pvbform2.dll=3
MSCEFile.dll=3
vbscript.dll=3
pvbhost2.dll=3
vbsen.dll=3

