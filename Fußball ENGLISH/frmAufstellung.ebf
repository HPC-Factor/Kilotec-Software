End
Attribute VB_Name = "frmAufstellung"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Form_Activate()
List1.Clear

For i = 1 To 13
        If i < 10 Then
            VorNull = " "
        Else
            VorNull = ""
        End If
    List1.AddItem VorNull & i & " " & Aufstellung(i)
Next i
End Sub

Private Sub Form_Load()
Center Me
End Sub
