VERSION 5.00
Begin VB.Form frmAufstellung 
   BackColor       =   &H00800000&
   BorderStyle     =   1  'Fixed Single
   Caption         =   "AUFSTELLUNG"
   ClientHeight    =   3225
   ClientLeft      =   45
   ClientTop       =   390
   ClientWidth     =   8880
   ScaleHeight     =   3225
   ScaleWidth      =   8880
   Begin VBCE.ListBox List1 
      Height          =   2670
      Left            =   120
      TabIndex        =   0
      Top             =   360
      Width           =   6855
      List            =   "frmAufstellung.frx":0000
      ItemData        =   "frmAufstellung.frx":0028
      _cx             =   12091
      _cy             =   4710
      Appearance      =   0
      BackColor       =   -2147483643
      Enabled         =   -1  'True
      BeginProperty Font {0BE35203-8F91-11CE-9DE3-00AA004BB851} 
         Name            =   "Courier New"
         Size            =   9.75
         Charset         =   0
         Weight          =   700
         Underline       =   0   'False
         Italic          =   0   'False
         Strikethrough   =   0   'False
      EndProperty
      ForeColor       =   -2147483640
      Columns         =   0
      IntegralHeight  =   -1  'True
