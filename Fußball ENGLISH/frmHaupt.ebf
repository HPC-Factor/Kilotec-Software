Attribute VB_Name = "frmHaupt"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
If Command1.Caption = "SAISONENDE" Then
    frmSaisonende.Show
    Exit Sub
End If

Command1.Enabled = False
frmErgebnis.Show

If Spieltag = 35 Then
    Command1.Caption = "SAISONENDE"
    frmHaupt.lblSpieltag.Caption = "SAISONENDE"
End If
End Sub









Private Sub Form_Activate()

End Sub

Private Sub Form_Load()
Center Me
Label2.Caption = TeamIndex

Aktualisieren

    Ball.Top = -100
    Ball.Top = 455
    Ball.Picture = App.Path & "\Deutsch.bmp"
    
    
    Dim mnuMain As CommandbarLib.CommandBarMenuBar
    Dim mnuFile As CommandbarLib.Item
    Dim mnuCalc As CommandbarLib.Item
    Dim mnuCalc2 As CommandbarLib.Item
    Dim mnuCalc3 As CommandbarLib.Item
    
    Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
    Set mnuFile = mnuMain.Items.Add(1, "Haupt", "&Menu")
    mnuFile.SubItems.Add , "NewGame", "&New game"
    mnuFile.SubItems.Add , "Load", "&load"
    mnuFile.SubItems.Add , "Save", "&save"
    mnuFile.SubItems.Add , "", "", cbrMenuSeparator
    mnuFile.SubItems.Add , "Exit", "E&xit"
    
    Set mnuCalc = mnuMain.Items.Add(2, , "&Overview")
    mnuCalc.SubItems.Add , "Tabelle", "&Standings"
    mnuCalc.SubItems.Add , "Spieltag", "&Begegnungen"
    mnuCalc.SubItems.Add , "Form", "T&eamstärken"
    
    Set mnuCalc2 = mnuMain.Items.Add(3, , "&Mannschaft")
    'mnuCalc2.SubItems.Add , "Aufstellung", "Aufstellung"
    'mnuCalc2.SubItems.Add , "", "", cbrMenuSeparator
    mnuCalc2.SubItems.Add , "Kaufen", "Spieler kaufen"
    mnuCalc2.SubItems.Add , "Verkaufen", "Spieler verkaufen"
    mnuCalc2.SubItems.Add , "Training", "Training"
    
    Set mnuCalc3 = mnuMain.Items.Add(4, , "&Verein")
    mnuCalc3.SubItems.Add , "Bilanz", "Bilanz"
    mnuCalc3.SubItems.Add , "Stadion", "Eintrittspreise"
    mnuCalc3.SubItems.Add , "", "", cbrMenuSeparator
    mnuCalc3.SubItems.Add , "Team", "Anzeigefehler Team beheben"
 
End Sub

Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
 Select Case Item.Key
     Case "NewGame"
        frmNewGame.Show
        Me.Hide
    
    Case "Exit"
        App.End
 
  
    Case "Tabelle"
        frmTabelle.Show
    Case "Spieltag"
        
        frmSpieltag.Show
    Case "Form"
        frmStaerken.Show
    Case "Bilanz"
        frmBilanz.Show
    Case "Kaufen"
        frmKaufen.Show
    Case "Verkaufen"
        frmVerkaufen.Show
        
    Case "Training"
        frmTraining.Command7.Enabled = False
        frmTraining.Command6.Enabled = False
        frmTraining.Command5.Enabled = False
        frmTraining.Command4.Enabled = False
        frmTraining.Command3.Enabled = False
        frmTraining.Command2.Enabled = False
        If Geld >= 50000 Then frmTraining.Command2.Enabled = True
        If Geld >= 75000 Then frmTraining.Command3.Enabled = True
        If Geld >= 100000 Then frmTraining.Command4.Enabled = True
        If Geld >= 150000 Then frmTraining.Command5.Enabled = True
        If Geld >= 250000 Then frmTraining.Command6.Enabled = True
        If Geld >= 500000 Then frmTraining.Command7.Enabled = True
        
        
       
     

        frmTraining.Show
        
    Case "Stadion"
        frmPreise.Show
    
    Case "Load"
        DBladen
        MsgBox "Spiel erfolgreich geladen!", vbOKOnly, "Hinweis"
        Aktualisieren
        Berechnen
        TabellenRechner
    
    Case "Save"
        DBspeichern
        MsgBox "Spiel erfolgreich gespeichert!", vbOKOnly, "Hinweis"
    
    Case "Team"
        TeamIndex = Int(Label2.Caption)
        Aktualisieren
        
    
  End Select
End Sub

