Attribute VB_Name = "frmSaisonende"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
Saison = Saison + 1
Zuschauerschnitt = 0
Platz = 1

If Liga = 1 Then
    Geld = 0
    Spieltag = 1
    For i = 1 To 18
        Tore(i) = 0
        Gegentore(i) = 0
        Punkte(i) = 0
    Next i
    x = 1
    y = 1
    x2 = 1
    Aktualisieren
    frmHaupt.Command1.Caption = "Nächster Spieltag"
End If

If Liga = 2 And Platz < 3 Then
    Liga1Aktualisieren
    Liga = 1
    Spieltag = 1
    For i = 1 To 18
        Tore(i) = 0
        Gegentore(i) = 0
        Punkte(i) = 0
    Next i
    x = 1
    y = 1
    x2 = 1
    Aktualisieren
    frmHaupt.Command1.Caption = "Nächster Spieltag"
Else
    Liga = 2
    Spieltag = 1
    For i = 1 To 18
        Tore(i) = 0
        Gegentore(i) = 0
        Punkte(i) = 0
    Next i
    x = 1
    y = 1
    x2 = 1
    Aktualisieren
    frmHaupt.Command1.Caption = "Nächster Spieltag"
    
End If

If Liga = 3 And Platz < 3 Then
    Liga2Aktualisieren
    Liga = 2
    Spieltag = 1
    For i = 1 To 18
        Tore(i) = 0
        Gegentore(i) = 0
        Punkte(i) = 0
    Next i
    x = 1
    y = 1
    x2 = 1
    Aktualisieren
    frmHaupt.Command1.Caption = "Nächster Spieltag"
Else
    Liga = 3
    Spieltag = 1
    For i = 1 To 18
        Tore(i) = 0
        Gegentore(i) = 0
        Punkte(i) = 0
    Next i
    x = 1
    y = 1
    x2 = 1
    Aktualisieren
    frmHaupt.Command1.Caption = "Nächster Spieltag"

   
End If


Me.Hide


End Sub

Private Sub Form_Load()
Label1.Caption = "Die Mannschaft " & TEAM & " ist " & Platz & ". in der " & Liga & ". Bundesliga geworden!"


If Liga = 1 And Platz > 16 Then
    Label2.Caption = "Du bist leider abgestiegen in die 2. Bundesliga!"
Else
    Label2.Caption = "Du bist im Mittelfeld der Liga gelandet!"
End If
If Liga = 1 And Platz = 1 Then Label2.Caption = "Du bist DEUTSCHER FUßBALLMEISTER!!!!"



If Liga = 2 And Platz > 16 Then Label2.Caption = "Du bist leider abgestiegen in die 3. Bundesliga!"
If Liga = 2 And Platz < 3 Then Label2.Caption = "Du bist aufgestiegen in die 1. Bundesliga"
If Liga = 2 And Platz < 17 And Platz > 2 Then Label2.Caption = "Du bist im Mittelfeld der Liga gelandet!"

If Liga = 2 And Platz = 1 Then Label2.Caption = "Du bist Meister der 2. Bundesliga geworden und steigst auf in die 1. Bundesliga!"

If Liga = 3 And Platz > 14 Then Label2.Caption = "Du bist leider abgestiegen in die Regionalliga!"
If Liga = 3 And Platz < 3 Then Label2.Caption = "Du bist aufgestiegen in die 2. Bundesliga"
If Liga = 3 And Platz < 15 And Platz > 2 Then Label2.Caption = "Du bist im Mittelfeld der Liga gelandet!"


If Liga = 3 And Platz = 1 Then Label2.Caption = "Du bist Meister der 3. Bundesliga geworden und steigst auf in die 2. Bundesliga!"




Label3.Caption = "Insgesamt hast du " & Punkte(TeamIndex) & " Punkte geholt und " & Tore(TeamIndex) & " Tore geschossen."
End Sub
