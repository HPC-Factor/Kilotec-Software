Attribute VB_Name = "frmEdit"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
DBbearbeiten
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
'AddToCombo Combo1
Aktualisieren
Label1.Caption = frmMain.ListView1.ColumnHeaders(2).Text
Label2.Caption = frmMain.ListView1.ColumnHeaders(3).Text

If LANGUAGE = "English" Then
    Me.Caption = "Edit item"
    Label3.Caption = "Category:"
    Command2.Caption = "&Close"
End If
If LANGUAGE = "Deutsch" Then
    Me.Caption = "Eintrag bearbeiten"
    Label3.Caption = "Kategorie:"
    Command2.Caption = "&Schlieﬂen"
End If
If COLOR = 0 Then Me.BackColor = &H8000000F
If COLOR = 1 Then Me.BackColor = &HC0FFC0
If COLOR = 2 Then Me.BackColor = &HFFC0C0
If COLOR = 3 Then Me.BackColor = &HC0FFFF
End Sub

Private Sub Form_Load()
Center Me
AddToCombo Combo1
Aktualisieren
End Sub

Private Sub Aktualisieren()
Combo1.Text = DBdaten(0, IndexX) & " " & DBdaten(1, IndexX)
Entry1.Text = DBdaten(2, IndexX)
Entry2.Text = DBdaten(3, IndexX)

If LANGUAGE = "English" Then
    Me.Caption = "Edit [Index:" & IndexX & "]"
    Label3.Caption = "Category:"
    Command2.Caption = "&Close"
End If
If LANGUAGE = "Deutsch" Then
    Me.Caption = "Bearbeiten [Index:" & IndexX & "]"
    Label3.Caption = "Kategorie:"
    Command2.Caption = "&Schlieﬂen"
End If
ReplaceIndex = IndexX

End Sub
