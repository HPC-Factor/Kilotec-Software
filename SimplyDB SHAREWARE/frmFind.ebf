Attribute VB_Name = "frmFind"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
Dim XX2 As Integer



Private Sub Combo1_Change()

End Sub

Private Sub Combo1_Click()

     For XX2 = 0 To Zaehler_Columns
        If DBColumns(0, XX2) = Mid(Combo1.List(Combo1.ListIndex), 1, 2) Then
            Label3.Caption = DBColumns(2, XX2)
            
        End If
    Next XX2

End Sub

Public Sub Command1_Click()
If Text1.Text = Empty Then
Exit Sub
Else
Suchen
End If
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Command3_Click()
On Error Resume Next
If ListView1.ListItems.Count > 0 Then
IndexX = ListView1.SelectedItem.SubItems(3)
frmEdit.Show
End If
End Sub

Private Sub Form_Activate()
If COLOR = 0 Then Me.BackColor = &H8000000F
If COLOR = 1 Then Me.BackColor = &HC0FFC0
If COLOR = 2 Then Me.BackColor = &HFFC0C0
If COLOR = 3 Then Me.BackColor = &HC0FFFF

Combo1.Clear
AddToCombo Combo1


Text1.Text = ""
Check1.Value = False

Me.Height = 1350
Me.Width = 6540
Center Me

'AddToCombo Combo1
Combo1.Text = frmMain.Combo1.Text


     For XX2 = 0 To Zaehler_Columns
        If DBColumns(0, XX2) = Mid(Combo1.List(Combo1.ListIndex), 1, 2) Then
            Label3.Caption = "(" & DBColumns(2, XX2) & ")"
            
        End If
    Next XX2
Label3.Caption = frmMain.ListView1.ColumnHeaders(2).Text

If LANGUAGE = "English" Then
    Me.Caption = "Find..."
    Label1.Caption = "Search for:"
    Check1.Caption = "in category:"
    Command1.Caption = "&Search"
    Command2.Caption = "&Cancel"
    Label2.Caption = "Result:"
    Command3.Caption = "Edit selected item"
End If
If LANGUAGE = "Deutsch" Then
    Me.Caption = "Suchen..."
    Label1.Caption = "Suchen nach:"
    Check1.Caption = "in Kategorie:"
    Command1.Caption = "&Suchen"
    Command2.Caption = "&Abbrechen"
    Label2.Caption = "Ergebnis:"
    Command3.Caption = "Ausgewählten Eintrag bearbeiten"
End If
End Sub

Private Sub Form_Load()
Me.Height = 1350
Center Me

AddToCombo Combo1
Combo1.Text = frmMain.Combo1.Text
Label3.Caption = frmMain.ListView1.ColumnHeaders(2).Text
End Sub


