Attribute VB_Name = "frmOptions"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Combo1_Change()

End Sub

Private Sub Combo1_Click()
If Combo1.Text = "Deutsch" Then MsgBox "New language after restart!", , "Info"
If Combo1.Text = "English" Then MsgBox "Neue Sprache nach Neustart!", , "Info"
End Sub

Private Sub Command1_Click()
LANGUAGE = Combo1.Text
COLOR = Combo2.ListIndex

If COLOR = 0 Then Me.BackColor = &H8000000F
If COLOR = 1 Then Me.BackColor = &HC0FFC0
If COLOR = 2 Then Me.BackColor = &HFFC0C0
If COLOR = 3 Then Me.BackColor = &HC0FFFF

If COLOR = 0 Then frmMain.BackColor = &H8000000F
If COLOR = 1 Then frmMain.BackColor = &HC0FFC0
If COLOR = 2 Then frmMain.BackColor = &HFFC0C0
If COLOR = 3 Then frmMain.BackColor = &HC0FFFF


'frmMain.BackColor = COLOR
'Me.BackColor = COLOR

Optionenspeichern
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub



Private Sub Form_Activate()
Combo1.Text = LANGUAGE

If LANGUAGE = "English" Then
    If COLOR = 0 Then Combo2.Text = "Default"
    If COLOR = 1 Then Combo2.Text = "Green"
    If COLOR = 2 Then Combo2.Text = "Blue"
    If COLOR = 3 Then Combo2.Text = "Yellow"
End If
If LANGUAGE = "Deutsch" Then
    If COLOR = 0 Then Combo2.Text = "Standard"
    If COLOR = 1 Then Combo2.Text = "Grün"
    If COLOR = 2 Then Combo2.Text = "Blau"
    If COLOR = 3 Then Combo2.Text = "Gelb"
End If



If COLOR = 0 Then Me.BackColor = &H8000000F
If COLOR = 1 Then Me.BackColor = &HC0FFC0
If COLOR = 2 Then Me.BackColor = &HFFC0C0
If COLOR = 3 Then Me.BackColor = &HC0FFFF

End Sub

Private Sub Form_Load()
Center Me
Combo1.AddItem "English"
Combo1.AddItem "Deutsch"

If LANGUAGE = "English" Then
    Me.Caption = "Options"
    Label3.Caption = "Language:"
    Command1.Caption = "&Apply"
    Command2.Caption = "&Close"
    Label1.Caption = "Color:"
    Combo2.AddItem "Default"
    Combo2.AddItem "Green"
    Combo2.AddItem "Blue"
    Combo2.AddItem "Yellow"
    
End If
If LANGUAGE = "Deutsch" Then
    Me.Caption = "Optionen"
    Label3.Caption = "Sprache:"
    Command1.Caption = "&Übernehmen"
    Command2.Caption = "&Schließen"
    Label1.Caption = "Farbe:"
    Combo2.AddItem "Standard"
    Combo2.AddItem "Grün"
    Combo2.AddItem "Blau"
    Combo2.AddItem "Gelb"
End If
End Sub
