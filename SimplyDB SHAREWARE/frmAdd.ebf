Attribute VB_Name = "frmAdd"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Combo1_Change()

End Sub

Private Sub Command1_Click()
If Entry1.Text = "" Or Entry2.Text = "" Or Combo1.Text = "" Then
    If LANGUAGE = "English" Then MsgBox ("Please fill in the textboxes!"), vbOKOnly, "Info"
    If LANGUAGE = "Deutsch" Then MsgBox ("Bitte füllen Sie alle Felder aus!"), vbOKOnly, "Info"
    Exit Sub
End If

If Zaehler > 4 Then
If LANGUAGE = "English" Then MsgBox "Only 5 entries possible in this version!" & vbCrLf & vbCrLf & _
"Please contact us: info@kilotec.de!", vbOKOnly, ""

If LANGUAGE = "Deutsch" Then MsgBox "Nur 5 Einträge möglich (SHAREWARE)!" & vbCrLf & vbCrLf & _
"Bitte schreiben Sie uns: info@kilotec.de!", vbOKOnly, ""
Exit Sub
End If

AbInDieDatenbank
EinlesenEintraege

Entry1.Text = ""
Entry2.Text = ""
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Center Me
Combo1.Clear
AddToCombo Combo1
Entry1.Text = ""
Entry2.Text = ""

Label1.Caption = frmMain.ListView1.ColumnHeaders(2).Text
Label2.Caption = frmMain.ListView1.ColumnHeaders(3).Text

If LANGUAGE = "English" Then
    Me.Caption = "Add item"
    Label3.Caption = "Category:"
    Command2.Caption = "&Close"
End If
If LANGUAGE = "Deutsch" Then
    Me.Caption = "Eintrag hinzufügen"
    Label3.Caption = "Kategorie:"
    Command2.Caption = "&Schließen"
End If

If COLOR = 0 Then Me.BackColor = &H8000000F
If COLOR = 1 Then Me.BackColor = &HC0FFC0
If COLOR = 2 Then Me.BackColor = &HFFC0C0
If COLOR = 3 Then Me.BackColor = &HC0FFFF
End Sub

Private Sub Form_Load()
Center Me
AddToCombo Combo1
End Sub

Private Sub Question_Change()

End Sub
