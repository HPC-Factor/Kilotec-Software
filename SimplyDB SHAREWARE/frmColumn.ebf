Attribute VB_Name = "frmColumn"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
NeueColumns
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Center Me

Kategorie.Caption = frmMain.Combo1.Text
Column1.Text = frmMain.ListView1.ColumnHeaders(2).Text
Column2.Text = frmMain.ListView1.ColumnHeaders(3).Text

If LANGUAGE = "English" Then
    Me.Caption = "Edit column headers"
    Command2.Caption = "&Close"
    Label3.Caption = "Category:"
    Label1.Caption = "Column #1:"
    Label4.Caption = "Column #2:"

End If
If LANGUAGE = "Deutsch" Then
    Me.Caption = "Spaltentitel ‰ndern"
    Command2.Caption = "&Schlieﬂen"
    Label3.Caption = "Kategorie:"
    Label1.Caption = "Titel #1:"
    Label4.Caption = "Titel #2:"
End If
If COLOR = 0 Then Me.BackColor = &H8000000F
If COLOR = 1 Then Me.BackColor = &HC0FFC0
If COLOR = 2 Then Me.BackColor = &HFFC0C0
If COLOR = 3 Then Me.BackColor = &HC0FFFF
End Sub

Private Sub Form_Load()
Center Me

Kategorie.Caption = frmMain.Combo1.Text
Column1.Text = frmMain.ListView1.ColumnHeaders(2).Text
Column2.Text = frmMain.ListView1.ColumnHeaders(3).Text

End Sub
