Attribute VB_Name = "frmWork"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
'Option Explicit

Private Sub Command1_Click()
DBbearbeiten
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Command3_Click()
If CDbl(Text4.Text) < Zaehler - 1 Then IndexX = IndexX + 1
Aktualisieren
End Sub

Private Sub Command4_Click()
If IndexX > 0 Then IndexX = IndexX - 1
Aktualisieren

End Sub

Private Sub Command5_Click()
IndexX = Zaehler - 1
Aktualisieren
End Sub

Private Sub Command6_Click()
IndexX = 0
Aktualisieren
End Sub

Private Sub Command7_Click()
a = MsgBox("Do you want to delete the current entry?", vbYesNo, "Info")
If a = vbYes Then
LoescheEintrag
ReplaceIndex = IndexX
'frmMain.Command9.Enabled = True
Me.Hide
End If
End Sub

Private Sub Form_Activate()
Center Me
Aktualisieren
End Sub

Private Sub Form_Load()
AddToCombo Combo1
'Combo1.Text = KategorieIndex & " " & Kategorie
Aktualisieren
End Sub
Private Sub Aktualisieren()
Combo1.Text = DBdaten(0, IndexX) & " " & DBdaten(1, IndexX)
Question.Text = DBdaten(2, IndexX)
Answer.Text = DBdaten(3, IndexX)
Text4.Text = IndexX
ReplaceIndex = IndexX

End Sub
