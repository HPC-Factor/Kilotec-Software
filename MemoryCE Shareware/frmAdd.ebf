Private Sub Combo1_Change()

End Sub

Private Sub Command1_Click()
If Question.Text = "" Or Answer.Text = "" Then
    MsgBox ("Please fill in the textboxes!"), vbOKOnly, "Info"
    Exit Sub
End If

If Zaehler > 9 Then
MsgBox "Only 10 entries possible in this version!" & vbCrLf & vbCrLf & _
"Please contact us: info@kilotec.de!", vbOKOnly, ""
Exit Sub
End If

AbInDieDatenbank
EinlesenEintraege

Question.Text = ""
Answer.Text = ""
End Sub

Private Sub Command2_Click()
