Private Sub Form_Load()
Label1.Caption = "The infinite clipboard" & vbCrLf & _
 "You can use an almost infinite number of additional Windows clipboards by creating" & vbCrLf & _
 "additional clipboards in which to store your texts."
 

End Sub

