Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit


Private Sub CommandBar1_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)
 InvokeAction CInt(Button.Tag), True
End Sub
Private Sub CommandBar1_MenuClick(ByVal Item As CommandbarLib.Item)
    ' alternative way to identify a menu item:  use the index and
    ' parent index to identify the item.  See Constants.bas
    InvokeAction (Item.Index + (100 * Item.Parent.Index)), False
    
End Sub

Private Sub Form_Load()
Dim mnuMain As CommandbarLib.CommandBarMenuBar
Dim mnuFile As CommandbarLib.Item
Dim mnuStorage As CommandbarLib.Item
Dim mnuInfo As CommandbarLib.Item

CommandBar1.Width = Me.Width

Set mnuMain = CommandBar1.Controls.Add(cbrMenuBar, "MainMenu")
    'add File menu items
    ' add the file menu to the command bar
    Set mnuFile = mnuMain.Items.Add(1, , "&File")
    mnuFile.SubItems.Add 1, , "E&xit"
    
    Set mnuStorage = mnuMain.Items.Add(2, , "&Storage")
    mnuStorage.SubItems.Add 1, , "&Create new storage"
    mnuStorage.SubItems.Add 2, , "&Delete storage"
    mnuStorage.SubItems.Add 3, "", "", cbrMenuSeparator
    mnuStorage.SubItems.Add 4, , "Delete all"
    
    Set mnuInfo = mnuMain.Items.Add(3, , "&Info")
    mnuInfo.SubItems.Add 1, , "Info"
    mnuInfo.SubItems.Add 2, , "&Help"
    
    'mnuStorage.SubItems(2).Enabled = False

' set up the imagelist for the toolbar buttons
ImageList1.Add App.Path & "\Bar.bmp"
' tell the commandbar where to pick the button images up
    CommandBar1.ImageList = ImageList1.hImageList
    
If Me.Width >= SIZE_SUPPORTSBUTTONS Then
    
        Dim Button As CommandbarLib.CommandBarButton
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "sep0")
        Button.Style = cbrSeparator
         
        Set Button = CommandBar1.Controls.Add(cbrButton, "new")
        'Button.Style = cbrButtonGroup
        Button.Image = 0
        Button.Tag = ID_NEW
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "delete")
        'Button.Style = cbrButtonGroup
        Button.Image = 1
        Button.Tag = ID_DELETE
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "sep1")
        Button.Style = cbrSeparator
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "deleteall")
        'Button.Style = cbrButtonGroup
        Button.Image = 2
        Button.Tag = ID_DELETEALL
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "sep2")
        Button.Style = cbrSeparator
               
        Set Button = CommandBar1.Controls.Add(cbrButton, "help")
        'Button.Style = cbrButtonGroup
        Button.Image = 3
        Button.Tag = ID_HELP
            
        Set Button = CommandBar1.Controls.Add(cbrButton, "info")
        'Button.Style = cbrButtonGroup
        Button.Image = 4
        Button.Tag = ID_INFO
 
    End If
    
    'lstBoards.AddItem "", lstBoards.ListIndex + 1
    'lstBoards.Selected(lstBoards.ListIndex + 1) = True
    'txtBoard.Text = ""

End Sub

Private Sub InvokeAction(ID As Integer, FromButton As Boolean)

  
    
    Select Case (ID)
          
    Case ID_EXIT        ' terminate the app
        App.End
        
    Case ID_NEW        ' thin brush mode
       Call NewBoard
 
     
    
    Case ID_DELETE       ' thick brush mode
    Call DeleteBoard
       
        
    Case ID_DELETEALL       ' eraser tool
     Call DeleteAll
    
    Case ID_HELP     ' point tool
       frmHelp.Show
        
    Case ID_INFO         ' pen tool
        frmInfo.Show
    
   
    Case Else
        ' programming error -- undefined tool
        MsgBox "Undefined Commandbar Command!"
    End Select
    
    ' update the statusbar with the current help
    'StatusbarUpdate

End Sub

Private Sub lstBoards_Click()
 txtBoard.Text = lstBoards.List(lstBoards.ListIndex)
    txtBoard.SetFocus
    Label3.Caption = lstBoards.ListIndex
       Clipboard.Clear
    Clipboard.SetText txtBoard.Text
End Sub

Private Sub txtBoard_Change()
   ' Inhalt des Textfeldes in den selektierten Eintrag der
    ' Liste schreiben.
    'lstBoards.List(lstBoards.ListIndex) = txtBoard.Text
    lstBoards.List(Label3.Caption) = txtBoard.Text

    On Error Resume Next

    Clipboard.Clear
    Clipboard.SetText txtBoard.Text
End Sub


Private Sub NewBoard()
    lstBoards.AddItem "", lstBoards.ListIndex + 1
    lstBoards.Selected(lstBoards.ListIndex + 1) = True
    txtBoard.Text = ""
    'cmdDelete.Enabled = True
End Sub

Private Sub DeleteBoard()
    Dim intLI As Integer

    On Error Resume Next
    
    intLI = lstBoards.ListIndex
    lstBoards.RemoveItem lstBoards.ListIndex

    ' War das der letzte Eintrag, Löschen-Button deaktivieren,
    ' andernfalls den nächsten Eintrag markieren.
    If lstBoards.ListCount = 0 Then
        'cmdDelete.Enabled = False
    Else
        If intLI < lstBoards.ListCount Then
            lstBoards.Selected(intLI) = True
        Else
            lstBoards.Selected(intLI - 1) = True
        End If
    End If

    txtBoard.Text = lstBoards.List(intLI + 1)
End Sub
Private Sub DeleteAll()
If MsgBox("Clear all caches?" & vbCrLf & "The content will be irretrievably lost", vbQuestion + vbYesNo, "Clear all") = vbYes Then
            ' Zwischenspeicher löschen.
            lstBoards.Clear
            txtBoard.Text = ""
            lstBoards.SetFocus
            'cmdDelete.Enabled = False
        End If
End Sub
