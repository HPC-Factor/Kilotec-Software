[Version]
Signature="$Chicago$"
CESignature="$Windows CE$"
Provider=%CompanyName%

[SourceDisksNames]
1=,"Application Files",, App

[DefaultInstall]
CopyFiles=Files.App, Files.Windows
CEShortcuts=Shortcuts

[Shortcuts]
%AppName%,0,"SuperClipboard.vb"

[CEStrings]
InstallDir=%CE1%\%AppName%
AppName="SuperClipboard"

[Strings]
CompanyName="Kilotec"

[DestinationDirs]
Shortcuts=,%CE11%
Files.App=,%InstallDir%
Files.Windows=,%CE2%
Files.Mips 4000 (1K) v2.10=,%CE2%
Files.SH 4 (4K) v2.10=,%CE2%
Files.Arm 1100 (4K) v2.10=,%CE2%
Files.SH 3 (1K) v2.10=,%CE2%

[SourceDisksFiles]
