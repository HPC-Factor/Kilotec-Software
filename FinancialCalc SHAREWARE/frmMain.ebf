Private Sub Command11_Click()
On Error Resume Next

Dim a
Dim b
Dim c

a = CDbl(S2.Text) * 12 * CDbl(S6.Text)

SS1.Text = FormatCurrency((CDbl(S2.Text) * 12) * CDbl(S6.Text), 2)

Dim rategesamt
Dim finalvalue
Dim q
Dim monate
Dim zm
Dim zj
Dim einmal

On Error Resume Next
If S4.Text = "" And S5.Text = "" Then zj = CDbl(S3.Text)
If S4.Text = "" And S5.Text <> "" Then zj = CDbl(S3.Text) - CDbl(S5.Text)
If S4.Text <> "" And S5.Text = "" Then zj = CDbl(S3.Text) - CDbl(S4.Text)
If S4.Text <> "" And S5.Text <> "" Then zj = CDbl(S3.Text) - CDbl(S5.Text) - CDbl(S4.Text)


monate = CDbl(S6.Text) * 12
zm = 100 * (1 + zj / 100 ^ 1 / 12 - 1)
If S1.Text <> "" Then einmal = CDbl(S1.Text) * (1 + (zj / 100)) ^ (monate / 12)


q = 1 + (zm / 100)
rategesamt = CDbl(S2.Text) * q * (q ^ monate - 1) / (q - 1) + einmal



finalvalue = rategesamt

'SS2.Text = FormatCurrency(finalvalue, 2)
b = finalvalue
SS3.Text = FormatCurrency(b - a, 2)
End Sub

