Private Sub Command3_Click()
P3.Text = ""

On Error Resume Next

If CDbl(Wert1.Text) < CDbl(Wert2.Text) Then
    P3.Text = ((Wert2.Text / Wert1.Text) - 1) * 100 & " %"
End If
If CDbl(Wert1.Text) > CDbl(Wert2.Text) Then
    P3.Text = ((Wert2.Text / Wert1.Text) - 1) * 100 & " %"
End If
End Sub

Private Sub Command4_Click()
On Error Resume Next
If Combo1.Text = "-" Then
    W4.Text = G4.Text * ((100 - P4.Text) / 100)
End If
If Combo1.Text = "+" Then
    W4.Text = G4.Text * ((100 + P4.Text) / 100)
End If
End Sub

Private Sub Command5_Click()
On Error Resume Next
 
 Dim periodic
 
    Dim Rate
    Dim UntermStrich
    Dim UeberStrich
    
   m_LoanAmount = txtLoanAmount.Text
    m_Rate = txtRate.Text
    m_LengthQuant = txtLength.Text
    m_LengthVal = cboLength2.Text
    m_Frequency = cboFrequency.Text

    If m_Frequency = "Monthly" Then
        If m_LengthVal = "Years" Then
            m_LengthQuant = m_LengthQuant * 12
        End If
        m_Rate = (m_Rate / 100) / 12
    Else
        If m_LengthVal = "Months" And m_LengthQuant < 12 Then
            MsgBox ("Error in calculating this."), vbOKOnly, "Error"
            Exit Sub
        Else
            m_LengthQuant = m_LengthQuant / 12
        End If
        m_Rate = m_Rate / 100
    End If
    'm_PaymentAmount = m_oFinanceObject.Pmt(m_Rate, m_LengthQuant, -m_LoanAmount)
    
    UeberStrich = m_Rate * (1 + m_Rate) ^ m_LengthQuant * m_LoanAmount
    UntermStrich = ((1 + m_Rate) ^ m_LengthQuant) - 1
    m_PaymentAmount = UeberStrich / UntermStrich
    lblPaymentAmount.Text = FormatCurrency(m_PaymentAmount, 2)
    TotalAmount.Text = FormatCurrency(m_PaymentAmount * m_LengthQuant, 2)
End Sub

