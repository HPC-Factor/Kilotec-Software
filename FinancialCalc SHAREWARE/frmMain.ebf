NPVValue = NPVValue + CashFlowValue(i) / (1 + (CDbl(Text15.Text) / 100)) ^ i
Next i

zinssatz = -50

'Do While CashFlowValue(0) + IRRValue > -10
'zinssatz = zinssatz + 1

'For i = 1 To cfzaehler
'IRRValue = IRRValue + CashFlowValue(i) / (1 + (zinssatz) / 100) ^ i
'Next i


'Loop

'IRR.Text = zinssatz 'Left(CashFlowValue(0) + IRRValue, 5) & " %"
NPV.Text = FormatCurrency(CashFlowValue(0) + NPVValue, 2)
End Sub

