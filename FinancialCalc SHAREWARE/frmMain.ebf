Private Sub Form_Load()
    
    
    Dim mnuMain As CommandbarLib.CommandBarMenuBar
    Dim mnuFile As CommandbarLib.Item
    Dim mnuCalc As CommandbarLib.Item
    Dim mnuCalc2 As CommandbarLib.Item
    
    Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
    'add File menu items
    Set mnuFile = mnuMain.Items.Add(1, "File", "&File")
    
    mnuFile.SubItems.Add , "About", "&About"
    mnuFile.SubItems.Add , "", "", cbrMenuSeparator
    mnuFile.SubItems.Add , "Exit", "E&xit"
    
    Set mnuCalc = mnuMain.Items.Add(2, , "&Private")
    mnuCalc.SubItems.Add , "PercCalc", "&Percentage"
    mnuCalc.SubItems.Add , "LoanCalc", "&Loan Calc"
    mnuCalc.SubItems.Add , "", "", cbrMenuSeparator
    mnuCalc.SubItems.Add , "SavingsCalc", "S&avings Calc"
    
    Set mnuCalc2 = mnuMain.Items.Add(2, , "&Business")
    mnuCalc2.SubItems.Add , "SaleCalc", "&Sale Calc"
    mnuCalc2.SubItems.Add , "NPVCalc", "&NPV Calc"
    mnuCalc2.SubItems.Add , "HPRCalc", "&HPR Calc"
    
    
    Combo1.AddItem "-"
    Combo1.AddItem "+"
    
    cboFrequency.AddItem "Monthly"
    cboFrequency.AddItem "Annually"
    cboLength2.AddItem "Months"
    cboLength2.AddItem "Years"
    
    Overview.Visible = True
    'Set m_oFinanceObject = CreateObject("pVBFinFunc.pVBFinFunc")
    
    'Combo3.AddItem "%"
    'Combo3.AddItem "Amount"
    'Combo3.AddItem "Net factor"
    'Combo3.AddItem "Gross factor"
End Sub






