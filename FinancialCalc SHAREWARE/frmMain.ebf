Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
'Option Explicit

Private m_LoanAmount
Private m_Rate
Private m_LengthQuant
Private m_LengthVal
Private m_Frequency
Private m_PaymentAmount
Private m_BalloonAmount
Private m_oFinanceObject

Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
 Select Case Item.Key
  'Case "New"
    'NewGame
    Case "About"
        frmInfo.Show
    Case "Exit"
        App.End
    
    Case "PercCalc"
        PercentageCalculator.Visible = True
        SalePriceCalculator.Visible = False
        LoanCalculator.Visible = False
        SavingsPlanCalculator.Visible = False
        NPVCalculator.Visible = False
        HPRCalculator.Visible = False
        PercentageCalculator.Top = 480
        PercentageCalculator.Left = 120
    Case "SaleCalc"
        PercentageCalculator.Visible = False
        SalePriceCalculator.Visible = True
        LoanCalculator.Visible = False
        SavingsPlanCalculator.Visible = False
        NPVCalculator.Visible = False
        HPRCalculator.Visible = False
        SalePriceCalculator.Top = 480
        SalePriceCalculator.Left = 120
    Case "LoanCalc"
