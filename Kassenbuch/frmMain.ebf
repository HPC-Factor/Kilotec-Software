Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub cmdBar_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)

Select Case Button.Key
    Case "open"
        'CommonDialog1.ShowOpen
        'On Error Resume Next
        'CommonDialog1.Filter = "*.txt"
        'ReadFile CommonDialog1.FileName
    
    Case "save"
        DBspeichern
        MsgBox "Kassenbuch gespeichert!", vbOKOnly, "Info"

        
    Case "newK"
        frmKonto.Show
    Case "newV"
        frmZweck.Show
        
    Case "new"
        frmAdd.Show
    Case "edit"
        If ListView1.ListItems.Count > 0 Then
            IndexX = Int(ListView1.SelectedItem.SubItems(1))
            frmEdit.Show
        End If
    Case "delete"
        Dim a As Integer
        a = MsgBox("Möchten Sie die Buchung wirklich löschen?", vbYesNo, "Info")
        If a = vbYes Then
        On Error Resume Next
            LoescheEintrag
            ReplaceIndex = IndexX
            Exit Sub
        End If
    
    Case "overview"
        frmOverview.Show
    
    Case "search"
        frmSuchen.Show
    
    Case "info"
        frmAbout.Show
  
  End Select

End Sub
Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
 Select Case Item.Key

    Case "save"
        DBspeichern
        MsgBox "Kassenbuch gespeichert!", vbOKOnly, "Info"
    
    Case "Exit"
        App.End
        
    
    
    Case "newK"
        frmKonto.Show
    Case "newV"
        frmZweck.Show
        
    Case "new"
        frmAdd.Show
    Case "edit"
        If ListView1.ListItems.Count > 0 Then
            IndexX = Int(ListView1.SelectedItem.SubItems(1))
            frmEdit.Show
        End If
    Case "delete"
        Dim a As Integer
        a = MsgBox("Möchten Sie die Buchung wirklich löschen?", vbYesNo, "Info")
        If a = vbYes Then
        On Error Resume Next
            LoescheEintrag
            ReplaceIndex = IndexX
            Exit Sub
        End If
    
    Case "overview"
        frmOverview.Show
    
    Case "search"
        frmSuchen.Show
    
    Case "info"
        frmAbout.Show
    
    End Select
End Sub



Private Sub Combo1_Click()
On Error Resume Next
KategorieIndex = Combo1.List(Combo1.ListIndex)
SaveSetting App.Title, "Settings", "Combo1", Combo1.List(Combo1.ListIndex)
EinlesenEintraege
End Sub



Private Sub Form_Load()
Center Me

cmdBar.Left = 0
cmdBar.Top = 0
cmdBar.Width = Me.Width

ImageList1.Add App.Path & "\CommandBar.bmp"
cmdBar.ImageList = ImageList1.hImageList

Dim mnuMain As CommandbarLib.CommandBarMenuBar
Dim mnuFile As CommandbarLib.Item
Dim mnuEdit As CommandbarLib.Item
Dim mnuKategorie As CommandbarLib.Item
Dim mnuExtras As CommandbarLib.Item
Dim mnuInfo As CommandbarLib.Item
   
    Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
    Set mnuFile = mnuMain.Items.Add(1, , "&Datei")
    mnuFile.SubItems.Add , "open", "&Öffnen"
    mnuFile.SubItems.Add , "save", "&Speichern"
    mnuFile.SubItems.Add , , "", cbrMenuSeparator
    mnuFile.SubItems.Add , "Exit", "E&xit"
    
    Set mnuKategorie = mnuMain.Items.Add(2, , "&Konto")
    mnuKategorie.SubItems.Add , "newK", "Konten bearbeiten"
    mnuKategorie.SubItems.Add , "newV", "Verwendungszweck bearbeiten"
    
    Set mnuEdit = mnuMain.Items.Add(3, , "&Buchung")
    mnuEdit.SubItems.Add , "new", "&Neue Buchung"
    mnuEdit.SubItems.Add , "edit", "&Buchung editieren"
    mnuEdit.SubItems.Add , , "", cbrMenuSeparator
    mnuEdit.SubItems.Add , "delete", "Buchung &löschen"

    Set mnuExtras = mnuMain.Items.Add(4, , "&Extras")
    mnuExtras.SubItems.Add , "overview", "&Berichte"
    mnuExtras.SubItems.Add , , "", cbrMenuSeparator
    mnuExtras.SubItems.Add , "search", "&Suchen"
    
    Set mnuInfo = mnuMain.Items.Add(5, , "&?")
    mnuInfo.SubItems.Add , "info", "&Über"
    
    'Set mnuSearch = mnuMain.Items.Add(4, , "&Find")
    'mnuSearch.SubItems.Add 1, , "&Find item"
    

If Me.Width >= SIZE_SUPPORTSBUTTONS Then
    
        Dim Button As CommandbarLib.CommandBarButton
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep0")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "open")
        Button.Image = 0
        Button.Tag = "open"
        Set Button = cmdBar.Controls.Add(cbrButton, "save")
        Button.Image = 1
        Button.Tag = "save"
        Set Button = cmdBar.Controls.Add(cbrButton, "sep1")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "newK")
        Button.Image = 5
        Button.Tag = "newK"
        Set Button = cmdBar.Controls.Add(cbrButton, "newV")
        Button.Image = 8
        Button.Tag = "newV"
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep2")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "new")
        Button.Image = 2
        Button.Tag = "new"
        Set Button = cmdBar.Controls.Add(cbrButton, "edit")
        Button.Image = 3
        Button.Tag = "edit"
        Set Button = cmdBar.Controls.Add(cbrButton, "delete")
        Button.Image = 4
        Button.Tag = "delete"
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep3")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "overview")
        Button.Image = 9
        Button.Tag = "overview"
        Set Button = cmdBar.Controls.Add(cbrButton, "search")
        Button.Image = 6
        Button.Tag = "search"

 
    End If














AddToCombo Combo1
Combo1.Text = GetSetting(App.Title, "Settings", "Combo1", Combo1.List(Combo1.ListIndex(0)))
KategorieIndex = Combo1.Text

DBladen
EinlesenEintraege
End Sub


Private Sub ListView1_AfterLabelEdit(Cancel As Boolean, ByVal NewString As String)

End Sub

Private Sub ListView1_ColumnClick(ByVal Index As Long)
On Error Resume Next

ListView1.SortKey = Index - 1
ListView1.Sorted = True

If ListView1.SortOrder = lvwDescending Then
    ListView1.SortOrder = lvwAscending
    Else
    ListView1.SortOrder = lvwDescending
    End If
ListView1.Sorted = False

End Sub
