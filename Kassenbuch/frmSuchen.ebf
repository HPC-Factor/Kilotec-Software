Attribute VB_Name = "frmSuchen"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()

If Text1.Text = Empty Then
Exit Sub
Else
Suchen
End If
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Command3_Click()
On Error Resume Next
If ListView1.ListItems.Count > 0 Then
IndexX = ListView1.SelectedItem.SubItems(1)
frmEdit.Show
End If
End Sub

Private Sub Form_Activate()


Text1.Text = ""
Check1.Value = False

Me.Height = 1965

Center Me

Combo1.Text = frmMain.Combo1.Text


End Sub

Private Sub Form_Load()
Me.Height = 1965
Center Me

AddToCombo Combo1
Combo1.Text = frmMain.Combo1.Text

Combo2.AddItem "Buchungsnummer"
Combo2.AddItem "Datum"
Combo2.AddItem "Verwendungszweck"
Combo2.AddItem "Einzahlungen"
Combo2.AddItem "Auszahlungen"
Combo2.Text = "Buchungsnummer"



End Sub

