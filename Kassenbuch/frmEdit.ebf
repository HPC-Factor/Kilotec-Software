Attribute VB_Name = "frmEdit"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
frmKonto.Show
Combo1.Clear

End Sub

Private Sub Command2_Click()
Me.Hide
End Sub



Private Sub cmdFirst_Click()
IndexX = 0
cmdFirst.Enabled = False
cmdLast.Enabled = True
cmdNext.Enabled = True
Aktualisieren
End Sub

Private Sub cmdLast_Click()
IndexX = Zaehler - 1
cmdLast.Enabled = False
cmdFirst.Enabled = True
cmdPrev.Enabled = True
Aktualisieren
End Sub

Private Sub cmdNext_Click()
If IndexX < Zaehler - 1 Then IndexX = IndexX + 1
cmdPrev.Enabled = True
cmdFirst.Enabled = True

Aktualisieren
End Sub

Private Sub cmdPrev_Click()
If IndexX > 0 Then IndexX = IndexX - 1
cmdNext.Enabled = True
cmdLast.Enabled = True

Aktualisieren
End Sub

Private Sub Command3_Click()
DBbearbeiten
Me.Hide
End Sub

Private Sub Command4_Click()
Me.Hide
End Sub

Private Sub Command5_Click()
frmZweck.Show
cboZweck.Clear

End Sub

Private Sub Form_Activate()
Aktualisieren
Center Me
AddToCombo Combo1
AddToCombo2 cboZweck
End Sub

Private Sub Form_Load()

End Sub

Public Sub Aktualisieren()
If IndexX = 0 Then
    cmdPrev.Enabled = False
    cmdFirst.Enabled = False
    cmdLast.Enabled = True
    cmdNext.Enabled = True
End If
If IndexX = Zaehler - 1 Then
    cmdLast.Enabled = False
    cmdNext.Enabled = False
    cmdFirst.Enabled = True
    cmdPrev.Enabled = True
End If


lblIndex.Caption = IndexX

Combo1.Text = DBdaten(0, IndexX)
txtDatum.Text = DBdaten(1, IndexX)
txtSaldo.Text = DBdaten(2, IndexX)
cboZweck.Text = DBdaten(3, IndexX)
txtEinzahlung.Text = DBdaten(4, IndexX)
txtAuszahlung.Text = DBdaten(5, IndexX)

ReplaceIndex = IndexX
End Sub
