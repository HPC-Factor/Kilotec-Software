Attribute VB_Name = "frmAdd"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit


Private Sub Command1_Click()
If txtEinzahlung.Text = "" And txtAuszahlung.Text = "" And cboZweck.Text = "" Then
    MsgBox "Bitte füllen Sie Ein- oder Auszahlung sowie den Verwendungszweck aus!", vbOKOnly, "Info"
    Exit Sub
End If

AbInDieDatenbank
EinlesenEintraege

txtSaldo.Text = ""
txtEinzahlung.Text = ""
txtAuszahlung.Text = ""
cboZweck.Text = ""



End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Command3_Click()
frmZweck.Show
cboZweck.Clear
End Sub

Private Sub Command4_Click()
frmKonto.Show
Combo1.Clear
End Sub

Private Sub Form_Activate()
Center Me
AddToCombo Combo1
AddToCombo2 cboZweck

txtDatum.Text = Date

End Sub

Private Sub Form_Load()
Center Me

End Sub

