Attribute VB_Name = "frmOverview"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit



Private Sub Check1_Click()
If Check1.Value = 1 Then
    Combo3.Enabled = True
Else
    Combo3.Enabled = False
End If
End Sub

Private Sub Combo3_Change()

End Sub

Private Sub Command1_Click()

Me.Hide
End Sub



Private Sub Command2_Click()
Dim Waehrung As String
Dim Waehrung2 As String
Dim Transaktionen As Integer

Kontostand = 0
Saldo = 0
Einzahlungen = 0
Auszahlungen = 0

lblEinzahlungen.Caption = 0
lblAuszahlungen.Caption = 0
lblKontostand.Caption = 0
lblTransaktionen.Caption = 0

For XX = 0 To Zaehler
    Waehrung = ""
    Waehrung2 = ""
    
    If Option2.Value = True Then
        If DBdaten(0, XX) = Combo1.List(Combo1.ListIndex) Then
            If DBdaten(4, XX) <> "" Then Waehrung = " €"
            If DBdaten(5, XX) <> "" Then Waehrung2 = " €"
            
            Saldo = Int(DBdaten(2, XX))
            If DBdaten(4, XX) <> "" Then
                    Transaktionen = Transaktionen + 1
                  Einzahlungen = Einzahlungen + DBdaten(4, XX)
            Else
                  Einzahlungen = Einzahlungen + 0
            End If
            If DBdaten(5, XX) <> "" Then
            Transaktionen = Transaktionen + 1
                 Auszahlungen = Auszahlungen + DBdaten(5, XX)
            Else
                 Auszahlungen = Auszahlungen + 0
            End If
                
            Kontostand = Saldo + Einzahlungen - Auszahlungen
                
            lblEinzahlungen.Caption = Einzahlungen & Waehrung
            lblAuszahlungen.Caption = Auszahlungen & Waehrung2
            lblKontostand.Caption = Kontostand & " €"
            lblTransaktionen.Caption = Transaktionen
        End If
    End If
    
    If Option1.Value = True Then
        If DBdaten(0, XX) = Combo1.Text And CStr(Year(DBdaten(1, XX))) = Combo3.Text Then
            If DBdaten(4, XX) <> "" Then Waehrung = " €"
            If DBdaten(5, XX) <> "" Then Waehrung2 = " €"
            
            Saldo = Int(DBdaten(2, XX))
            If DBdaten(4, XX) <> "" Then
                    Transaktionen = Transaktionen + 1
                  Einzahlungen = Einzahlungen + DBdaten(4, XX)
            Else
                  Einzahlungen = Einzahlungen + 0
            End If
            If DBdaten(5, XX) <> "" Then
            Transaktionen = Transaktionen + 1
                 Auszahlungen = Auszahlungen + DBdaten(5, XX)
            Else
                 Auszahlungen = Auszahlungen + 0
            End If
                
            Kontostand = Saldo + Einzahlungen - Auszahlungen
                
            lblEinzahlungen.Caption = Einzahlungen & Waehrung
            lblAuszahlungen.Caption = Auszahlungen & Waehrung2
            lblKontostand.Caption = Kontostand & " €"
            lblTransaktionen.Caption = Transaktionen
        End If
    End If
    
     If Option3.Value = True And Check1.Value = 0 Then
        If DBdaten(0, XX) = Combo1.Text And CStr(Month(DBdaten(1, XX))) = CStr(Combo2.ListIndex + 1) Then
            If DBdaten(4, XX) <> "" Then Waehrung = " €"
            If DBdaten(5, XX) <> "" Then Waehrung2 = " €"
            
            Saldo = Int(DBdaten(2, XX))
            If DBdaten(4, XX) <> "" Then
                    Transaktionen = Transaktionen + 1
                  Einzahlungen = Einzahlungen + DBdaten(4, XX)
            Else
                  Einzahlungen = Einzahlungen + 0
            End If
            If DBdaten(5, XX) <> "" Then
            Transaktionen = Transaktionen + 1
                 Auszahlungen = Auszahlungen + DBdaten(5, XX)
            Else
                 Auszahlungen = Auszahlungen + 0
            End If
                
            Kontostand = Saldo + Einzahlungen - Auszahlungen
                
            lblEinzahlungen.Caption = Einzahlungen & Waehrung
            lblAuszahlungen.Caption = Auszahlungen & Waehrung2
            lblKontostand.Caption = Kontostand & " €"
            lblTransaktionen.Caption = Transaktionen
        End If
    End If
    If Option3.Value = True And Check1.Value = 1 Then
        If DBdaten(0, XX) = Combo1.Text And CStr(Month(DBdaten(1, XX))) = CStr(Combo2.ListIndex + 1) And CStr(Year(DBdaten(1, XX))) = Combo3.Text Then
            If DBdaten(4, XX) <> "" Then Waehrung = " €"
            If DBdaten(5, XX) <> "" Then Waehrung2 = " €"
            
            Saldo = Int(DBdaten(2, XX))
            If DBdaten(4, XX) <> "" Then
                    Transaktionen = Transaktionen + 1
                  Einzahlungen = Einzahlungen + DBdaten(4, XX)
            Else
                  Einzahlungen = Einzahlungen + 0
            End If
            If DBdaten(5, XX) <> "" Then
            Transaktionen = Transaktionen + 1
                 Auszahlungen = Auszahlungen + DBdaten(5, XX)
            Else
                 Auszahlungen = Auszahlungen + 0
            End If
                
            Kontostand = Saldo + Einzahlungen - Auszahlungen
                
            lblEinzahlungen.Caption = Einzahlungen & Waehrung
            lblAuszahlungen.Caption = Auszahlungen & Waehrung2
            lblKontostand.Caption = Kontostand & " €"
            lblTransaktionen.Caption = Transaktionen
        End If
    End If
    
    
    
    
Next XX
End Sub







Private Sub Form_Activate()

lblEinzahlungen.Caption = 0
lblAuszahlungen.Caption = 0
lblKontostand.Caption = 0
lblTransaktionen.Caption = 0
Combo1.Text = ""

Combo2.Enabled = False
Combo3.Enabled = False

Option2.Value = True
End Sub

Private Sub Form_Load()
Center Me
AddToCombo Combo1

Combo2.Clear
Combo2.AddItem "Januar"
Combo2.AddItem "Februar"
Combo2.AddItem "März"
Combo2.AddItem "April"
Combo2.AddItem "Mai"
Combo2.AddItem "Juni"
Combo2.AddItem "Juli"
Combo2.AddItem "August"
Combo2.AddItem "September"
Combo2.AddItem "Oktober"
Combo2.AddItem "November"
Combo2.AddItem "Dezember"

Combo3.Clear
For XX = 0 To Zaehler
    If DBdaten(1, XX) <> Empty Then
        Combo3.AddItem DatePart("yyyy", DBdaten(1, XX))
    End If
Next XX

DeleteDuplicate Combo3

Combo3.Text = Combo3.List(0)
End Sub

Private Sub DeleteDuplicate(liste As Control)
Dim i As Integer
Dim u As Integer

i = 0

While i < liste.ListCount
u = i + 1
    Do Until u > liste.ListCount - 1
        If liste.List(u) = liste.List(i) Then
            liste.RemoveItem u
        Else
            If liste.Sorted Then Exit Do
            u = u + 1
        End If
    Loop
    i = i + 1
Wend

End Sub

Private Sub Frame1_MouseDown(ByVal Button As Integer, ByVal Shift As Integer, ByVal X As Single, ByVal Y As Single)

End Sub

Private Sub Option1_Click()
If Option1.Value = True Then
    Combo2.Enabled = False
    Combo3.Enabled = True
Else
    Combo2.Enabled = True
End If
End Sub

Private Sub Option2_Click()
If Option2.Value = True Then
    Combo2.Enabled = False
    Combo3.Enabled = False
End If
End Sub

Private Sub Option3_Click()
If Option3.Value = True Then
    Combo3.Enabled = False
    Combo2.Enabled = True
Else
    Combo3.Enabled = True
End If
End Sub
