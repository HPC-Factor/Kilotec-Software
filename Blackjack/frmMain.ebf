Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit





Private Sub Check1_Click()
If Check1.Value = 1 Then
    Label3.Visible = True
    Label2.Visible = True
    Playername.Visible = True
    Label4.Visible = True
Else
    Label3.Visible = False
    Label2.Visible = False
    Playername.Visible = False
    Label4.Visible = False
End If
End Sub

Private Sub Check2_Click()
If Check2.Value = 1 Then Sound = True
If Check2.Value = 0 Then Sound = False
End Sub

Private Sub cmdDeal_Click()
NewGame

cmdMinus.Enabled = False
cmdPlus.Enabled = False
cmdDeal.Enabled = False
cmdHit.Enabled = True
cmdStay.Enabled = True

playMode = 0
dealMode = DEALER_FIRST
DealCard
End Sub

Private Sub cmdHit_Click()


dealMode = PLAYER_NEXT
DealCard
Dim playercount As Integer

playercount = countHand(player, nextPlayerCard)
frmMain.Label2.Caption = playercount
processTestCards
End Sub

Private Sub cmdMinus_Click()
PlayWaveFile (App.Path & "\click.wav")

If bet > BET_MIN Then bet = bet - BET_INC
lblBet.Caption = bet
End Sub

Private Sub cmdPlus_Click()
PlayWaveFile (App.Path & "\click.wav")

If bet < BET_MAX Then bet = bet + BET_INC
lblBet.Caption = bet
End Sub

Private Sub cmdStay_Click()


playMode = MODE_NOINPUT
hideDealerCard = False
dealerHit

End Sub







Private Sub Command1_Click()
PlayWaveFile (App.Path & "\click.wav")

frmStat.Show
End Sub

Private Sub Command4_Click()
App.End
End Sub

Private Sub Command5_Click()
PlayWaveFile (App.Path & "\click.wav")
    
    frmMain.cmdDeal.Enabled = True
    frmMain.cmdMinus.Enabled = True
    frmMain.cmdPlus.Enabled = True
    frmMain.cmdHit.Enabled = False
    frmMain.cmdStay.Enabled = False

BANK_INIT = 500
BANK_MAX = 10000
BET_MIN = 10
BET_MAX = 100
BET_INC = 10

bank = BANK_INIT
bet = BET_MIN

lblMoney.Caption = "$ " & Int(bank)
lblBet.Caption = bet

For i = 0 To TOTAL_DECK_CARDS
    deck(i) = i
Next i

nextDealerCard = 0
nextPlayerCard = 0

hideDealerCard = True

ShuffleDeck

DisplayHands


NewGame
End Sub






Private Sub Form_Load()
Sound = True


BANK_INIT = 500
BANK_MAX = 10000
BET_MIN = 10
BET_MAX = 100
BET_INC = 10

bank = BANK_INIT
bet = BET_MIN

lblMoney.Caption = "$ " & Int(bank)
lblBet.Caption = bet

For i = 0 To TOTAL_DECK_CARDS
    deck(i) = i
Next i

nextDealerCard = 0
nextPlayerCard = 0

hideDealerCard = True

ShuffleDeck

DisplayHands

    Dealer1.Top = -100
    Dealer1.Top = 120
    'Dealer1.Picture = App.Path & "\Back.bmp"
    
