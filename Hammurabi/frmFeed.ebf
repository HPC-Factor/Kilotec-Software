Attribute VB_Name = "frmFeed"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
On Error Resume Next
If CDbl(Text1.Text) = Empty Then Text1.Text = "0"

If CDbl(Text1.Text) > S Then
    MsgBox ("You have only " & Int(S) & " bushels!"), vbOKOnly, "Info"
Exit Sub
Else
    If CDbl(Text1.Text) <> Empty Or CDbl(Text1.Text) <> 0 Then
        S = S - CDbl(Text1.Text)
        C = 1
        Q1 = CDbl(Text1.Text)
        frmSeed.Show
        frmFeed.Hide
    Else
        Q1 = CDbl(Text1.Text)
        frmSeed.Show
        frmFeed.Hide
    End If
   
End If
End Sub

Private Sub Form_Activate()
Text1.SetFocus
End Sub

Private Sub Form_Load()
Dim X As Integer
Dim Y As Integer

X = (Screen.Width - Me.Width) / 2
Y = (Screen.Height - Me.Height) / 2

Me.Left = X
Me.Top = Y

Text1.SetFocus
End Sub

