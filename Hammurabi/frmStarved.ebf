Private Sub Command1_Click()
 Me.Hide
  frmSeed.Hide
  frmFeed.Hide
  frmMain.Hide
  frmBuy.Hide
  frmSell.Hide
  frmSplash.Show
End Sub

Private Sub Form_Load()
Dim X As Integer
Dim Y As Integer

X = (Screen.Width - Me.Width) / 2
Y = (Screen.Height - Me.Height) / 2

Me.Left = X
Me.Top = Y

Label1.Caption = "YOU STARVED " & Int(D) & " PEOPLE IN ONE YEAR"

End Sub

