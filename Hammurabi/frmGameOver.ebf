Attribute VB_Name = "frmGameOver"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
Me.Hide
frmSplash.Show

End Sub

Private Sub Form_Load()

Dim sString As String

Dim X As Integer
Dim Y As Integer

Center Me


L = A / P

Label1.Caption = "In your 10-year term of office, " & Int(U) & " percent of the population starved per year on the average, I.E. " & _
"A total of " & Int(D1) & " people died!" & vbCrLf & vbCrLf & _
"You started with 10 acres per person and ended with " & Mid(L, 1, 4) & " acres per person. "

If P1 > 33 Then
    sString = "Due to this extreme mismanagement you have not only been impeached " & _
    "and thrown out of offcie but you have also been declared national fink!!!"
     Label1.Caption = Label1.Caption & sString
Exit Sub
End If


If L < 7 Then
    sString = "Due to this extreme mismanagement you have not only been impeached " & _
    "and thrown out of offcie but you have also been declared national fink!!!"
     Label1.Caption = Label1.Caption & sString
Exit Sub
End If

If P1 > 10 Then
    sString = "Your heavy-handed performance smacks of Nero and Ivan IV. " & _
    "The people (remaining) find you an unpleasant ruler, and Franky, hate your guts!!"
     Label1.Caption = Label1.Caption & sString
Exit Sub
End If

If L < 9 Then
    sString = "Your heavy-handed performance smacks of Nero and Ivan IV. " & _
    "The people (remaining) find you an unpleasant ruler, and Franky, hate your guts!!"
     Label1.Caption = Label1.Caption & sString
Exit Sub
End If

If P1 > 3 Then
    sString = "Your performance could have been somewhat better, but really wans't too " & _
    "bad at all. " & Int(P * 0.8 * (Rnd(1) * 10)) & " people dearly like to see you assassinated " & _
    "but we all have our trivial problems."
     Label1.Caption = Label1.Caption & sString
Exit Sub
End If

sString = "A fantastic performance!!! Charlemagne, Disraeli and Jefferson combined " & _
    "could not have done better! "
    Label1.Caption = Label1.Caption & sString
    Exit Sub

End Sub
