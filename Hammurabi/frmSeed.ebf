Attribute VB_Name = "frmSeed"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
On Error Resume Next
If CDbl(Text1.Text) = Empty Then Text1.Text = "0"

If CDbl(Text1.Text) > A Then
    MsgBox ("You own only " & Int(A) & " acres!"), vbOKOnly, "Info"
    Exit Sub
ElseIf CDbl(Text1.Text) / 2 > S Then
    MsgBox ("You have only " & Int(S) & " bushels!"), vbOKOnly, "Info"
    Exit Sub
ElseIf CDbl(Text1.Text) > (P * 10) Then
    MsgBox ("You only have " & Int(P) & " people to tend the fields!"), vbOKOnly, "Info"
    Exit Sub
Else
    If CDbl(Text1.Text) = Empty Then Text1.Text = "0"
    
    
    If CDbl(Text1.Text) <> 0 Then S = S - (CDbl(Text1.Text / 2))
    C = (Rnd(5) * 10) + 1
    Y2 = C
    H = CDbl(Text1.Text) * Y2
    E = 0
    C = Int((Rnd(5) * 10) + 1)
    If C <> 1 Then
        E = S / C
    End If
    S = S - E + H
    C = Int((Rnd(5) * 10) + 1)
    I = (C * (20 * A + S) / P / 100 + 1)
    C = Q1 / 20
    'Q1 = (Rnd(10) * 10) + 1
    If P < C Then
        D = 0
        Call NewYear
        frmSeed.Hide
        Exit Sub
    End If
    D = P - C
    'If D > P / 2 Then
    If D > 0.45 * P Then
        frmStarved.Show
        Exit Sub
    End If
    U = ((Z - 1) * U + D * 100 / P) / Z
    P = C
    D1 = D1 + D
    T = T + D
    QQ = Int((Rnd(5) * 10) + 1)
    Call NewYear
    frmSeed.Hide
    Exit Sub
End If
   
'End If
End Sub

Private Sub Form_Activate()
Text1.SetFocus
End Sub

Private Sub Form_Load()
Dim X As Integer
Dim Y As Integer

X = (Screen.Width - Me.Width) / 2
Y = (Screen.Height - Me.Height) / 2

Me.Left = X
Me.Top = Y
Text1.SetFocus
End Sub

