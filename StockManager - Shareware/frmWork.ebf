Attribute VB_Name = "frmWork"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
'Option Explicit

Private Sub Command1_Click()
DBbearbeiten
frmMain.Command9.Enabled = True

Me.Hide
End Sub

Private Sub Command2_Click()

Me.Hide
End Sub

Private Sub Command3_Click()
If IndexX < Zaehler - 1 Then IndexX = IndexX + 1
Aktualisieren
End Sub

Private Sub Command4_Click()
If IndexX > 0 Then IndexX = IndexX - 1
Aktualisieren
End Sub

Private Sub Command5_Click()
IndexX = Zaehler - 1
Aktualisieren
End Sub

Private Sub Command6_Click()
IndexX = 0
Aktualisieren
End Sub

Private Sub Command7_Click()
a = MsgBox("Do you want to delete the current investment?", vbYesNo, "Info")

If a = vbYes Then
LoescheEintrag
ReplaceIndex = IndexX
frmMain.Command9.Enabled = True
Me.Hide
End If
End Sub

Private Sub Form_Activate()
Aktualisieren
End Sub

Private Sub Form_Load()
' Fülle Combobox mit Einträgen
    AddToCombo Combo1

Aktualisieren

End Sub
Private Sub Aktualisieren()
Combo1.Text = DBdaten(0, IndexX) & " " & DBdaten(1, IndexX)
Datum.Text = DBdaten(2, IndexX)
Price.Text = DBdaten(3, IndexX)
Text4.Text = IndexX
Shares.Text = DBdaten(4, IndexX)
If DBdaten(5, IndexX) = "Buy" Then Option1.Value = True
If DBdaten(5, IndexX) = "Sell" Then Option2.Value = True
ReplaceIndex = IndexX
End Sub

Private Sub Label6_Click()

End Sub
