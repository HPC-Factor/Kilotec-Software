Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit


Private Sub Command1_Click()
Frame1.Visible = False
Command6.Enabled = True
Command1.Enabled = False
Text1.Text = ""
Text2.Text = ""
Text3.Text = ""
Text4.Text = ""
Text5.Text = ""
End Sub

Private Sub Command2_Click()
App.End

End Sub









Private Sub Command3_Click()
frmHelp.Show
End Sub

Private Sub Command6_Click()
On Error Resume Next
If Text1.Text <> "" And Text2.Text <> "" And Text3.Text <> "" And Text4.Text <> "" And Text5.Text <> "" Then

    Frame1.Visible = True
    Command6.Enabled = False
    Command1.Enabled = True
    
    EPS1.Caption = (Text1.Text * (1 + (Text2.Text / 100)) ^ 1) '/ 100
    EPS2.Caption = (Text1.Text * (1 + (Text2.Text / 100)) ^ 2) '/ 100
    EPS3.Caption = (Text1.Text * (1 + (Text2.Text / 100)) ^ 3) '/ 100
    EPS4.Caption = (Text1.Text * (1 + (Text2.Text / 100)) ^ 4) '/ 100
    EPS5.Caption = (Text1.Text * (1 + (Text2.Text / 100)) ^ 5) '/ 100
    
    Kurs1.Caption = EPS1.Caption * Text3.Text
    Kurs2.Caption = EPS2.Caption * Text3.Text
    Kurs3.Caption = EPS3.Caption * Text3.Text
    Kurs4.Caption = EPS4.Caption * Text3.Text
    Kurs5.Caption = EPS5.Caption * Text3.Text
    
    Wert1.Caption = (Kurs1.Caption / (1 + (Text4.Text / 100)) ^ 1)
    Wert2.Caption = (Kurs2.Caption / (1 + (Text4.Text / 100)) ^ 2)
    Wert3.Caption = (Kurs3.Caption / (1 + (Text4.Text / 100)) ^ 3)
    Wert4.Caption = (Kurs4.Caption / (1 + (Text4.Text / 100)) ^ 4)
    Wert5.Caption = (Kurs5.Caption / (1 + (Text4.Text / 100)) ^ 5)
    
    KK1.Caption = Wert1.Caption * (1 - (Text5.Text / 100))
    KK2.Caption = Wert2.Caption * (1 - (Text5.Text / 100))
    KK3.Caption = Wert3.Caption * (1 - (Text5.Text / 100))
    KK4.Caption = Wert4.Caption * (1 - (Text5.Text / 100))
    KK5.Caption = Wert5.Caption * (1 - (Text5.Text / 100))
End If
End Sub

Private Sub Form_Load()

End Sub
