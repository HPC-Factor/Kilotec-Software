[Version]
Signature="$Chicago$"
CESignature="$Windows CE$"
Provider=%CompanyName%

[SourceDisksNames]
1=,"Application Files",, App

[DefaultInstall]
CopyFiles=Files.App, Files.Windows
CEShortcuts=AddlShortcut

[AddlShortcut]
%AppName%,0,"FWert.exe"

[Shortcuts]
%AppName%,0,"FWert.vb"

[CEStrings]
InstallDir=%CE1%\%AppName%
AppName="FairValue"

[Strings]
CompanyName="Kilotec"

[DestinationDirs]
Shortcuts=,%CE11%
Files.App=,%InstallDir%
Files.Windows=,%CE2%
Files.Mips 4000 (1K) v2.10=,%CE2%
Files.SH 4 (4K) v2.10=,%CE2%
Files.Arm 1100 (4K) v2.10=,%CE2%
Files.SH 3 (1K) v2.10=,%CE2%
AddlShortcut=,%CE11%

[SourceDisksFiles]
FWert.vb=1

[DefaultInstall.Mips 4000 (1K) v2.10]
CopyFiles=Files.Mips 4000 (1K) v2.10
CESelfRegister=vbscript.dll,pvbhost2.dll,pvbform2.dll

[CEDevice.Mips 4000 (1K) v2.10]
ProcessorType=4000

[SourceDisksNames.Mips 4000 (1K) v2.10]
3= ,"Mips 4000 (1K) v2.10 Files",,Mips 4000 (1K) v2.10

[SourceDisksFiles.Mips 4000 (1K) v2.10]
pvbform2.dll=3
pvbhost2.dll=3
vbscript.dll=3
vbsen.dll=3
pvbload.exe=3

[DefaultInstall.SH 4 (4K) v2.10]
CopyFiles=Files.SH 4 (4K) v2.10
CESelfRegister=vbscript.dll,pvbhost2.dll,pvbform2.dll

[CEDevice.SH 4 (4K) v2.10]
ProcessorType=10005

[SourceDisksNames.SH 4 (4K) v2.10]
3= ,"SH 4 (4K) v2.10 Files",,SH 4 (4K) v2.10

[SourceDisksFiles.SH 4 (4K) v2.10]
vbsen.dll=3
pvbform2.dll=3
vbscript.dll=3
pvbhost2.dll=3
pvbload.exe=3

[DefaultInstall.Arm 1100 (4K) v2.10]
CopyFiles=Files.Arm 1100 (4K) v2.10
CESelfRegister=vbscript.dll,pvbhost2.dll,pvbform2.dll

[CEDevice.Arm 1100 (4K) v2.10]
ProcessorType=2577

[SourceDisksNames.Arm 1100 (4K) v2.10]
3= ,"Arm 1100 (4K) v2.10 Files",,Arm 1100 (4K) v2.10

[SourceDisksFiles.Arm 1100 (4K) v2.10]
