Private Sub Form_Activate()
Center Me
DBladen

Option7.Value = False
Option8.Value = False
Option1.Value = False
Option2.Value = False
Option5.Value = False
Option6.Value = False
Font1.Value = False
Font2.Value = False
Font3.Value = False
Font4.Value = False
Font5.Value = False

If BCOLOR = 0 Then Option7.Value = True
If BCOLOR = 1 Then Option8.Value = True

If FCOLOR = 0 Then Option1.Value = True
If FCOLOR = 1 Then Option2.Value = True
If FCOLOR = 2 Then Option5.Value = True
If FCOLOR = 3 Then Option6.Value = True


If FNAME = 0 Then Font1.Value = True
If FNAME = 1 Then Font2.Value = True
If FNAME = 2 Then Font3.Value = True
If FNAME = 3 Then Font4.Value = True
If FNAME = 4 Then Font5.Value = True

Aktualisieren
End Sub

Private Sub Form_Load()
Center Me

End Sub

Public Sub Aktualisieren()
If Option7.Value = True Then BCOLOR = 0
If Option8.Value = True Then BCOLOR = 1

If Option1.Value = True Then FCOLOR = 0
If Option2.Value = True Then FCOLOR = 1
If Option5.Value = True Then FCOLOR = 2
If Option6.Value = True Then FCOLOR = 3

If Font1.Value = True Then FNAME = 0
If Font2.Value = True Then FNAME = 1
If Font3.Value = True Then FNAME = 2
If Font4.Value = True Then FNAME = 3
If Font5.Value = True Then FNAME = 4



If Option7.Value = True Then frmMain.BACKCOLOR = vbWhite
If Option8.Value = True Then frmMain.BACKCOLOR = vbBlack



If Option1.Value = True Then frmMain.Label1.FORECOLOR = vbWhite
If Option2.Value = True Then frmMain.Label1.FORECOLOR = vbBlack
If Option5.Value = True Then frmMain.Label1.FORECOLOR = vbGreen
If Option6.Value = True Then frmMain.Label1.FORECOLOR = vbRed

If Option1.Value = True Then frmMain.Label2.FORECOLOR = vbWhite
If Option2.Value = True Then frmMain.Label2.FORECOLOR = vbBlack
If Option5.Value = True Then frmMain.Label2.FORECOLOR = vbGreen
If Option6.Value = True Then frmMain.Label2.FORECOLOR = vbRed

If Option1.Value = True Then frmMain.Label3.FORECOLOR = vbWhite
If Option2.Value = True Then frmMain.Label3.FORECOLOR = vbBlack
If Option5.Value = True Then frmMain.Label3.FORECOLOR = vbGreen
If Option6.Value = True Then frmMain.Label3.FORECOLOR = vbRed

If Font1.Value = True Then frmMain.Label1.Font.Name = "Tahoma": frmMain.Label1.Font.SIZE = 130: SIZE = 130
If Font2.Value = True Then frmMain.Label1.Font.Name = "The Led Display St": frmMain.Label1.Font.SIZE = 95: SIZE = 95
If Font3.Value = True Then frmMain.Label1.Font.Name = "Dot Matrix": frmMain.Label1.Font.SIZE = 150: SIZE = 150
If Font4.Value = True Then frmMain.Label1.Font.Name = "DS-Digital": frmMain.Label1.Font.SIZE = 150: SIZE = 150
If Font5.Value = True Then frmMain.Label1.Font.Name = "Open 24 Display St": frmMain.Label1.Font.SIZE = 140: SIZE = 140

If Font1.Value = True Then frmMain.Label2.Font.Name = "Tahoma"
If Font2.Value = True Then frmMain.Label2.Font.Name = "The Led Display St"
If Font3.Value = True Then frmMain.Label2.Font.Name = "Dot Matrix"
If Font4.Value = True Then frmMain.Label2.Font.Name = "DS-Digital"
If Font5.Value = True Then frmMain.Label2.Font.Name = "Open 24 Display St"

If Font1.Value = True Then frmMain.Label3.Font.Name = "Tahoma"
If Font2.Value = True Then frmMain.Label3.Font.Name = "The Led Display St"
If Font3.Value = True Then frmMain.Label3.Font.Name = "Dot Matrix"
If Font4.Value = True Then frmMain.Label3.Font.Name = "DS-Digital"
If Font5.Value = True Then frmMain.Label3.Font.Name = "Open 24 Display St"


frmMain.Label1.Font.Italic = False
If FNAME = 0 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 750
If FNAME = 1 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 1100
If FNAME = 2 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 850
If FNAME = 3 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 800
If FNAME = 4 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 550

If FNAME = 0 Then frmMain.Label3.Top = frmMain.Label2.Top - 750
If FNAME = 1 Then frmMain.Label3.Top = frmMain.Label2.Top - 1100
If FNAME = 2 Then frmMain.Label3.Top = frmMain.Label2.Top - 850
If FNAME = 3 Then frmMain.Label3.Top = frmMain.Label2.Top - 800
If FNAME = 4 Then frmMain.Label3.Top = frmMain.Label2.Top - 550

DBspeichern
End Sub

