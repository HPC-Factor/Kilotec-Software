Option Explicit

Private Sub cmdBar_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)

End Sub

Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
InvokeAction (Item.Index + (100 * Item.Parent.Index)), False
End Sub

Private Sub InvokeAction(ID As Integer, FromButton As Boolean)
   Select Case (ID)
    Case ID_EXIT        ' terminate the app
        App.End
    
    Case ID_ABOUT       ' thick brush mode
        frmAbout.Show
   
    Case ID_OPTIONS
        frmOptions.Show
   
    Case Else
        ' programming error -- undefined tool
        MsgBox "Undefined Commandbar Command!"
    End Select
End Sub





Private Sub Form_Load()
Me.Height = Screen.Height
Me.Width = Screen.Width

Label1.Caption = Mid(Time, 1, 5)
Label2.Caption = Date


cmdBar.Left = 0
cmdBar.Top = 0
cmdBar.Width = Me.Width

On Error Resume Next
DBladen

If FCOLOR = Empty Then FCOLOR = 0
If BCOLOR = Empty Then BCOLOR = 1
If SIZE = Empty Then SIZE = 115
If FNAME = Empty Then FONTNAME = 1

If BCOLOR = 0 Then frmMain.BACKCOLOR = vbWhite
If BCOLOR = 1 Then frmMain.BACKCOLOR = vbBlack

If FCOLOR = 0 Then Label1.FORECOLOR = vbWhite
If FCOLOR = 1 Then Label1.FORECOLOR = vbBlack
If FCOLOR = 2 Then Label1.FORECOLOR = vbGreen
If FCOLOR = 3 Then Label1.FORECOLOR = vbRed

If FCOLOR = 0 Then Label2.FORECOLOR = vbWhite
If FCOLOR = 1 Then Label2.FORECOLOR = vbBlack
If FCOLOR = 2 Then Label2.FORECOLOR = vbGreen
If FCOLOR = 3 Then Label2.FORECOLOR = vbRed

If FCOLOR = 0 Then Label3.FORECOLOR = vbWhite
If FCOLOR = 1 Then Label3.FORECOLOR = vbBlack
If FCOLOR = 2 Then Label3.FORECOLOR = vbGreen
If FCOLOR = 3 Then Label3.FORECOLOR = vbRed

'Label1.Font.SIZE = SIZE

If FNAME = 0 Then Label1.Font.Name = "Tahoma"
If FNAME = 1 Then Label1.Font.Name = "The Led Display St"
If FNAME = 2 Then Label1.Font.Name = "Dot Matrix"
If FNAME = 3 Then Label1.Font.Name = "DS-Digital"
If FNAME = 4 Then Label1.Font.Name = "Open 24 Display St"

If FNAME = 0 Then Label2.Font.Name = "Tahoma"
If FNAME = 1 Then Label2.Font.Name = "The Led Display St"
If FNAME = 2 Then Label2.Font.Name = "Dot Matrix"
If FNAME = 3 Then Label2.Font.Name = "DS-Digital"
If FNAME = 4 Then Label2.Font.Name = "Open 24 Display St"

If FNAME = 0 Then Label3.Font.Name = "Tahoma"
If FNAME = 1 Then Label3.Font.Name = "The Led Display St"
If FNAME = 2 Then Label3.Font.Name = "Dot Matrix"
If FNAME = 3 Then Label3.Font.Name = "DS-Digital"
If FNAME = 4 Then Label3.Font.Name = "Open 24 Display St"

Label1.Font.SIZE = SIZE


Dim mnuMain As CommandbarLib.CommandBarMenuBar
Dim mnuFile As CommandbarLib.Item
Dim mnuEdit As CommandbarLib.Item

Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
Set mnuFile = mnuMain.Items.Add(1, , "&File")
mnuFile.SubItems.Add 1, , "&About"
mnuFile.SubItems.Add 2, , "", cbrMenuSeparator
mnuFile.SubItems.Add 3, , "E&xit"
    
Set mnuEdit = mnuMain.Items.Add(2, , "&Options")
mnuEdit.SubItems.Add 1, , "&Options"

If FNAME = 0 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 750
If FNAME = 1 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 1100
If FNAME = 2 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 850
If FNAME = 3 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 800
If FNAME = 4 Then frmMain.Label2.Top = frmMain.Label1.Top + frmMain.Label1.Height - 550

Dim X As Integer
Dim x2 As Integer

Dim Y As Integer

X = (Screen.Width - Label1.Width) / 2
x2 = (Screen.Width - Label2.Width) / 2
Y = (Screen.Height - Label1.Height) / 2

'Label1.Left = X
'Label2.Left = x2
'frmMain.Label1.Height = frmMain.ScaleHeight
'frmMain.Label1.Width = frmMain.ScaleWidth
'Label2.Top = Label1.Top + Label1.Height - 600

If Weekday(Date) = 1 Then Label3.Caption = "Sunday"
If Weekday(Date) = 2 Then Label3.Caption = "Monday"
If Weekday(Date) = 3 Then Label3.Caption = "Tuesday"
If Weekday(Date) = 4 Then Label3.Caption = "Wednesday"
If Weekday(Date) = 5 Then Label3.Caption = "Thursday"
If Weekday(Date) = 6 Then Label3.Caption = "Friday"
If Weekday(Date) = 7 Then Label3.Caption = "Saturday"

If FNAME = 0 Then frmMain.Label3.Top = frmMain.Label2.Top - 750
If FNAME = 1 Then frmMain.Label3.Top = frmMain.Label2.Top - 1100
If FNAME = 2 Then frmMain.Label3.Top = frmMain.Label2.Top - 850
If FNAME = 3 Then frmMain.Label3.Top = frmMain.Label2.Top - 800
If FNAME = 4 Then frmMain.Label3.Top = frmMain.Label2.Top - 550

End Sub

