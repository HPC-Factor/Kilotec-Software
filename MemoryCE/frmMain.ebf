Private Sub Command10_Click()
If IndexX > 0 Then
IndexX = IndexX - 1
EinlesenEintraege2
End If
End Sub

Private Sub Command7_Click()
If IndexX < Zaehler - 1 Then
IndexX = IndexX + 1
EinlesenEintraege2
End If
End Sub


Private Sub Check1_Click()
Spoiler = Check1.Value
KategorieIndex = Mid(Combo1.Text, 1, 2)
Kategorie = Mid(Combo1.List(Combo1.ListIndex), 3, 24)
EinlesenEintraege

End Sub

Private Sub Combo1_Click()
KategorieIndex = Mid(Combo1.List(Combo1.ListIndex), 1, 2)
Kategorie = Mid(Combo1.List(Combo1.ListIndex), 3, 24)
