EinlesenEintraege
End Sub

Private Sub CommandBar1_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)
    InvokeAction CInt(Button.Tag), True
End Sub
Private Sub CommandBar1_MenuClick(ByVal Item As CommandbarLib.Item)
    InvokeAction (Item.Index + (100 * Item.Parent.Index)), False
   
End Sub

Private Sub Form_Load()
Center Me

Dim mnuMain As CommandbarLib.CommandBarMenuBar
Dim mnuFile As CommandbarLib.Item
Dim mnuLearn As CommandbarLib.Item
Dim mnuOptions As CommandbarLib.Item
Dim mnuInfo As CommandbarLib.Item

CommandBar1.Width = Me.Width - 50

Set mnuMain = CommandBar1.Controls.Add(cbrMenuBar, "MainMenu")
    'add File menu items
    ' add the file menu to the command bar
    Set mnuFile = mnuMain.Items.Add(1, , "&File")
    mnuFile.SubItems.Add 1, , "&New entry"
    mnuFile.SubItems.Add 2, , "&Edit entry"
    mnuFile.SubItems.Add 3, , "&Save"
    mnuFile.SubItems.Add 4, , "&Category"
    mnuFile.SubItems.Add 5, "", "", cbrMenuSeparator
    mnuFile.SubItems.Add 6, , "E&xit"
    
    Set mnuLearn = mnuMain.Items.Add(2, , "&Learn")
    mnuLearn.SubItems.Add 1, , "Start learning"
    
    Set mnuOptions = mnuMain.Items.Add(3, , "&Options")
    mnuOptions.SubItems.Add 1, , "Options"
    
    Set mnuInfo = mnuMain.Items.Add(4, , "&Info")
    mnuInfo.SubItems.Add 1, , "&Help"
    mnuInfo.SubItems.Add 2, , "Info"
    
    
' set up the imagelist for the toolbar buttons
ImageList1.Add App.Path & "\Bar.bmp"
' tell the commandbar where to pick the button images up
    CommandBar1.ImageList = ImageList1.hImageList
    
    
If Me.Width >= SIZE_SUPPORTSBUTTONS Then
    
        Dim Button As CommandbarLib.CommandBarButton
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "sep0")
        Button.Style = cbrSeparator
        Set Button = CommandBar1.Controls.Add(cbrButton, "new")
        Button.Image = 0
        Button.Tag = ID_NEW
        Set Button = CommandBar1.Controls.Add(cbrButton, "edit")
        Button.Image = 1
        Button.Tag = ID_EDIT
        Set Button = CommandBar1.Controls.Add(cbrButton, "save")
        Button.Image = 2
        Button.Tag = ID_SAVE
        Set Button = CommandBar1.Controls.Add(cbrButton, "category")
        Button.Image = 3
        Button.Tag = ID_CATEGORY
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "sep1")
        Button.Style = cbrSeparator
            
        Set Button = CommandBar1.Controls.Add(cbrButton, "learn")
        Button.Image = 4
        Button.Tag = ID_LEARN
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "sep2")
        Button.Style = cbrSeparator
            
        Set Button = CommandBar1.Controls.Add(cbrButton, "options")
        Button.Image = 5
        Button.Tag = ID_OPTIONS
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "sep3")
        Button.Style = cbrSeparator
        
      
        
        Set Button = CommandBar1.Controls.Add(cbrButton, "info")
        Button.Image = 6
        Button.Tag = ID_INFO
 
    End If
    
     
    AddToCombo Combo1
    Combo1.Text = Combo1.List(0)
    KategorieIndex = "01"
    
    DBladen
    EinlesenEintraege
    Interval = "DAY"
    

End Sub

Private Sub InvokeAction(ID As Integer, FromButton As Boolean)
   Select Case (ID)
    Case ID_EXIT        ' terminate the app
        App.End
    Case ID_NEW        ' thin brush mode
       frmAdd.Show
    
    Case ID_EDIT       ' thick brush mode
        If ListView1.ListItems.Count > 0 Then
            On Error Resume Next
            IndexX = ListView1.SelectedItem.SubItems(8)
            frmWork.Show
        End If
         
    Case ID_CATEGORY
        frmKatalog.Show
    
    Case ID_SAVE
        DBspeichern
    
    Case ID_LEARN
        frmLearn.Show
    
    Case ID_OPTIONS
        frmOptions.Show
       
    Case ID_HELP     ' point tool
       frmHelp.Show
        
    Case ID_INFO         ' pen tool
        frmInfo.Show
    Case Else
        ' programming error -- undefined tool
        MsgBox "Undefined Commandbar Command!"
    End Select
End Sub

