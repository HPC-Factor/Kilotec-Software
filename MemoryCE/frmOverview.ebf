Attribute VB_Name = "frmLearn"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
q = 1
EF_berechnen

End Sub

Private Sub Command2_Click()
q = 2
 EF_berechnen
End Sub

Private Sub Command3_Click()
q = 3
 EF_berechnen
End Sub

Private Sub Command4_Click()
q = 4
 EF_berechnen
End Sub

Private Sub Command5_Click()
q = 5
EF_berechnen
End Sub

Private Sub Command6_Click()
For XX = Index_Learn To Zaehler
If DBdaten(0, XX) = KategorieIndex And DBdaten(1, XX) <> Empty Then


frmLearn.Answer.Text = DBdaten(3, XX)
Exit For
End If
Next XX
Command6.Enabled = False
Command1.Enabled = True
Command2.Enabled = True
Command3.Enabled = True
Command4.Enabled = True
Command5.Enabled = True
End Sub





Private Sub Command7_Click()
If MsgBox("A reset will erase the last learning paramaters. Are you sure?", vbYesNo, "Info") = vbYes Then
    For XX = 0 To Zaehler
    If DBdaten(0, XX) = KategorieIndex And DBdaten(1, XX) <> Empty Then
        DBdaten(4, XX) = 0
        DBdaten(5, XX) = 2.5
        DBdaten(6, XX) = 0
        DBdaten(7, XX) = Date
        
    End If
Next XX
Command7.Enabled = False
End If






End Sub

Private Sub Command8_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Center Me
Index_Learn = 0

If Interval = "DAY" Then EinlesenEintraege_Day
If Interval = "HOUR" Then EinlesenEintraege_Hour
If Interval = "OFF" Then EinlesenEintraege_Off

If Question.Text = "" Then
    Command6.Enabled = False
    Command7.Enabled = True
    
    Category.Caption = "Category: " & Kategorie
Item.Caption = "Item: " & Index_Learn + 1 & " of " & frmMain.ListView1.ListItems.Count
End If
End Sub

Private Sub Label1_Click()

End Sub
