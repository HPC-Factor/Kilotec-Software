Attribute VB_Name = "frmKatalog"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit



Private Sub Command1_Click()
If List1.ListCount > 2 Then
If SPRACHE = 0 Then MsgBox "Only 3 entries possible in this version!" & vbCrLf & vbCrLf & _
"Please contact us: info@kilotec.de!", vbOKOnly, ""

If SPRACHE = 1 Then MsgBox "Nur 3 Einträge möglich (SHAREWARE)!" & vbCrLf & vbCrLf & _
"Bitte schreiben Sie uns: info@kilotec.de!", vbOKOnly, ""
Exit Sub
End If

Dim I As Integer

For I = 0 To List1.ListCount - 1
    If Trim(Text1.Text) = Mid(List1.List(I), 4) Then
        
        If SPRACHE = 0 Then MsgBox "This kind of travel already exists!", vbOKOnly, ""
        If SPRACHE = 1 Then MsgBox "Diese Reiseart existiert bereits!", vbOKOnly, ""

    Text1.SelStart = 0
    Text1.SelLength = Len(Text1.Text)
    Text1.SetFocus
Exit Sub
    End If
Next I

'Aktualisieren der Listbox
Dim Zahl As Integer
Zahl = List1.ListCount
If Zahl = 0 Then List1.AddItem "01" & " " & Text1.Text
If Zahl = 1 Then List1.AddItem "02" & " " & Text1.Text
If Zahl = 2 Then List1.AddItem "03" & " " & Text1.Text
If Zahl = 3 Then List1.AddItem "04" & " " & Text1.Text
If Zahl = 4 Then List1.AddItem "05" & " " & Text1.Text
If Zahl = 5 Then List1.AddItem "06" & " " & Text1.Text
If Zahl = 6 Then List1.AddItem "07" & " " & Text1.Text
If Zahl = 7 Then List1.AddItem "08" & " " & Text1.Text
If Zahl = 8 Then List1.AddItem "09" & " " & Text1.Text

If Zahl > 8 Then List1.AddItem Zahl + 1 & " " & Text1.Text
    

'Katalog speichern

'On Error Resume Next
frmMain.File.Open App.Path & "\Reiseart.dat", fsModeOutput, fsAccessWrite, fsLockReadWrite
For I = 0 To List1.ListCount - 1
        frmMain.File.LinePrint List1.List(I)
    Next I
frmMain.File.Close

If SPRACHE = 0 Then Label1.Caption = "Items (" & List1.ListCount & ")"
If SPRACHE = 1 Then Label1.Caption = "Einträge (" & List1.ListCount & ")"
Command1.Enabled = False

Me.Tag = "OK"
Text1.Text = ""
Text1.SetFocus

Exit Sub

SaveCat2:
    frmMain.File.Close
    MsgBox "Saving error", vbOKOnly, ""
    Exit Sub


   
End Sub

Private Sub Command2_Click()
frmMain.Combo1.Clear
AddToCombo frmMain.Combo1
frmMain.Combo1.Text = frmMain.Combo1.List(0)
Me.Hide

End Sub

Private Sub Command3_Click()
On Error Resume Next 'wenn keine Einträge vorhanden
Dim Del As Integer
'Schleife rückwärts zählen !!!!
For Del = List1.ListCount To 0 Step (-1)
    If List1.Selected(Del) = True Then
    List1.RemoveItem Del
    End If
   
Next Del
Dim ii As Integer
frmMain.File.Open App.Path & "\Reiseart.dat", fsModeOutput, fsAccessWrite, fsLockReadWrite
For ii = 0 To List1.ListCount - 1
        frmMain.File.LinePrint List1.List(ii)
    Next ii
frmMain.File.Close


If SPRACHE = 0 Then Label1.Caption = "Items (" & List1.ListCount & ")"
If SPRACHE = 1 Then Label1.Caption = "Einträge (" & List1.ListCount & ")"

Me.Tag = "OK"
frmMain.Combo1.Clear
AddToCombo frmMain.Combo1
End Sub



Private Sub Form_Activate()
Text1.SetFocus


If SPRACHE = 0 Then
    Me.Caption = "Kind of travel"
    Label1.Caption = "Items (" & List1.ListCount & ")"
    Command2.Caption = "&Close"
    Command3.Caption = "&Delete"
    Label2.Caption = "New entry"
End If
If SPRACHE = 1 Then
    Me.Caption = "Reiseart"
    Label1.Caption = "Einträge (" & List1.ListCount & ")"
    Command2.Caption = "&Schließen"
    Command3.Caption = "&Löschen"
    Label2.Caption = "Neuer Eintrag"
End If


If HINTERGRUNDFARBE = 0 Then frmKatalog.BackColor = &H8000000F
If HINTERGRUNDFARBE = 1 Then frmKatalog.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = 2 Then frmKatalog.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = 3 Then frmKatalog.BackColor = &HC0FFFF
End Sub

Private Sub Form_Load()
'Me.Caption = "Category"
Center Me
Dim Kat As String
Dim flKat As String
flKat = App.Path & "\Reiseart.dat"

On Error Resume Next
  frmMain.File.Open flKat, fsModeInput, fsAccessRead, fsLockRead
  Do While Not frmMain.File.EOF
      Kat = frmMain.File.LineInputString
       If Kat <> Empty Then
            List1.AddItem Kat
        End If
  Loop
 
  frmMain.File.Close




If SPRACHE = 0 Then Label1.Caption = "Items (" & List1.ListCount & ")"
If SPRACHE = 1 Then Label1.Caption = "Einträge (" & List1.ListCount & ")"

End Sub

Private Sub Label1_Click()

End Sub

Private Sub Label2_Click()

End Sub

Private Sub List1_Click()
Command3.Enabled = True
End Sub

Private Sub Text1_Change()
 If Text1.Text = "" Then
        Command1.Enabled = False
    Else
        Command1.Enabled = True
    End If
End Sub




