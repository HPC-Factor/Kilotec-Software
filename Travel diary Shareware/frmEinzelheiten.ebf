Attribute VB_Name = "frmEinzelheiten"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
AbInDieDatenbank_Einzelheiten
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub


Private Sub Form_Activate()
If SPRACHE = 1 Then Reise.Text = DBdaten(2, IndexX) & " in " & DBdaten(8, IndexX) & " am: " & DBdaten(3, IndexX)
If SPRACHE = 0 Then Reise.Text = DBdaten(2, IndexX) & " in " & DBdaten(8, IndexX) & " on: " & DBdaten(3, IndexX)

Personen.Text = DBdaten(15, IndexX)
Strecke.Text = DBdaten(16, IndexX)
NameUnterkunft.Text = DBdaten(17, IndexX)
Aktivitaeten.Text = DBdaten(18, IndexX)

If HINTERGRUNDFARBE = 0 Then frmEinzelheiten.BackColor = &H8000000F
If HINTERGRUNDFARBE = 1 Then frmEinzelheiten.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = 2 Then frmEinzelheiten.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = 3 Then frmEinzelheiten.BackColor = &HC0FFFF

If SPRACHE = 0 Then
    Me.Caption = "Details"
    Label3.Caption = "Travel:"
    Label1.Caption = "Persons:"
    Label2.Caption = "Total distance:"
    Label4.Caption = "Name lodging:"
    Label5.Caption = "Activities:"
    Command2.Caption = "&Close"
End If
If SPRACHE = 1 Then
    Me.Caption = "Einzelheiten"
    Label3.Caption = "Reise:"
    Label1.Caption = "Personen:"
    Label2.Caption = "Gesamtstrecke:"
    Label4.Caption = "Name Unterkunft:"
    Label5.Caption = "Aktivit‰ten:"
    Command2.Caption = "&Schlieﬂen"
    
    
End If
End Sub

Private Sub Form_Load()
Center Me

End Sub
