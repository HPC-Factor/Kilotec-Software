Attribute VB_Name = "frmOptionen"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Check1_Click()
If Check1.Value = 1 Then
    Hints = 1
Else
    Hints = 0
End If
End Sub

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Command2_Click()
If txtCPU.Text < 1 Or txtCPU.Text > 1000 Or txtCPU.Text = "" Or IsNumeric(txtCPU.Text) = False Then
    MsgBox "Please enter a valid number for the CPU speed (1-1000)", vbOKOnly, "Error"
    Exit Sub
End If


frmMain.Timer1.Interval = CInt(txtCPU.Text)

If Option1.Value = True Then Layout = 0
If Option2.Value = True Then Layout = 1

If Layout = 0 Then
    frmMain.List1.BackColor = vbBlack
    frmMain.List1.ForeColor = vbWhite
    frmMain.BackColor = vbBlack
End If
If Layout = 1 Then
    frmMain.List1.BackColor = vbWhite
    frmMain.List1.ForeColor = vbBlack
    frmMain.BackColor = vbWhite
End If

SaveSetting App.Title, "Settings", "Help", Hints
SaveSetting App.Title, "Settings", "TimerSpeed", CInt(txtCPU.Text)
SaveSetting App.Title, "Settings", "Layout", Layout
Me.Hide
End Sub

Private Sub Form_Activate()
txtCPU.Text = TimerSpeed
If Hints = 1 Then
    Check1.Value = 1
Else
    Check1.Value = 0
End If
End Sub

Private Sub Form_Load()
Center Me

End Sub
