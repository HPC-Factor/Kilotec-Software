Attribute VB_Name = "frmEnter"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit
Public EingabeZahlen As Boolean


Private Sub Command1_Click()
If EingabeZahlen = True Then
    reg(Hi) = Text1.Text
Else
    reg(Hi) = 0
End If
If Text1.Text = "" Then reg(Hi) = 0
Text1.Text = ""
Me.Hide
frmMain.Timer1.Enabled = True
End Sub

Private Sub Command2_Click()
reg(Hi) = 0
Text1.Text = ""
Me.Hide
frmMain.Timer1.Enabled = True
End Sub

Private Sub Form_Activate()
Text1.Text = reg(Hi)
Text1.SelStart = 0
Text1.SelLength = Len(Text1.Text)
Text1.SelText
End Sub

Private Sub Form_Load()
Center Me
End Sub

Private Sub Text1_Change()

End Sub

Private Sub Text1_KeyPress(ByVal KeyAscii As Integer)
Dim Erlaubt As String
Dim aa As String

Erlaubt = "0123456789" & Chr(8)
aa = Chr(KeyAscii)

If InStr(1, Erlaubt, aa) = 0 Then
    MsgBox "Only numbers are allowed!", vbOKOnly, "Error"
    EingabeZahlen = False
    Text1.Text = ""
Else
    EingabeZahlen = True
End If
End Sub
