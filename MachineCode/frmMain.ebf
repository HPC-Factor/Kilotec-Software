Private Sub List1_Click()
If Selected = False Then
    Selected = True
    Indexx = List1.ListIndex
    Command2.Enabled = True
Else
    Selected = False
    Command2.Enabled = False
    'List1.Selected(List1.ListIndex) = False
End If
End Sub

Private Sub List1_KeyDown(ByVal KeyCode As Integer, ByVal Shift As Integer)
Select Case KeyCode

Case vbKey0
    If CHAR = 0 Then
        Hi = 0
        CHAR = CHAR + 1
    Else
        Lo = 0
        CHAR = 0
        Eingabe
    End If
Case vbKey1
    If CHAR = 0 Then
        Hi = 1
        CHAR = CHAR + 1
    Else
        Lo = 1
        CHAR = 0
        Eingabe
    End If
Case vbKey2
    If CHAR = 0 Then
        Hi = 2
        CHAR = CHAR + 1
    Else
        Lo = 2
        CHAR = 0
        Eingabe
    End If
Case vbKey3
    If CHAR = 0 Then
        Hi = 3
        CHAR = CHAR + 1
    Else
        Lo = 3
        CHAR = 0
        Eingabe
    End If
Case vbKey4
    If CHAR = 0 Then
        Hi = 4
        CHAR = CHAR + 1
    Else
        Lo = 4
        CHAR = 0
        Eingabe
    End If
Case vbKey5
    If CHAR = 0 Then
        Hi = 5
        CHAR = CHAR + 1
    Else
        Lo = 5
        CHAR = 0
        Eingabe
    End If
Case vbKey6
    If CHAR = 0 Then
        Hi = 6
        CHAR = CHAR + 1
    Else
        Lo = 6
        CHAR = 0
        Eingabe
    End If


End Select
End Sub

Private Sub Timer1_Timer()
If List1.ListCount > 0 Then Run

If TOGGLE = True Then
    'frmOutput.LED.Value = 1
    frmOutput.lblLED.BackColor = &HFF&
Else
    'frmOutput.LED.Value = 0
    frmOutput.lblLED.BackColor = &H80&
End If
End Sub
