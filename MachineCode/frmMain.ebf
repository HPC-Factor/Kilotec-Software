Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Dim mnuMain As CommandbarLib.CommandBarMenuBar
Dim mnuFile As CommandbarLib.Item
Dim mnuEdit As CommandbarLib.Item
Dim mnuKategorie As CommandbarLib.Item
Dim mnuExtras As CommandbarLib.Item
Dim mnuInfo As CommandbarLib.Item




Private Sub cmdBar_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)
 Select Case Button.Key
    Case "new"
        Dim a As Integer
        a = MsgBox("Do you want to start a new project without saving?", vbYesNo, "Info")
        If a = vbYes Then
        On Error Resume Next
            List1.Clear
            Indexx = 0
            LINE = 0
            pc = 0
            sp = 0
            zero = False
            carry = False
            err = False
            
            For r = 0 To 7
                reg(r) = 0
            Next r
            Exit Sub
        End If
    
    
    Case "save"
        CommonDialog1.Flags = cdlOFNHideReadOnly + cdlOFNOverwritePrompt + cdlOFNPathMustExist
        CommonDialog1.DefaultExt = "tmc"
        CommonDialog1.Filename = ""
        CommonDialog1.Filter = "Tiny Machine Code (*.tmc)|*.tmc"
        CommonDialog1.DialogTitle = "Saving..."
        CommonDialog1.ShowSave
        On Error Resume Next
        Filename = CommonDialog1.Filename
        DBSpeichern
    
    Case "open"
        CommonDialog1.Flags = cdlOFNHideReadOnly + cdlOFNOverwritePrompt + cdlOFNPathMustExist
        CommonDialog1.DefaultExt = "tmc"
        CommonDialog1.Filename = ""
        CommonDialog1.Filter = "Tiny Machine Code (*.tmc)|*.tmc"
        CommonDialog1.DialogTitle = "Open..."
        CommonDialog1.ShowOpen
        On Error Resume Next
        Filename = CommonDialog1.Filename
        DBladen
        LINE = frmMain.List1.ListCount - 1

    
    Case "run"
        Command10_Click
        
  
    
    Case "settings"
        frmOptionen.Show
        

        Case "about"
            frmAbout.Show
        
        Case "help"
            frmHelp.Show
        

    End Select
End Sub

Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
 Select Case Item.Key
    Case "new"
        Dim a As Integer
        a = MsgBox("Do you want to start a new project without saving?", vbYesNo, "Info")
        If a = vbYes Then
        On Error Resume Next
            List1.Clear
            Indexx = 0
            LINE = 0
            pc = 0
            sp = 0
            zero = False
            carry = False
            err = False
            
            For r = 0 To 7
                reg(r) = 0
            Next r
            Exit Sub
        End If
    
    
    Case "save"
        CommonDialog1.Flags = cdlOFNHideReadOnly + cdlOFNOverwritePrompt + cdlOFNPathMustExist
        CommonDialog1.DefaultExt = "tmc"
        CommonDialog1.Filename = ""
        CommonDialog1.Filter = "Tiny Machine Code (*.tmc)|*.tmc"
        CommonDialog1.DialogTitle = "Saving..."
        CommonDialog1.ShowSave
        On Error Resume Next
        Filename = CommonDialog1.Filename
        DBSpeichern
    
    Case "open"
        CommonDialog1.Flags = cdlOFNHideReadOnly + cdlOFNOverwritePrompt + cdlOFNPathMustExist
        CommonDialog1.DefaultExt = "tmc"
        CommonDialog1.Filename = ""
        CommonDialog1.Filter = "Tiny Machine Code (*.tmc)|*.tmc"
        CommonDialog1.DialogTitle = "Open..."
        CommonDialog1.ShowOpen
        On Error Resume Next
        Filename = CommonDialog1.Filename
        DBladen
        LINE = frmMain.List1.ListCount - 1

    
    Case "Exit"
        App.End
        
  
    
    Case "settings"
        frmOptionen.Show
    
    Case "samples"
        frmSamples.Show
        

        Case "about"
            frmAbout.Show
        
        Case "help"
            frmHelp.Show
        

    End Select
End Sub

Private Sub Command13_KeyDown(ByVal KeyCode As Integer, ByVal Shift As Integer)

End Sub

Private Sub Form_KeyDown(KeyCode As Integer, Shift As Integer)

End Sub

Private Sub Form_KeyPress(KeyAscii As Integer)

End Sub

Private Sub Form_Load()
Indexx = 0

pc = 0
sp = 0
zero = False
carry = False
err = False

For r = 0 To 7
    reg(r) = 0
Next r



cmdBar.Left = 0
cmdBar.Top = 0
cmdBar.Width = Me.Width

ImageList1.Add App.Path & "\BarMC.bmp"
cmdBar.ImageList = ImageList1.hImageList

Dim mnuMain As CommandbarLib.CommandBarMenuBar
Dim mnuFile As CommandbarLib.Item
Dim mnuKategorie As CommandbarLib.Item
Dim mnuEdit As CommandbarLib.Item

   
    Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
    Set mnuFile = mnuMain.Items.Add(1, , "&File")
    mnuFile.SubItems.Add , "new", "&New"
    mnuFile.SubItems.Add , "open", "&Open"
    mnuFile.SubItems.Add , "save", "&Save"
    mnuFile.SubItems.Add , , "", cbrMenuSeparator
    mnuFile.SubItems.Add , "Exit", "E&xit"
    
    Set mnuKategorie = mnuMain.Items.Add(2, , "&Extras")
    mnuKategorie.SubItems.Add , "settings", "&Settings"

    
    Set mnuEdit = mnuMain.Items.Add(3, , "&?")
    mnuEdit.SubItems.Add , "about", "&About"
    mnuEdit.SubItems.Add , "help", "&Help"
    

If Me.Width >= SIZE_SUPPORTSBUTTONS Then
    
        Dim Button As CommandbarLib.CommandBarButton
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep0")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "new")
        Button.Image = 2
        Button.Tag = "new"
        Set Button = cmdBar.Controls.Add(cbrButton, "open")
        Button.Image = 0
        Button.Tag = "open"
        Set Button = cmdBar.Controls.Add(cbrButton, "save")
        Button.Image = 1
        Button.Tag = "save"
        Set Button = cmdBar.Controls.Add(cbrButton, "sep1")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "run")
        Button.Image = 6
        Button.Tag = "run"
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep2")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "settings")
        Button.Image = 3
        Button.Tag = "settings"
        Set Button = cmdBar.Controls.Add(cbrButton, "help")
        Button.Image = 5
        Button.Tag = "help"

        

 
    End If


Hints = GetSetting(App.Title, "Settings", "Help", 1)
TimerSpeed = GetSetting(App.Title, "Settings", "TimerSpeed", 500)
Layout = GetSetting(App.Title, "Settings", "Layout", 0)

If Layout = 0 Then
    List1.BackColor = vbBlack
    List1.ForeColor = vbWhite
    frmMain.BackColor = vbBlack
End If
If Layout = 1 Then
    List1.BackColor = vbWhite
    List1.ForeColor = vbBlack
    frmMain.BackColor = vbWhite
End If

Timer1.Interval = TimerSpeed

End Sub






Private Sub Command1_Click()
    Timer1.Enabled = False
    Command10.Enabled = True
    Command1.Enabled = False
    frmOutput.Hide
    
    
End Sub

Private Sub Command10_Click()
Command10.Enabled = False
Command1.Enabled = True
'Running = True
'Run
Timer1.Enabled = True
    
frmOutput.Show
End Sub

Private Sub Command11_Click()
If CHAR = 0 Then
    Hi = 4
    CHAR = CHAR + 1
Else
    Lo = 4
