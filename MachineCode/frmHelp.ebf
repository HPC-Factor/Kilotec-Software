Option Explicit

Private Sub Command1_Click()
Me.Hide
End Sub

Private Sub Form_Load()
Center Me
Dim i As Integer

Grid1.Clear

Grid1.SelectionMode = flexSelectionByRow
Grid1.ScrollBars = flexScrollBarVertical
Grid1.Rows = 1


Grid1.TextMatrix(0, 0) = "Mnemonic"
Grid1.TextMatrix(0, 1) = "OpCode"
Grid1.TextMatrix(0, 2) = "Flags"
Grid1.TextMatrix(0, 3) = "Description"


Grid1.ColWidth(0) = 1000
Grid1.ColWidth(1) = 800
Grid1.ColWidth(2) = 500
Grid1.ColWidth(3) = 1800


Grid1.ColAlignment(0) = flexAlignCenterCenter
Grid1.ColAlignment(1) = flexAlignCenterCenter
Grid1.ColAlignment(2) = flexAlignCenterCenter
Grid1.ColAlignment(3) = flexAlignCenterCenter

Grid1.FillStyle = flexFillRepeat
Grid1.RowSel = 0
Grid1.CellFontBold = True
Grid1.FillStyle = flexFillSingle

For i = 0 To 3
Grid1.RowSel = 0
Grid1.Col = i
Grid1.CellBackColor = &HC0C0C0
Next i

Grid1.SelectionMode = flexSelectionFree

Grid1.AddItem "ADD Rx" & vbTab & "xA" & vbTab & "Z, C" & vbTab & "Add Rx to R0"
Grid1.AddItem "BRK" & vbTab & "00" & vbTab & "" & vbTab & "Break"
Grid1.AddItem "CPY x" & vbTab & "xC" & vbTab & "" & vbTab & "Copy const x into R0"
Grid1.AddItem "DEC Rx" & vbTab & "xD" & vbTab & "Z, C" & vbTab & "Decrement Rx"
Grid1.AddItem "ENT Rx" & vbTab & "xE" & vbTab & "" & vbTab & "Enter Rx"
Grid1.AddItem "JZ adr." & vbTab & "8a,9a" & vbTab & "" & vbTab & "Jump if zero"
Grid1.AddItem "JNZ adr." & vbTab & "Aa,Bb" & vbTab & "" & vbTab & "Jump if not zero"
Grid1.AddItem "JC adr." & vbTab & "Ca,Da" & vbTab & "" & vbTab & "Jump if carry set"
Grid1.AddItem "JSR adr." & vbTab & "Ea,Fa" & vbTab & "" & vbTab & "Jump to sub"
Grid1.AddItem "MOV Rx,Ry" & vbTab & "xy" & vbTab & "" & vbTab & "Move Rx=Ry"
Grid1.AddItem "NOP" & vbTab & "11" & vbTab & "" & vbTab & "No operation"
Grid1.AddItem "PSH Rx" & vbTab & "x8" & vbTab & "" & vbTab & "Push Rx onto stack"
Grid1.AddItem "POP Rx" & vbTab & "x9" & vbTab & "" & vbTab & "Pop Rx from stack"
Grid1.AddItem "RTS" & vbTab & "77" & vbTab & "" & vbTab & "Return from sub"
Grid1.AddItem "SUB Rx" & vbTab & "xB" & vbTab & "Z, C" & vbTab & "Subtract Rx from R0"
Grid1.AddItem "TOG" & vbTab & "66" & vbTab & "" & vbTab & "Toggle LED"
End Sub
