Private Sub Form_Load()
    Dim mnuMain As CommandbarLib.CommandBarMenuBar
    Dim mnuFile As CommandbarLib.Item
    Dim mnuGame As CommandbarLib.Item
    Dim mnuColor As CommandbarLib.Item
    
    Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
    'add File menu items
    Set mnuFile = mnuMain.Items.Add(1, "File", "&File")
    mnuFile.SubItems.Add , "New", "&New Game"
    mnuFile.SubItems.Add , "", "", cbrMenuSeparator
    mnuFile.SubItems.Add , "About", "&About"
    mnuFile.SubItems.Add , "", "", cbrMenuSeparator
    mnuFile.SubItems.Add , "Exit", "E&xit"
    
    'add File menu items
    Set mnuGame = mnuMain.Items.Add(2, , "Game style")
    mnuGame.SubItems.Add , "Original", "&Original"
    mnuGame.SubItems.Add , "HP", "&HP Version"
    mnuGame.SubItems.Add , "HARD", "4x4"
    
    Set mnuColor = mnuMain.Items.Add(3, , "Tile Color")
    mnuColor.SubItems.Add , "Gray", "&Grey"
    mnuColor.SubItems.Add , "Yellow", "Yellow"
    mnuColor.SubItems.Add , "Blue", "Blue"
    mnuColor.SubItems.Add , "Red", "Red"
   
    
    Color = 1
    Game = 0
    Label3.Caption = "0"
    Label4.Caption = "1"
    
    tile(0) = "95LX"
    tile(1) = "100LX"
    tile(2) = "200LX"
    tile(3) = "300LX"
    tile(4) = "320LX"
    tile(5) = "J.680"
    tile(6) = "J.690"
    tile(7) = "J.720"
    
    
End Sub

Private Sub Shuffle()
Randomize Timer
Dim a
Dim b
Dim c
Dim d
Dim e
Dim f
Dim g
Dim h
Dim upperbound
Dim lowerbound

upperbound = 8
lowerbound = 1


Command9.Caption = ""
a = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
b = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
c = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
d = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
e = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
f = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
g = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
h = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)

If frmMain.Label3.Caption = "0" Then
    Command1.Caption = a
    Do Until b <> a
    b = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command2.Caption = b
    Do Until c <> a And c <> b
    c = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command3.Caption = c
    Do Until d <> a And d <> b And d <> c
    d = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command4.Caption = d
    Do Until e <> a And e <> b And e <> c And e <> d
    e = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command5.Caption = e
    Do Until f <> a And f <> b And f <> c And f <> d And f <> e
    f = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command6.Caption = f
    Do Until g <> a And g <> b And g <> c And g <> d And g <> e And g <> f
    g = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command7.Caption = g
    Do Until h <> a And h <> b And h <> c And h <> d And h <> e And h <> f And h <> g
    h = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command8.Caption = h
End If

If frmMain.Label3.Caption = "1" Then
    
   
    a = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    
    Command1.Caption = tile(a - 1)
    
    Do Until b <> a
    b = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command2.Caption = tile(b - 1)
    Do Until c <> a And c <> b
    c = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command3.Caption = tile(c - 1)
    Do Until d <> a And d <> b And d <> c
    d = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command4.Caption = tile(d - 1)
    Do Until e <> a And e <> b And e <> c And e <> d
    e = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command5.Caption = tile(e - 1)
    Do Until f <> a And f <> b And f <> c And f <> d And f <> e
    f = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command6.Caption = tile(f - 1)
    Do Until g <> a And g <> b And g <> c And g <> d And g <> e And g <> f
    g = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command7.Caption = tile(g - 1)
    Do Until h <> a And h <> b And h <> c And h <> d And h <> e And h <> f And h <> g
    h = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command8.Caption = tile(h - 1)
End If

End Sub

