Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
Select Case Item.Key
    Case "New"
        'NewGame
        'Shuffle
        NewGame = 1
        Label2.Caption = "1"
        ClicksCount = 0
        Clicks.Caption = "0"
        Ausgangslage
        Shuffle
    Case "About"
        frmAbout.Show
    Case "Exit"
        App.End
    
    Case "Original"
        Command1.Caption = "1"
        Command2.Caption = "2"
        Command3.Caption = "3"
        Command4.Caption = "4"
        Command5.Caption = "5"
        Command6.Caption = "6"
        Command7.Caption = "7"
        Command8.Caption = "8"
        Command9.Caption = ""
        Game = 0
        Label3.Caption = "0"
        Label2.Caption = "0"
        Ausgangslage
      
    Case "HP"
        Command1.Caption = "95LX"
        Command2.Caption = "100LX"
        Command3.Caption = "200LX"
        Command4.Caption = "300LX"
        Command5.Caption = "320LX"
        Command6.Caption = "J.680"
        Command7.Caption = "J.690"
        Command8.Caption = "J.720"
        Command9.Caption = ""
        Game = 1
        Label3.Caption = "1"
        Label2.Caption = "0"
        Ausgangslage
        
    Case "HARD"
        frmfour.Show
        
    Case "Gray"
        Command1.BackColor = &HC0C0C0
        Command2.BackColor = &HC0C0C0
        Command3.BackColor = &HC0C0C0
        Command4.BackColor = &HC0C0C0
        Command5.BackColor = &HC0C0C0
        Command6.BackColor = &HC0C0C0
        Command7.BackColor = &HC0C0C0
        Command8.BackColor = &HC0C0C0
        Command9.BackColor = vbWhite
        Label4.Caption = "1"
        Label2.Caption = "0"
        Ausgangslage
    Case "Yellow"
        Command1.BackColor = vbYellow
        Command2.BackColor = vbYellow
        Command3.BackColor = vbYellow
        Command4.BackColor = vbYellow
        Command5.BackColor = vbYellow
        Command6.BackColor = vbYellow
        Command7.BackColor = vbYellow
        Command8.BackColor = vbYellow
        Command9.BackColor = vbWhite
        Label4.Caption = "2"
        Label2.Caption = "0"
        Ausgangslage
    Case "Blue"
        Command1.BackColor = vbBlue
        Command2.BackColor = vbBlue
        Command3.BackColor = vbBlue
        Command4.BackColor = vbBlue
        Command5.BackColor = vbBlue
        Command6.BackColor = vbBlue
        Command7.BackColor = vbBlue
        Command8.BackColor = vbBlue
        Command9.BackColor = vbWhite
        Label4.Caption = "3"
        Label2.Caption = "0"
        Ausgangslage
    Case "Red"
        Command1.BackColor = vbRed
        Command2.BackColor = vbRed
        Command3.BackColor = vbRed
        Command4.BackColor = vbRed
        Command5.BackColor = vbRed
        Command6.BackColor = vbRed
        Command7.BackColor = vbRed
        Command8.BackColor = vbRed
        Command9.BackColor = vbWhite
        Label4.Caption = "4"
        Label2.Caption = "0"
        Ausgangslage
    
  End Select
End Sub

Private Sub Command1_Click()
cblev1 Command1, Command2
cblev1 Command1, Command4

End Sub
Private Sub Ausgangslage()
If frmMain.Label3.Caption = "0" Then
    Command1.Caption = "1"
    Command2.Caption = "2"
    Command3.Caption = "3"
    Command4.Caption = "4"
    Command5.Caption = "5"
    Command6.Caption = "6"
    Command7.Caption = "7"
    Command8.Caption = "8"
    Command9.Caption = ""
End If
If frmMain.Label3.Caption = "1" Then
        Command1.Caption = "95LX"
        Command2.Caption = "100LX"
        Command3.Caption = "200LX"
        Command4.Caption = "300LX"
        Command5.Caption = "320LX"
        Command6.Caption = "J.680"
        Command7.Caption = "J.690"
        Command8.Caption = "J.720"
        Command9.Caption = ""
End If
If Label4.Caption = "1" Then
    Command9.BackColor = &HFFFFFF
    Command1.BackColor = &HC0C0C0
    Command2.BackColor = &HC0C0C0
    Command3.BackColor = &HC0C0C0
    Command4.BackColor = &HC0C0C0
    Command5.BackColor = &HC0C0C0
    Command6.BackColor = &HC0C0C0
    Command7.BackColor = &HC0C0C0
    Command8.BackColor = &HC0C0C0
End If
If Label4.Caption = "2" Then
    Command9.BackColor = &HFFFFFF
    Command1.BackColor = vbYellow
    Command2.BackColor = vbYellow
    Command3.BackColor = vbYellow
    Command4.BackColor = vbYellow
    Command5.BackColor = vbYellow
    Command6.BackColor = vbYellow
    Command7.BackColor = vbYellow
    Command8.BackColor = vbYellow
End If
If Label4.Caption = "3" Then
    Command9.BackColor = &HFFFFFF
    Command1.BackColor = vbBlue
    Command2.BackColor = vbBlue
    Command3.BackColor = vbBlue
    Command4.BackColor = vbBlue
    Command5.BackColor = vbBlue
    Command6.BackColor = vbBlue
    Command7.BackColor = vbBlue
    Command8.BackColor = vbBlue
End If
If Label4.Caption = "4" Then
    Command9.BackColor = &HFFFFFF
    Command1.BackColor = vbRed
    Command2.BackColor = vbRed
    Command3.BackColor = vbRed
    Command4.BackColor = vbRed
    Command5.BackColor = vbRed
    Command6.BackColor = vbRed
    Command7.BackColor = vbRed
    Command8.BackColor = vbRed
End If
End Sub


