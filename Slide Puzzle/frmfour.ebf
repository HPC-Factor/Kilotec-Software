Public Sub shuffle2()
    Command1.Caption = "1"
    Command2.Caption = "2"
    Command3.Caption = "3"
    Command4.Caption = "4"
    Command5.Caption = "5"
    Command6.Caption = "6"
    Command7.Caption = "7"
    Command8.Caption = "8"
    Command9.Caption = "9"
    Command10.Caption = "10"
    Command11.Caption = "11"
    Command12.Caption = "12"
    Command13.Caption = "13"
    Command14.Caption = "14"
    Command15.Caption = "15"
    Command16.Caption = ""



Randomize Timer
Dim a
Dim b
Dim c
Dim d
Dim e
Dim f
Dim g
Dim h
Dim i
Dim j
Dim k
Dim l
Dim m
Dim n
Dim o
Dim p
Dim upperbound
Dim lowerbound

upperbound = 16
lowerbound = 1


Command16.Caption = ""
a = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
b = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
c = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
d = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
e = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
f = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
g = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
h = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
i = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
j = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
k = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
l = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
m = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
n = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
o = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
p = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)

    Command1.Caption = a
    Do Until b <> a
    b = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command2.Caption = b
    Do Until c <> a And c <> b
    c = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command3.Caption = c
    Do Until d <> a And d <> b And d <> c
    d = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command4.Caption = d
    Do Until e <> a And e <> b And e <> c And e <> d
    e = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command5.Caption = e
    Do Until f <> a And f <> b And f <> c And f <> d And f <> e
    f = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command6.Caption = f
    Do Until g <> a And g <> b And g <> c And g <> d And g <> e And g <> f
    g = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command7.Caption = g
    Do Until h <> a And h <> b And h <> c And h <> d And h <> e And h <> f And h <> g
    h = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command8.Caption = h
    Do Until i <> a And i <> b And i <> c And i <> d And i <> e And i <> f And i <> g And i <> h
    i = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command9.Caption = i
    Do Until j <> a And j <> b And j <> c And j <> d And j <> e And j <> f And j <> g And j <> h And j <> i
    j = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command10.Caption = j
    Do Until k <> a And k <> b And k <> c And k <> d And k <> e And k <> f And k <> g And k <> h And k <> i And k <> j
    k = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command11.Caption = k
    Do Until l <> a And l <> b And l <> c And l <> d And l <> e And l <> f And l <> g And l <> h And l <> i And l <> j And l <> k
    l = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command12.Caption = l
    Do Until m <> a And m <> b And m <> c And m <> d And m <> e And m <> f And m <> g And m <> h And m <> i And m <> j And m <> k And m <> l
    m = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command13.Caption = m
    Do Until n <> a And n <> b And n <> c And n <> d And n <> e And n <> f And n <> g And n <> h And n <> i And n <> j And n <> k And n <> l And n <> m
    n = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command14.Caption = n
    Do Until o <> a And o <> b And o <> c And o <> d And o <> e And o <> f And o <> g And o <> h And o <> i And o <> j And o <> k And o <> l And o <> m And o <> n
    o = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    Loop
    Command15.Caption = o

    'Do Until p <> a And p <> b And p <> c And p <> d And p <> e And p <> f And p <> g And p <> h And p <> i And p <> j And p <> k And p <> l And p <> m And p <> n And p <> o
    'p = Int((upperbound - lowerbound + 1) * Rnd + lowerbound)
    'Loop
    'Command16.Caption = p
End Sub
