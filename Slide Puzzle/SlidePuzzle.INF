[Version]
Signature="$Chicago$"
CESignature="$Windows CE$"
Provider=%CompanyName%

[SourceDisksNames]
1=,"Application Files",, App

[DefaultInstall]
CopyFiles=Files.App, Files.Windows
CEShortcuts=Shortcuts

[Shortcuts]
%AppName%,0,"SlidePuzzle.vb"

[CEStrings]
InstallDir=%CE1%\%AppName%
AppName="Slider Puzzle"

[Strings]
CompanyName="Dominik Kristen"

[DestinationDirs]
Shortcuts=,%CE11%
Files.App=,%InstallDir%
Files.Windows=,%CE2%
Files.SH 3 (1K) v2.10=,%CE2%

[SourceDisksFiles]
SlidePuzzle.vb=1

[DefaultInstall.SH 3 (1K) v2.10]
CopyFiles=Files.SH 3 (1K) v2.10
CESelfRegister=MSCECommandBar.dll,vbscript.dll,pvbhost2.dll,pvbform2.dll,pvbdecl.dll

[CEDevice.SH 3 (1K) v2.10]
ProcessorType=10003

[SourceDisksNames.SH 3 (1K) v2.10]
3= ,"SH 3 (1K) v2.10 Files",,SH 3 (1K) v2.10

[SourceDisksFiles.SH 3 (1K) v2.10]
pvbhost2.dll=3
vbscript.dll=3
pvbload.exe=3
pvbdecl.dll=3
pvbform2.dll=3
vbsen.dll=3
MSCECommandBar.dll=3

[Files.App]
SlidePuzzle.vb

[Files.SH 3 (1K) v2.10]
pvbhost2.dll,,0x80000000
vbscript.dll,,0x80000000
pvbload.exe
pvbdecl.dll,,0x80000000
pvbform2.dll,,0x80000000
vbsen.dll
MSCECommandBar.dll,,0x80000000

