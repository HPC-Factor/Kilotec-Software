Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
'********************************************************************************
'*
'*  Dice - Main form code
'*
'*  Copyright (c) 1998 Microsoft Corporation

Option Explicit

Dim RollCount
Dim DiceVals(5)
Dim DieLocked(5)
Const Bonus = 35
Dim sumDice
Dim DieNum
Dim Small
Dim Large
Dim isTwoKind
Dim isThreeKind
Dim isFourKind
Dim isYahtzee
Dim TurnOver
Dim CatLeft
Dim ImgWidth
Dim ImgHeight

Private Sub cmdBar_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)
 InvokeAction CInt(Button.Tag), True
End Sub

Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
 InvokeAction (Item.Index + (100 * Item.Parent.Index)), False
End Sub
Private Sub InvokeAction(ID As Integer, FromButton As Boolean)
   Select Case (ID)
    Case ID_EXIT        ' terminate the app
        App.End
    Case ID_NEW        ' thin brush mode
       NewGame
    
    Case ID_ABOUT       ' thick brush mode
        frmAbout.Show
         
    Case ID_OPTIONS
        frmOptions.Show
    
    Case ID_HS
        frmHS.Show
    
    Case ID_SOUND
        If Sound = True Then
            Sound = False
        Else
            Sound = True
        End If
    
    Case Else
        ' programming error -- undefined tool
        MsgBox "Undefined Commandbar Command!"
    End Select
End Sub
Private Sub cmdRoll_Click()
    TurnOver = "False"
    'Increment the roll counter
    RollCount = RollCount + 1
    'unfreeze dice to enable selection
    imgD1.Enabled = True
    imgD2.Enabled = True
    imgD3.Enabled = True
    imgD4.Enabled = True
    imgD5.Enabled = True
    PlayWaveFile (App.Path & "\rolldice.wav")
    'check for which roll we're on
    If DiceRolls = 0 Then
        Select Case RollCount
            Case 1
                imgD1.Visible = True
                imgD2.Visible = True
                imgD3.Visible = True
                imgD4.Visible = True
                imgD5.Visible = True
                
                'cmdRoll.Caption = "Roll " & RollCount + 1
                Roll.Caption = "ROLL " & RollCount + 0 & ":"
                RollDice
                Roll.Caption = "ROLL " & RollCount & ":"
                cmdRoll.Enabled = False
                RollCount = 0
                Command1.SetFocus
                
                Exit Sub
            End Select
    End If
    
    If DiceRolls = 1 Then
        Select Case RollCount
            Case 1
                imgD1.Visible = True
                imgD2.Visible = True
                imgD3.Visible = True
                imgD4.Visible = True
                imgD5.Visible = True
                
                'cmdRoll.Caption = "Roll " & RollCount + 1
                Roll.Caption = "ROLL " & RollCount + 0 & ":"
                RollDice
            Case 2
                RollDice
                'cmdRoll.Caption = "Roll 1"
                Roll.Caption = "ROLL " & RollCount & ":"
                cmdRoll.Enabled = False
                RollCount = 0
                Command1.SetFocus
                
                Exit Sub
        End Select
    End If
    
    If DiceRolls = 2 Then
        Select Case RollCount
            Case 1, 2
                imgD1.Visible = True
                imgD2.Visible = True
                imgD3.Visible = True
                imgD4.Visible = True
                imgD5.Visible = True
                
                'cmdRoll.Caption = "Roll " & RollCount + 1
                Roll.Caption = "ROLL " & RollCount + 0 & ":"
                RollDice
            Case 3
                RollDice
                'cmdRoll.Caption = "Roll 1"
                Roll.Caption = "ROLL 3:"
                cmdRoll.Enabled = False
                RollCount = 0
                Command1.SetFocus
                
                Exit Sub
        End Select
    End If
    
    If DiceRolls = 3 Then
        Select Case RollCount
            Case 1, 2, 3
                imgD1.Visible = True
                imgD2.Visible = True
                imgD3.Visible = True
                imgD4.Visible = True
                imgD5.Visible = True
                
                'cmdRoll.Caption = "Roll " & RollCount + 1
                Roll.Caption = "ROLL " & RollCount + 0 & ":"
                RollDice
            Case 4
                RollDice
                'cmdRoll.Caption = "Roll 1"
                Roll.Caption = "ROLL " & RollCount & ":"
                cmdRoll.Enabled = False
                RollCount = 0
                Command1.SetFocus
                
                Exit Sub
        End Select
    End If
    
    If DiceRolls = 4 Then
        Select Case RollCount
            Case 1, 2, 3, 4
                imgD1.Visible = True
                imgD2.Visible = True
                imgD3.Visible = True
                imgD4.Visible = True
                imgD5.Visible = True
                
                'cmdRoll.Caption = "Roll " & RollCount + 1
                Roll.Caption = "ROLL " & RollCount + 0 & ":"
                RollDice
            Case 5
                RollDice
                'cmdRoll.Caption = "Roll 1"
                Roll.Caption = "ROLL " & RollCount & ":"
                cmdRoll.Enabled = False
                RollCount = 0
                Command1.SetFocus
                
                Exit Sub
        End Select
    End If
    
    
End Sub



Private Sub Command1_Click()
If cmdBar.Visible = True Then
cmdBar.Visible = False
Else
cmdBar.Visible = True
End If
End Sub

Private Sub Form_Activate()

End Sub

Private Sub Form_Load()
    
    
    
    
    Center Me
    DBladen
    
    DiceRolls = 2
    Color = 0

  
    
    imgD1.Top = -100
    imgD2.Top = -100
    imgD3.Top = -100
    imgD4.Top = -100
    imgD5.Top = -100
    imgD1.Top = 1000
    imgD2.Top = 1000
    imgD3.Top = 1000
    imgD4.Top = 1000
    imgD5.Top = 1000
    
    Becher.Top = -100
    Becher.Top = 1560
    Becher.Picture = App.Path & "\Becher.bmp"
    
    cmdBar.Left = 0
    cmdBar.Top = 0
    cmdBar.Width = Me.Width
    
    Sound = True

    Dim mnuMain As CommandbarLib.CommandBarMenuBar
    Dim mnuFile As CommandbarLib.Item
    Dim mnuOptions As CommandbarLib.Item
   
    Set mnuMain = cmdBar.Controls.Add(cbrMenuBar, "MainMenu")
    Set mnuFile = mnuMain.Items.Add(1, , "&File")
    mnuFile.SubItems.Add 1, , "&New game"
    mnuFile.SubItems.Add 2, , "", cbrMenuSeparator
    mnuFile.SubItems.Add 3, , "&About"
    mnuFile.SubItems.Add 4, "", "", cbrMenuSeparator
    mnuFile.SubItems.Add 5, , "E&xit"
    
   ' Set mnuOptions = mnuMain.Items.Add(2, , "&Options")
   ' mnuOptions.SubItems.Add 1, , "Options"
    
    ImageList1.Add App.Path & "\BarYahtzee.bmp"
    cmdBar.ImageList = ImageList1.hImageList
   
   'If Me.Width >= SIZE_SUPPORTSBUTTONS Then
    
        Dim Button As CommandbarLib.CommandBarButton
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep0")
        Button.Style = cbrSeparator
        Set Button = cmdBar.Controls.Add(cbrButton, "new")
        Button.Image = 0
        Button.Tag = ID_NEW
                        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep3")
        Button.Style = cbrSeparator
            
        Set Button = cmdBar.Controls.Add(cbrButton, "options")
        Button.Image = 2
        Button.Tag = ID_OPTIONS
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep4")
        Button.Style = cbrSeparator
            
        Set Button = cmdBar.Controls.Add(cbrButton, "highscore")
        Button.Image = 3
        Button.Tag = ID_HS
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sep5")
        Button.Style = cbrSeparator
        
        Set Button = cmdBar.Controls.Add(cbrButton, "sound")
        Button.Image = 5
        Button.Tag = ID_SOUND
        Button.Style = cbrCheck
        Button.Value = 1
     
    'End If
   
   
   
    'initialize variables
    RollCount = 0
    CatLeft = 13
    ImgWidth = imgD1.Width
    ImgHeight = imgD1.Height
    DieLocked(1) = False
    DieLocked(2) = False
    DieLocked(3) = False
    DieLocked(4) = False
    DieLocked(5) = False
    'set totals and subtotals to zero
    lblP1Tot.Caption = 0
    'lblTotal1.Caption = 0
    lblP1TopTot.Caption = 0
    lblP1BtmTot.Caption = 0
    'set label caption
   
    FreezeDice
    
     
End Sub

Sub ResetRoll()
    'this routine resets all necessary UI objects after
    'one turn is complete.  Note that because the Image
    'BorderStyle property contains a bug which causes the
    'bitmap to be improperly drawn, I need to use DrawLine
    'to set and clear image "borders".
    RollCount = 0
    'cmdRoll.Caption = "Roll 1"
    Roll.Caption = ""
    DieLocked(1) = False
    DieLocked(2) = False
    DieLocked(3) = False
    DieLocked(4) = False
    DieLocked(5) = False
    ClearBorder imgD1
    ClearBorder imgD2
    ClearBorder imgD3
    ClearBorder imgD4
    ClearBorder imgD5
    
    imgD1.Visible = False
    imgD2.Visible = False
    imgD3.Visible = False
    imgD4.Visible = False
    imgD5.Visible = False
    
    cmdRoll.Enabled = True
    cmdRoll.SetFocus
    TurnOver = "True"
    FreezeDice
End Sub

Private Sub cmdOne_Click()
ScoreSound
'Enter ones
    If TurnOver = "False" Then
        sumDice = 0
        For DieNum = 0 To 4
            If DiceVals(DieNum) = 1 Then
                sumDice = sumDice + DiceVals(DieNum)
            End If
        Next
        lblP11.Caption = sumDice
        CheckBonus sumDice
        cmdOne.Enabled = False
        lblP11.BackColor = &HC0FFC0
        CheckIfDone
        ResetRoll
    End If
End Sub

Private Sub cmdTwo_Click()
ScoreSound
'Enter twos
    If TurnOver = "False" Then
        sumDice = 0
        For DieNum = 0 To 4
            If DiceVals(DieNum) = 2 Then
                sumDice = sumDice + DiceVals(DieNum)
            End If
        Next
        lblP12.Caption = sumDice
        CheckBonus sumDice
        cmdTwo.Enabled = False
        lblP12.BackColor = &HC0FFC0
        CheckIfDone
        ResetRoll
    End If
End Sub

