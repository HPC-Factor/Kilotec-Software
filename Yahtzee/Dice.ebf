    'Reset UI and variables for a new game.
    Player = InputBox("What's your name?", "Player", "Player")
    lblPlayer.Caption = Player
    cmdRoll.Enabled = True
    
    DBdaten(0, 5) = Player
    DBdaten(1, 5) = Date
    SaveFlag = 0
    
    ResetRoll
