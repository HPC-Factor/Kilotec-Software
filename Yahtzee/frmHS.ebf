Attribute VB_Name = "frmHS"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
If SaveFlag = 0 Then
    DBdaten(0, 0) = frmHS.Name1.Caption
    DBdaten(1, 0) = frmHS.Datum1.Caption
    DBdaten(2, 0) = frmHS.Score1.Caption
    
    DBdaten(0, 1) = frmHS.Name2.Caption
    DBdaten(1, 1) = frmHS.Datum2.Caption
    DBdaten(2, 1) = frmHS.Score2.Caption
    
    DBdaten(0, 2) = frmHS.Name3.Caption
    DBdaten(1, 2) = frmHS.Datum1.Caption
    DBdaten(2, 2) = frmHS.Score3.Caption
    
    DBdaten(0, 3) = frmHS.Name4.Caption
    DBdaten(1, 3) = frmHS.Datum4.Caption
    DBdaten(2, 3) = frmHS.Score4.Caption
    
    DBdaten(0, 4) = frmHS.Name5.Caption
    DBdaten(1, 4) = frmHS.Datum5.Caption
    DBdaten(2, 4) = frmHS.Score5.Caption
    
    
    DBspeichern
    SaveFlag = 1
End If
frmMain.Enabled = True
Me.Hide
End Sub

