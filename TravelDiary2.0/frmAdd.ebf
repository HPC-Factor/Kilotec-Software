Attribute VB_Name = "frmAdd"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Abreise_Change()

End Sub

Private Sub Abreise_LostFocus()
On Error Resume Next
Dauer.Text = DateDiff("d", Anreise.Text, Abreise.Text)
End Sub

Private Sub Bemerkungen_Change()

End Sub

Private Sub Command1_Click()
If Bezeichnung.Text = "" Or Combo1.Text = "" Then
    MsgBox ("Bitte füllen Sie alle Felder aus!"), vbOKOnly, "Info"
    Exit Sub
End If



AbInDieDatenbank
EinlesenEintraege

Bezeichnung.Text = ""
Anreise.Text = ""
Abreise.Text = ""
Dauer.Text = ""
Bemerkungen.Text = ""
Combo2.Text = ""
Combo3.Text = ""
Ort.Text = ""
Land.Text = ""
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub



Private Sub Form_Activate()
Center Me
Combo1.Clear
Combo2.Clear
Combo3.Clear

AddToCombo Combo1
AddToCombo_Fortbewegungsmittel Combo2
AddToCombo_Uebernachtung Combo3

Bezeichnung.Text = ""
Anreise.Text = ""
Abreise.Text = ""
Dauer.Text = ""
Bemerkungen.Text = ""
Combo2.Text = ""
Combo3.Text = ""
Ort.Text = ""
Land.Text = ""

If HINTERGRUNDFARBE = 0 Then frmAdd.BackColor = &H8000000F
If HINTERGRUNDFARBE = 1 Then frmAdd.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = 2 Then frmAdd.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = 3 Then frmAdd.BackColor = &HC0FFFF


    Label3.Caption = "Reiseart:"
    Label1.Caption = "Bezeichnung:"
    Label4.Caption = "Ankunft:"
    Label5.Caption = "Abreise:"
    Label5.Caption = "Dauer:"
    Label6.Caption = "Tage"
    Label12.Caption = "Bemerkungen:"
    Label8.Caption = "Unterwegs mit:"
    Label9.Caption = "Übernachtung:"
    Label10.Caption = "Reiseziel:"
    Label11.Caption = "Land:"
    Command2.Caption = "&Schließen"
    Me.Caption = "Reise hinzufügen"

End Sub

Private Sub Form_Load()
Center Me

End Sub

Private Sub Label12_Click()

End Sub

