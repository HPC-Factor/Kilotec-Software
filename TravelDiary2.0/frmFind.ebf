Private Sub Combo1_Change()

End Sub



Public Sub Command1_Click()
If Text1.Text = Empty Then
Exit Sub
Else
Suchen
End If
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Command3_Click()
On Error Resume Next
If ListView1.ListItems.Count > 0 Then
IndexX = ListView1.SelectedItem.SubItems(3)
frmEdit.Show
End If
End Sub

Private Sub Command4_Click()
On Error Resume Next
If ListView1.ListItems.Count > 0 Then
IndexX = ListView1.SelectedItem.SubItems(3)
frmKosten.Show
End If
End Sub

Private Sub Command5_Click()
On Error Resume Next
If ListView1.ListItems.Count > 0 Then
IndexX = ListView1.SelectedItem.SubItems(3)
frmEinzelheiten.Show
End If
End Sub

Private Sub Command6_Click()
On Error Resume Next
If ListView1.ListItems.Count > 0 Then
IndexX = ListView1.SelectedItem.SubItems(3)
frmBewertung.Show
End If
End Sub

Private Sub Form_Activate()
Me.Height = 1455
Me.Width = 6540

Combo1.Clear
Combo2.Clear

    Combo2.AddItem "Bezeichnung"
    Combo2.AddItem "Reiseziel"
    Combo2.AddItem "Land"
    Combo2.AddItem "Name Unterkunft"
    Combo2.Text = "Bezeichnung"

AddToCombo Combo1
Combo1.Text = frmMain.Combo1.Text

If HINTERGRUNDFARBE = 0 Then frmFind.BackColor = &H8000000F: Check1.BackColor = &H8000000F
If HINTERGRUNDFARBE = 1 Then frmFind.BackColor = &HC0FFC0: Check1.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = 2 Then frmFind.BackColor = &HFFC0C0: Check1.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = 3 Then frmFind.BackColor = &HC0FFFF: Check1.BackColor = &HC0FFFF


    Me.Caption = "Suchen..."
    Label1.Caption = "Suche nach:"
    Check1.Caption = "in Reiseart:"
    Label2.Caption = "Ergebnis:"
    Command2.Caption = "&Abbrechen"
    Command1.Caption = "&Suchen"
    Command3.Caption = "Bearbeiten"
    Command4.Caption = "Kosten"
    Command5.Caption = "Einzelheiten"
    Command6.Caption = "Bewertung"


End Sub

Private Sub Form_Load()
Me.Height = 1350
Center Me

'AddToCombo Combo1
