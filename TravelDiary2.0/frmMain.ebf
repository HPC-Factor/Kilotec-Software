Private Sub ListView1_ColumnClick(ByVal Index As Long)
On Error Resume Next

ListView1.SortKey = Index - 1
ListView1.Sorted = True

If ListView1.SortOrder = lvwDescending Then
    ListView1.SortOrder = lvwAscending
    Else
    ListView1.SortOrder = lvwDescending
    End If
ListView1.Sorted = False



End Sub

Private Sub Timer1_Timer()
TimerFlag = TimerFlag + 1

If TimerFlag = SAVE_MINUTEN Then
    DBspeichern
    TimerFlag = 0
End If
End Sub

Private Sub InitializeSaveAsDialog()
    CommonDialog1.Filter = " (*.txt)|*.txt|" & " (*.*)|*.*"
    CommonDialog1.DefaultExt = "txt"
    CommonDialog1.CancelError = True
End Sub
