Attribute VB_Name = "frmMain"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub cmdBar_ButtonClick(ByVal Button As CommandbarLib.CommandBarButton)
InvokeAction CInt(Button.Tag), True
End Sub

Private Sub cmdBar_MenuClick(ByVal Item As CommandbarLib.Item)
InvokeAction (Item.Index + (100 * Item.Parent.Index)), False
End Sub
Private Sub InvokeAction(ID As Integer, FromButton As Boolean)
   Select Case (ID)
            
    
    Case ID_ABOUT       ' thick brush mode
        frmAbout.Show
        
    Case ID_EXIT        ' terminate the app
        App.End
 '***************************************
    
    Case ID_ADD
        frmAdd.Show
    
    Case ID_EDIT
        If ListView1.ListItems.Count > 0 Then
        IndexX = ListView1.SelectedItem.SubItems(3)
        frmEdit.Show
        End If
    
    Case ID_SEARCH
        frmFind.Show
    
    Case ID_DELETE
        Dim a As Integer
            a = MsgBox("Möchten Sie die aktuelle Reise löschen?", vbYesNo, "Achtung")
            If a = vbYes Then
            On Error Resume Next
                LoescheEintrag
                ReplaceIndex = IndexX
                Exit Sub
            End If
    
    Case ID_SAVE
        DBspeichern
    
    Case ID_OVERVIEW
        frmOverview.Show
        
    '************************************************
    Case ID_KOSTEN
        On Error Resume Next
        If ListView1.ListItems.Count > 0 Then
        IndexX = ListView1.SelectedItem.SubItems(3)
        frmKosten.Show
        End If
    
     Case ID_EINZELHEITEN
     On Error Resume Next
        If ListView1.ListItems.Count > 0 Then
        IndexX = ListView1.SelectedItem.SubItems(3)
        frmEinzelheiten.Show
        End If
    
    Case ID_BEWERTUNG
    On Error Resume Next
        If ListView1.ListItems.Count > 0 Then
        IndexX = ListView1.SelectedItem.SubItems(3)
        frmBewertung.Show
        End If
        
    Case ID_AKTIVITAETEN
    On Error Resume Next
        If ListView1.ListItems.Count > 0 Then
        IndexX = ListView1.SelectedItem.SubItems(3)
        frmAktivitaeten.Show
        End If

    '************************************************
    Case ID_KATEGORIE
        frmKatalog.Show vbModal
        If frmKatalog.Tag = "OK" Then
        Dim oldText As String
        oldText = Combo1.Text
        Combo1.Clear
        AddToCombo Combo1
        Combo1.Text = oldText
        End If
        
    Case ID_OPTIONEN
        frmOptionen.Show
        
    Case ID_EXPORT
        On Error Resume Next
            CommonDialog1.ShowSave
            If Err.Number = 0 Then
                ExportFile CommonDialog1.FileName
            End If
            On Error GoTo 0
    
      Case ID_IMPORT
        On Error Resume Next
            CommonDialog1.ShowOpen
            If Err.Number = 0 Then
                ImportFile CommonDialog1.FileName
            End If
            On Error GoTo 0
   
    
    
            
  
        
           
    
        
    Case ID_ABOUT
        frmAbout.Show
        
      
    Case Else
        ' programming error -- undefined tool
        MsgBox "Undefined Commandbar Command!"
    End Select
End Sub

Private Sub Combo1_Change()

End Sub

Private Sub Combo1_Click()
KategorieIndex = Mid(Combo1.List(Combo1.ListIndex), 1, 2)
EinlesenEintraege
End Sub





Private Sub Form_Activate()
'If HINTERGRUNDFARBE = 0 Then frmMain.BackColor = &H8000000F
'If HINTERGRUNDFARBE = 1 Then frmMain.BackColor = &HC0FFC0
'If HINTERGRUNDFARBE = 2 Then frmMain.BackColor = &HFFC0C0
'If HINTERGRUNDFARBE = 3 Then frmMain.BackColor = &HC0FFFF

If AUTOSAVE = 1 Then Timer1.Enabled = True

End Sub

Private Sub Form_Load()
'Center Me

AUTOSAVE = GetSetting(App.Title, "Settings", "Autosave", "0")
SAVE_MINUTEN = GetSetting(App.Title, "Settings", "SaveMinuten", "5")
HINTERGRUNDFARBE = GetSetting(App.Title, "Settings", "Farbe", "0")

WSYMBOL = GetSetting(App.Title, "Settings", "Currency", "$")
MAXIM = GetSetting(App.Title, "Settings", "Max", "0")

'On Error Resume Next
'If SPRACHE <> 0 Or SPRACHE <> 1 Then SPRACHE = 0
'If WSYMBOL = Empty Then WSYMBOL = "$"
'If HINTERGRUNDFARBE = Empty Then HINTERGRUNDFARBE = 0
'If SAVE_MINUTEN = Empty Then SAVE_MINUTEN = 5
'If AUTOSAVE = Empty Then AUTOSAVE = 0


'On Error Resume Next
If HINTERGRUNDFARBE = "0" Then frmMain.BackColor = &H8000000F
If HINTERGRUNDFARBE = "1" Then frmMain.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = "2" Then frmMain.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = "3" Then frmMain.BackColor = &HC0FFFF



    Label3.Caption = "Reiseart:"


InitializeSaveAsDialog

If MAXIM = 1 Then
    Me.Left = 0
    Me.Width = Screen.Width
    Me.Height = Screen.Height
    
    ListView1.Height = Me.Height - ListView1.Top - 800
    ListView1.Width = Me.Width - 100
End If

If MAXIM = 0 Then
Center Me
End If


cmdBar.Left = 0
cmdBar.Top = 0
cmdBar.Width = Me.Width

ImageList1.Add App.Path & "\Bar.bmp"
cmdBar.ImageList = ImageList1.hImageList

