Private Sub Command3_Click()
DBdaten(13, IndexX) = DBdaten(13, IndexX) + Kosten.Text
End Sub

Private Sub Form_Activate()
Datum.Text = ""
Kosten.Text = ""
Akt.Text = ""
Notiz.Text = ""
End Sub

Private Sub Form_Load()
Reise.Text = IndexX & " " & DBdaten(2, IndexX) & " in " & DBdaten(8, IndexX) & " am: " & DBdaten(3, IndexX)
Center Me
End Sub

