Attribute VB_Name = "frmEdit"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Abreise_Change()

End Sub

Private Sub Abreise_LostFocus()
On Error Resume Next
Dauer.Text = DateDiff("d", Anreise.Text, Abreise.Text)
End Sub

Private Sub Command1_Click()
DBbearbeiten
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Form_Activate()
Center Me
Combo1.Clear
Combo2.Clear
Combo3.Clear


AddToCombo Combo1
AddToCombo_Fortbewegungsmittel Combo2
AddToCombo_Uebernachtung Combo3

Combo1.Text = DBdaten(0, IndexX) & " " & DBdaten(1, IndexX)
Bezeichnung.Text = DBdaten(2, IndexX)
Anreise.Text = DBdaten(3, IndexX)
Abreise.Text = DBdaten(4, IndexX)
Bemerkungen.Text = DBdaten(5, IndexX)
Combo2.Text = DBdaten(6, IndexX)
Combo3.Text = DBdaten(7, IndexX)
Ort.Text = DBdaten(8, IndexX)
Land.Text = DBdaten(9, IndexX)

ReplaceIndex = IndexX

If HINTERGRUNDFARBE = 0 Then frmEdit.BackColor = &H8000000F
If HINTERGRUNDFARBE = 1 Then frmEdit.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = 2 Then frmEdit.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = 3 Then frmEdit.BackColor = &HC0FFFF


    Label3.Caption = "Reiseart:"
    Label1.Caption = "Bezeichnung:"
    Label4.Caption = "Ankunft:"
    Label5.Caption = "Abreise:"
    Label5.Caption = "Dauer:"
    Label6.Caption = "Tage"
    Label12.Caption = "Bemerkungen:"
    Label8.Caption = "Unterwegs mit:"
    Label9.Caption = "‹bernachtung:"
    Label10.Caption = "Reiseziel:"
    Label11.Caption = "Land:"
    Command2.Caption = "&Schlieﬂen"
    Me.Caption = "Reise editieren"
    
    On Error Resume Next
    Dauer.Text = DateDiff("d", Anreise.Text, Abreise.Text)
End Sub

Private Sub Form_Load()

End Sub
