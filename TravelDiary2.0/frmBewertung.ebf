Attribute VB_Name = "frmBewertung"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Command1_Click()
AbInDieDatenbank_Bewertung
Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide
End Sub

Private Sub Command3_Click()


    If Combo1.Text = Empty Then Combo1.Text = "0 - nicht zutreffend"
    If Combo2.Text = Empty Then Combo2.Text = "0 - nicht zutreffend"
    If Combo3.Text = Empty Then Combo3.Text = "0 - nicht zutreffend"
    If Combo4.Text = Empty Then Combo4.Text = "0 - nicht zutreffend"
    If Combo5.Text = Empty Then Combo5.Text = "0 - nicht zutreffend"



On Error Resume Next
GN = 0
Gesamtnote.Text = 0

Dim Wieviel As Integer



    If Combo1.Text <> "0 - nicht zutreffend" Then Wieviel = Wieviel + 1
    If Combo2.Text <> "0 - nicht zutreffend" Then Wieviel = Wieviel + 1
    If Combo3.Text <> "0 - nicht zutreffend" Then Wieviel = Wieviel + 1
    If Combo4.Text <> "0 - nicht zutreffend" Then Wieviel = Wieviel + 1
    If Combo5.Text <> "0 - nicht zutreffend" Then Wieviel = Wieviel + 1



GN = GN + (CDbl(Mid(Combo1.Text, 1, 1)) + CDbl(Mid(Combo2.Text, 1, 1)) + CDbl(Mid(Combo3.Text, 1, 1)) + CDbl(Mid(Combo4.Text, 1, 1)) + CDbl(Mid(Combo5.Text, 1, 1))) / Wieviel
Gesamtnote.Text = GN
End Sub

Private Sub Form_Activate()
Reise.Text = DBdaten(2, IndexX) & " in " & DBdaten(8, IndexX) & " am: " & DBdaten(3, IndexX)

Combo1.Clear
AddToCombo_Bewertung Combo1
AddToCombo_Bewertung Combo2
AddToCombo_Bewertung Combo3
AddToCombo_Bewertung Combo4
AddToCombo_Bewertung Combo5

Combo1.Text = DBdaten(19, IndexX)
Combo2.Text = DBdaten(20, IndexX)
Combo3.Text = DBdaten(21, IndexX)
Combo4.Text = DBdaten(22, IndexX)
Combo5.Text = DBdaten(23, IndexX)

If HINTERGRUNDFARBE = 0 Then frmBewertung.BackColor = &H8000000F
If HINTERGRUNDFARBE = 1 Then frmBewertung.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = 2 Then frmBewertung.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = 3 Then frmBewertung.BackColor = &HC0FFFF




    Label3.Caption = "Reise:"
    Label1.Caption = "Strecke:"
    Label2.Caption = "Unterkunft:"
    Label4.Caption = "Aktivit‰ten:"
    Label5.Caption = "Kosten:"
    Label6.Caption = "Gesamtreise:"
    Label7.Caption = "Gesamtnote:"
   Command3.Caption = "berechnen"
    Command2.Caption = "&Schlieﬂen"
    Me.Caption = "Bewertung"

Gesamtnote.Text = 0

End Sub

Private Sub Form_Load()
Center Me
End Sub
