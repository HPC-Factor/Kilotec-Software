Attribute VB_Name = "frmOptionen"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit

Private Sub Check1_Click()

If Check1.Value = 0 Then
    Text1.Enabled = False
    frmMain.Timer1.Enabled = False
Else
    Text1.Enabled = True
    frmMain.Timer1.Enabled = True
End If
End Sub

Private Sub Check2_Click()
If Check2.Value = 0 Then
    frmMain.Width = 8205
    frmMain.Height = 3240
    Center frmMain
Else
    frmMain.Left = 0
    frmMain.Width = Screen.Width
    frmMain.Height = Screen.Height
    
    frmMain.ListView1.Height = frmMain.Height - frmMain.ListView1.Top - 800
    frmMain.ListView1.Width = frmMain.Width - 100
End If
 
    
End Sub

Private Sub Combo1_Change()

End Sub

Private Sub Combo1_Click()
HINTERGRUNDFARBE = Combo1.ListIndex

If HINTERGRUNDFARBE = 0 Then frmOptionen.BackColor = &H8000000F
If HINTERGRUNDFARBE = 1 Then frmOptionen.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = 2 Then frmOptionen.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = 3 Then frmOptionen.BackColor = &HC0FFFF


End Sub

Private Sub Combo2_Change()

End Sub

Private Sub Combo2_Click()
SPRACHE = Combo2.ListIndex
If SPRACHE = 0 Then
    Me.Caption = "Options"
    Label3.Caption = "Backcolor:"
    Label2.Caption = "Language:"
    Label1.Caption = "minutes"
    Command2.Caption = "&Cancel"
    Label4.Caption = "Currency:"
    Check2.Caption = "Maximize Main"
End If
If SPRACHE = 1 Then
    Me.Caption = "Optionen"
    Label3.Caption = "Hintergrundfarbe:"
    Label2.Caption = "Sprache:"
    Label1.Caption = "Minuten"
    Command2.Caption = "&Abbrechen"
    Label4.Caption = "Währung:"
    Check2.Caption = "Maximieren"
End If
End Sub

Private Sub Command1_Click()
If Combo2.Text = "Deutsch" Then SPRACHE = 1
If Combo2.Text = "English" Then SPRACHE = 0

If SPRACHE = 0 Then
    If Combo1.Text = "Default" Then HINTERGRUNDFARBE = 0
    If Combo1.Text = "Green" Then HINTERGRUNDFARBE = 1
    If Combo1.Text = "Blue" Then HINTERGRUNDFARBE = 2
    If Combo1.Text = "Yellow" Then HINTERGRUNDFARBE = 3
End If
If SPRACHE = 1 Then
    If Combo1.Text = "Standard" Then HINTERGRUNDFARBE = 0
    If Combo1.Text = "Grün" Then HINTERGRUNDFARBE = 1
    If Combo1.Text = "Blau" Then HINTERGRUNDFARBE = 2
    If Combo1.Text = "Gelb" Then HINTERGRUNDFARBE = 3
End If


SaveSetting App.Title, "Settings", "Autosave", Check1.Value
SaveSetting App.Title, "Settings", "SaveMinuten", Text1.Text
SaveSetting App.Title, "Settings", "Farbe", HINTERGRUNDFARBE
SaveSetting App.Title, "Settings", "Sprache", SPRACHE
SaveSetting App.Title, "Settings", "Currency", Symbol.Text
SaveSetting App.Title, "Settings", "Max", Check2.Value
Me.Hide

End Sub

Private Sub Command2_Click()
Me.Hide
End Sub








Private Sub Form_Activate()
Check1.Value = AUTOSAVE
Check2.Value = MAXIM

If AUTOSAVE = 1 Then Text1.Enabled = True
If AUTOSAVE = 0 Then Text1.Enabled = False
Text1.Text = SAVE_MINUTEN
Combo1.Text = Combo1.List(HINTERGRUNDFARBE)
Combo2.Text = Combo2.List(SPRACHE)
Symbol.Text = WSYMBOL

If HINTERGRUNDFARBE = 0 Then frmOptionen.BackColor = &H8000000F: Check1.BackColor = &H8000000F: Check2.BackColor = &H8000000F
If HINTERGRUNDFARBE = 1 Then frmOptionen.BackColor = &HC0FFC0: Check1.BackColor = &HC0FFC0: Check2.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = 2 Then frmOptionen.BackColor = &HFFC0C0: Check1.BackColor = &HFFC0C0: Check2.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = 3 Then frmOptionen.BackColor = &HC0FFFF: Check1.BackColor = &HC0FFFF: Check2.BackColor = &HC0FFFF

If SPRACHE = 0 Then
    Me.Caption = "Options"
    Label3.Caption = "Backcolor"
    Label2.Caption = "Language"
    Label1.Caption = "minutes"
    Command2.Caption = "&Cancel"
    Label4.Caption = "Currency:"
    Check2.Caption = "Maximize Main"
End If
If SPRACHE = 1 Then
   Me.Caption = "Optionen"
   Label3.Caption = "Hintergrundfarbe"
   Label2.Caption = "Sprache"
   Label1.Caption = "Minuten"
   Command2.Caption = "&Abbrechen"
   Label4.Caption = "Währung:"
   Check2.Caption = "Maximieren"
End If

End Sub

Private Sub Form_Load()
Center Me

If SPRACHE = 0 Then
    Combo1.AddItem "Default"
    Combo1.AddItem "Green"
    Combo1.AddItem "Blue"
    Combo1.AddItem "Yellow"
End If
If SPRACHE = 1 Then
    Combo1.AddItem "Standard"
    Combo1.AddItem "Grün"
    Combo1.AddItem "Blau"
    Combo1.AddItem "Gelb"
End If

Combo2.AddItem "English"
Combo2.AddItem "Deutsch"
End Sub

Private Sub Text1_Change()

End Sub

Private Sub Text1_LostFocus()
On Error Resume Next
If CDbl(Text1.Text) > 25 Then Text1.Text = "25"
If CDbl(Text1.Text) < 1 Then Text1.Text = "1"
If Text1.Text = Empty Then Text1.Text = "1"

End Sub
