Attribute VB_Name = "frmKosten"
Attribute VB_GlobalNameSpace = False
Attribute VB_Creatable = False
Attribute VB_PredeclaredId = True
Attribute VB_Exposed = False
Option Explicit



Private Sub Command1_Click()
AbInDieDatenbank_Kosten
'EinlesenEintraege



Me.Hide
End Sub

Private Sub Command2_Click()
Me.Hide

End Sub

Private Sub Command3_Click()
If Reisekosten.Text = Empty Then Reisekosten.Text = 0
If Uebernachtung.Text = Empty Then Uebernachtung.Text = 0
If Verpflegung.Text = Empty Then Verpflegung.Text = 0
If Freizeit.Text = Empty Then Freizeit.Text = 0
If Sonstiges.Text = Empty Then Sonstiges.Text = 0

On Error Resume Next
GK = GK + CDbl(Reisekosten.Text) + CDbl(Uebernachtung.Text) + CDbl(Verpflegung.Text) + CDbl(Freizeit.Text) + CDbl(Sonstiges.Text)
Gesamtkosten.Text = GK
End Sub

Private Sub Form_Activate()
If SPRACHE = 1 Then Reise.Text = DBdaten(2, IndexX) & " in " & DBdaten(8, IndexX) & " am: " & DBdaten(3, IndexX)
If SPRACHE = 0 Then Reise.Text = DBdaten(2, IndexX) & " in " & DBdaten(8, IndexX) & " on: " & DBdaten(3, IndexX)

Reisekosten.Text = DBdaten(10, IndexX)
Uebernachtung.Text = DBdaten(11, IndexX)
Verpflegung.Text = DBdaten(12, IndexX)
Freizeit.Text = DBdaten(13, IndexX)
Sonstiges.Text = DBdaten(14, IndexX)
Gesamtkosten.Text = 0

If HINTERGRUNDFARBE = 0 Then frmKosten.BackColor = &H8000000F
If HINTERGRUNDFARBE = 1 Then frmKosten.BackColor = &HC0FFC0
If HINTERGRUNDFARBE = 2 Then frmKosten.BackColor = &HFFC0C0
If HINTERGRUNDFARBE = 3 Then frmKosten.BackColor = &HC0FFFF

Label8.Caption = WSYMBOL
Label9.Caption = WSYMBOL
Label10.Caption = WSYMBOL
Label11.Caption = WSYMBOL
Label12.Caption = WSYMBOL

If SPRACHE = 0 Then
    Me.Caption = "Costs"
    Label3.Caption = "Travel:"
    Label1.Caption = "Expenses:"
    Label2.Caption = "Lodging:"
    Label4.Caption = "Meals:"
    Label5.Caption = "Leisure:"
    Label6.Caption = "Others:"
    Label7.Caption = "Total costs:"
    Command3.Caption = "calculate"
    Command2.Caption = "&Close"
End If
If SPRACHE = 1 Then
    Me.Caption = "Kosten"
    Label3.Caption = "Reise:"
    Label1.Caption = "Reisekosten:"
    Label2.Caption = "‹bernachtung:"
    Label4.Caption = "Verpflegung:"
    Label5.Caption = "Freizeit:"
    Label6.Caption = "Sonstiges:"
    Label7.Caption = "Gesamtkosten:"
    Command3.Caption = "berechnen"
    Command2.Caption = "&Schlieﬂen"
    
End If
End Sub

Private Sub Form_Load()
Center Me

End Sub

Private Sub Text2_Change()

End Sub

