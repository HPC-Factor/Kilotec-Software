[Version]
Signature="$Chicago$"
CESignature="$Windows CE$"
Provider=%CompanyName%

[SourceDisksNames]
1=,"Application Files",, App

[DefaultInstall]
CopyFiles=Files.App, Files.Windows
CEShortcuts=Shortcuts

[Shortcuts]
%AppName%,0,"TravelDiary.vb"

[CEStrings]
InstallDir=%CE1%\%AppName%
AppName="TravelDiary"

[Strings]
CompanyName="Kilotec"

[DestinationDirs]
